<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>IndexTrialProbe</AssemblyName>
    <WorkbenchAssembly Condition="'$(WorkbenchAssembly)' == ''">FileAssistant.IndexTrial</WorkbenchAssembly>
    <DefineConstants Condition="'$(LegacyWorkbench)' == 'true'">$(DefineConstants);LEGACY_WORKBENCH</DefineConstants>
    <AppProject>$(MSBuildProjectDirectory)\..\..\src\FileAssistant.App</AppProject>
    <TrialBuild>$(AppProject)\bin\index-trial\x64\Debug\$(TargetFramework)\win-x64</TrialBuild>
    <ApplicationManifest Condition="'$(ApplicationManifest)' == ''">$(AppProject)\obj\index-trial\x64\Debug\$(TargetFramework)\win-x64\Manifests\app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\FileAssistant.IndexBench\BenchmarkMemoryLimit.cs" Link="BenchmarkMemoryLimit.cs" />
    <Reference Include="$(WorkbenchAssembly);FileAssistant.Core;FileAssistant.Infrastructure;CommunityToolkit.Mvvm;Microsoft.WinUI;Microsoft.InteractiveExperiences.Projection;WinRT.Runtime">
      <HintPath>$(TrialBuild)\%(Identity).dll</HintPath>
    </Reference>
    <Reference Include="FileAssistant.Indexing;FileAssistant.Indexing.Windows" Condition="'$(LegacyWorkbench)' != 'true'">
      <HintPath>$(TrialBuild)\%(Identity).dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
