<Window x:Class="FileAssistant.IndexLab.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:FileAssistant.IndexLab"
    Title="纸鸢 · FileKite · 共享索引测试版">
    <Grid x:Name="LayoutRoot" Background="{ThemeResource WorkspaceSurfaceBrush}" Padding="20,14" RowSpacing="8" Loaded="OnLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="磁盘索引" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
            <TextBlock x:Name="SnapshotSummary" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource WorkspaceSecondaryBrush}"/>
            <ComboBox x:Name="SavedScopes" Grid.Column="2" MinWidth="148" MaxWidth="300" PlaceholderText="已建索引的位置"
                      AutomationProperties.Name="切换已建索引的位置" SelectionChanged="ScopeChanged"/>
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="PathInput" PlaceholderText="输入磁盘或文件夹路径" AutomationProperties.Name="扫描位置"/>
            <Button Grid.Column="1" Click="PickFolder" AutomationProperties.Name="选择扫描文件夹" ToolTipService.ToolTip="选择文件夹"><FontIcon Glyph="&#xE8B7;" FontSize="16"/></Button>
            <Button x:Name="ScanButton" Grid.Column="2" Content="扫描并建立索引" Style="{StaticResource AccentButtonStyle}" Click="StartScan"/>
            <Button x:Name="CancelButton" Grid.Column="3" Content="取消扫描" Visibility="Collapsed" Click="CancelScan"/>
        </Grid>
        <StackPanel Grid.Row="2" Spacing="5">
            <ProgressBar x:Name="ScanProgress" IsIndeterminate="False" Visibility="Collapsed"/>
            <TextBlock x:Name="ScanState" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <SelectorBar x:Name="Tabs" Grid.Row="3" SelectionChanged="TabChanged">
            <SelectorBarItem x:Name="DirectoryTab" Text="目录占用" IsSelected="True"/>
            <SelectorBarItem x:Name="LargeTab" Text="大文件"/>
            <SelectorBarItem x:Name="TypeTab" Text="文件类型"/>
            <SelectorBarItem x:Name="SearchTab" Text="文件搜索"/>
        </SelectorBar>
        <Grid Grid.Row="4" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button x:Name="BackButton" IsEnabled="False" Click="GoUp" AutomationProperties.Name="上一级目录" ToolTipService.ToolTip="上一级目录">
                <FontIcon Glyph="&#xE74A;" FontSize="14"/>
            </Button>
            <TextBlock x:Name="Location" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <TextBox x:Name="Query" Grid.Column="1" Visibility="Collapsed" PlaceholderText="搜索此索引中的名称，可用 * 和 ?"
                     AutomationProperties.Name="按文件或目录名称搜索" TextChanged="QueryChanged" KeyDown="QueryKeyDown"/>
        </Grid>
        <Grid Grid.Row="5" RowSpacing="3">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Padding="12,4,20,4" Background="{ThemeResource WorkspaceSubtleBrush}" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="NameHeader" Text="名称 / 位置"/><TextBlock x:Name="SizeHeader" Grid.Column="1" Text="逻辑大小" HorizontalAlignment="Right"/>
                <TextBlock x:Name="UsageHeader" Grid.Column="2" Text="磁盘占用" HorizontalAlignment="Right"/>
            </Grid>
            <ListView x:Name="Results" Grid.Row="1" DoubleTapped="OpenResult" KeyDown="ResultKeyDown" AutomationProperties.Name="索引结果">
                <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="10,3"/></Style></ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:DisplayRow">
                        <Grid ColumnSpacing="12" Padding="0,2,8,2" ToolTipService.ToolTip="{x:Bind Hint}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                            <FontIcon FontSize="16" Glyph="{x:Bind Glyph}" Foreground="{ThemeResource WorkspaceAccentBrush}"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind Detail}" FontSize="12" Foreground="{ThemeResource WorkspaceSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{x:Bind Size}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="{x:Bind Usage}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="Empty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="选择磁盘或文件夹，建立第一份索引。" Foreground="{ThemeResource WorkspaceSecondaryBrush}"/>
        </Grid>
        <Canvas x:Name="MapCanvas" Grid.Row="6" Height="108" Visibility="Collapsed" SizeChanged="MapResized"
                AutomationProperties.Name="当前目录空间矩形图"/>
        <Grid Grid.Row="7" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="PageStatus" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
            <Button x:Name="Previous" Grid.Column="1" IsEnabled="False" Content="上一页" Click="PreviousPage"/>
            <Button x:Name="Next" Grid.Column="2" IsEnabled="False" Content="下一页" Click="NextPage"/>
        </Grid>
    </Grid>
</Window>
