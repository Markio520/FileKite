<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FileAssistant.App.Controls">
    <controls:ColumnWidthConverter x:Key="ColumnWidth" />
    <Style x:Key="ResizeThumbStyle" TargetType="Thumb">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="AutomationProperties.HelpText" Value="拖动，或使用左右方向键调整宽度" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
            <Grid Background="Transparent">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Target="Divider.Background" Value="{ThemeResource WorkspaceAccentBrush}" />
                                <Setter Target="Divider.Width" Value="2" />
                                <Setter Target="Divider.Opacity" Value="0.56" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Target="Divider.Background" Value="{ThemeResource WorkspaceAccentBrush}" />
                                <Setter Target="Divider.Width" Value="2.5" />
                                <Setter Target="Divider.Opacity" Value="0.95" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="FocusStates">
                        <VisualState x:Name="Unfocused" />
                        <VisualState x:Name="PointerFocused" />
                        <VisualState x:Name="Focused">
                            <VisualState.Setters>
                                <Setter Target="Divider.Background" Value="{ThemeResource WorkspaceAccentBrush}" />
                                <Setter Target="Divider.Width" Value="2" />
                                <Setter Target="Divider.Opacity" Value="0.85" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Border x:Name="Divider" Width="1" CornerRadius="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{ThemeResource WorkspaceSplitterRestBrush}" />
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="VerticalResizeThumbStyle" TargetType="Thumb" BasedOn="{StaticResource ResizeThumbStyle}">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="AutomationProperties.HelpText" Value="上下拖动或使用上下方向键调整高度，双击恢复填满" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
            <Grid Background="Transparent">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Target="Divider.Background" Value="{ThemeResource WorkspaceAccentBrush}" />
                                <Setter Target="Divider.Height" Value="2" />
                                <Setter Target="Divider.Opacity" Value="0.56" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Target="Divider.Background" Value="{ThemeResource WorkspaceAccentBrush}" />
                                <Setter Target="Divider.Height" Value="2.5" />
                                <Setter Target="Divider.Opacity" Value="0.95" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="FocusStates">
                        <VisualState x:Name="Unfocused" />
                        <VisualState x:Name="PointerFocused" />
                        <VisualState x:Name="Focused">
                            <VisualState.Setters>
                                <Setter Target="Divider.Background" Value="{ThemeResource WorkspaceAccentBrush}" />
                                <Setter Target="Divider.Height" Value="2" />
                                <Setter Target="Divider.Opacity" Value="0.85" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Border x:Name="Divider" Height="1" CornerRadius="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{ThemeResource WorkspaceSplitterRestBrush}" />
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ResizeHandleStyle" TargetType="controls:ResizeHandle">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="IsTabStop" Value="False" />
    </Style>
    <Style x:Key="ColumnResizeHandle" TargetType="controls:ResizeHandle" BasedOn="{StaticResource ResizeHandleStyle}">
        <Setter Property="Width" Value="12" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="0,-7,-6,-7" />
    </Style>
    <DataTemplate x:Key="WorkspaceResizeGripGlyphTemplate">
        <PathIcon Width="11" Height="11" UseLayoutRounding="True" HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Data="M 9.6,2.2 L 2.2,9.6 M 9.6,5.8 L 5.8,9.6" />
    </DataTemplate>
    <Style x:Key="WorkspaceWindowResizeGripStyle" TargetType="Border">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="CornerRadius" Value="4,0,9,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>
</ResourceDictionary>
