<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="FileAssistant.App.Features.Preview.FileThumbnail"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False">
    <Border Background="{ThemeResource WorkspaceSubtleBrush}" CornerRadius="6" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1">
        <Grid>
            <Border x:Name="SkeletonOverlay" Background="{ThemeResource WorkspaceHoverBrush}" CornerRadius="5" Opacity="0" Visibility="Collapsed" />
            <FontIcon x:Name="FallbackIcon" Glyph="&#xE8A5;" FontSize="34" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
            <Image x:Name="ThumbnailImage" Stretch="UniformToFill" />
        </Grid>
    </Border>
</UserControl>
