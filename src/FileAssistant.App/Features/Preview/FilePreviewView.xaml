<UserControl
    x:Class="FileAssistant.App.Features.Preview.FilePreviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="PreviewFrame" MinHeight="148" MaxHeight="220" Background="{ThemeResource WorkspaceSubtleBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
        <Grid>
            <FontIcon x:Name="FallbackIcon" Glyph="&#xE8A5;" FontSize="40" Foreground="{ThemeResource WorkspaceSecondaryBrush}" Opacity="0.7" />
            <Image x:Name="PreviewImage" Stretch="Uniform" MaxHeight="198" AutomationProperties.Name="文件内容预览" />
            <ScrollViewer x:Name="TextViewport" Visibility="Collapsed" MaxHeight="198" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="TextPreview" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" FontFamily="Consolas" />
            </ScrollViewer>
            <ProgressRing x:Name="PreviewLoading" Width="26" Height="26" IsActive="False" Visibility="Collapsed" Foreground="{ThemeResource WorkspaceAccentBrush}" />
            <Border x:Name="StatusPanel" Background="{ThemeResource WorkspaceSurfaceBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3" HorizontalAlignment="Center" VerticalAlignment="Bottom" Visibility="Collapsed">
                <TextBlock x:Name="StatusText" FontSize="11.5" TextWrapping="Wrap" MaxWidth="230" />
            </Border>
        </Grid>
    </Border>
</UserControl>
