<UserControl
    x:Class="FileAssistant.App.Features.FileInput.CollectionFolderPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FileAssistant.App.Controls"
    xmlns:workspace="using:FileAssistant.App.Features.Workspace">
    <Grid
        x:Name="RootShell"
        MinWidth="300">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Optional Modal Band 1: Header (visible in standalone ImportAsync / MoveAsync dialogs) -->
        <Grid
            x:Name="ModalHeader"
            Visibility="Collapsed"
            Padding="18,14,12,11"
            BorderBrush="{ThemeResource WorkspaceBorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock
                    x:Name="ModalTitleText"
                    Text="选择加入位置"
                    FontSize="15.5"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
                <Border
                    x:Name="ModalBadgePill"
                    Style="{StaticResource WorkspacePillBadgeStyle}"
                    Padding="8,2"
                    VerticalAlignment="Center">
                    <TextBlock
                        x:Name="ModalBadgeText"
                        FontSize="11.5"
                        Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                </Border>
            </StackPanel>
            <Button
                Grid.Column="1"
                Width="28"
                Height="28"
                Style="{StaticResource WorkspaceIconButtonStyle}"
                Click="ModalClose_Click"
                AutomationProperties.Name="关闭窗口"
                ToolTipService.ToolTip="关闭（Esc）">
                <FontIcon Glyph="&#xE711;" FontSize="11.5" />
            </Button>
        </Grid>

        <!-- Band 2: Picker Body -->
        <Border x:Name="BodySurface" Grid.Row="1">
            <StackPanel Spacing="8">
                <StackPanel x:Name="HeaderRegion" Spacing="8">
                    <TextBlock Text="加入位置" Style="{StaticResource WorkspaceCaptionStyle}" />
                    <Border
                        Background="{ThemeResource WorkspaceSubtleBrush}"
                        BorderBrush="{ThemeResource WorkspaceBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{ThemeResource WorkspaceCategoryFolderBrush}" />
                            <TextBlock x:Name="TargetPath" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.Name="目标位置" />
                            <Button x:Name="ChangeButton" Grid.Column="2" Content="更改" Style="{StaticResource WorkspaceToolbarButtonStyle}" MinHeight="28" Padding="10,3" Click="Change_Click" AutomationProperties.Name="更改目标文件夹" />
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="TreeRegion" Spacing="6" Visibility="Collapsed">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="选择目标文件夹"
                            VerticalAlignment="Center"
                            Style="{StaticResource WorkspaceCaptionStyle}"
                            FontWeight="SemiBold" />
                        <Button
                            Grid.Column="1"
                            Content="+ 新建文件夹"
                            Style="{StaticResource WorkspaceToolbarButtonStyle}"
                            MinHeight="28"
                            Padding="10,3"
                            Click="NewFolder_Click" />
                    </Grid>

                    <Border
                        Background="{ThemeResource WorkspacePaneBrush}"
                        BorderBrush="{ThemeResource WorkspaceBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="6">
                        <TreeView
                            x:Name="Folders"
                            MinHeight="156"
                            MaxHeight="224"
                            SelectionMode="Single"
                            SelectionChanged="Folders_SelectionChanged"
                            CanDragItems="False"
                            CanReorderItems="False"
                            ItemContainerStyle="{StaticResource WorkspaceFolderTreeItemStyle}"
                            AutomationProperties.Name="目标文件夹目录树">
                            <TreeView.ItemTemplate>
                                <DataTemplate x:DataType="TreeViewNode">
                                    <StackPanel Orientation="Horizontal" Spacing="7" Padding="0,3">
                                        <FontIcon Style="{StaticResource WorkspaceFolderIconStyle}" Foreground="{ThemeResource WorkspaceCategoryFolderBrush}" />
                                        <TextBlock Text="{x:Bind ((workspace:FolderBreadcrumb)Content).Name}" Style="{StaticResource WorkspaceFolderNameStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Border>

                    <Border
                        x:Name="NameEditor"
                        Style="{StaticResource WorkspaceSubtleCardStyle}"
                        Padding="8"
                        Visibility="Collapsed">
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="NewFolderLocationHint" Style="{StaticResource WorkspaceCaptionStyle}" FontSize="11" TextTrimming="CharacterEllipsis" />
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="NewName"
                                    Style="{StaticResource WorkspaceToolbarFieldStyle}"
                                    MinHeight="30"
                                    Padding="9,4"
                                    PlaceholderText="输入新文件夹名称"
                                    MaxLength="120"
                                    KeyDown="NewName_KeyDown"
                                    AutomationProperties.Name="新文件夹名称" />
                                <Button
                                    Grid.Column="1"
                                    Content="创建"
                                    Style="{StaticResource OpActionStyle}"
                                    MinHeight="30"
                                    Padding="12,4"
                                    Click="Create_Click" />
                                <Button
                                    Grid.Column="2"
                                    Content="取消"
                                    Style="{StaticResource WorkspaceToolbarButtonStyle}"
                                    MinHeight="30"
                                    Padding="10,4"
                                    Click="CancelNew_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock
                    x:Name="Message"
                    TextWrapping="Wrap"
                    Visibility="Collapsed"
                    Style="{StaticResource WorkspaceCaptionStyle}" />
            </StackPanel>
        </Border>

        <!-- Optional Modal Band 3: Unified Footer -->
        <Border
            x:Name="ModalFooter"
            Grid.Row="2"
            Visibility="Collapsed"
            Padding="16,10"
            CornerRadius="0,0,11,11"
            Background="{ThemeResource WorkspacePaneBrush}"
            BorderBrush="{ThemeResource WorkspaceBorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock
                        x:Name="ModalNoteText"
                        Style="{StaticResource WorkspaceCaptionStyle}"
                        FontSize="11.5"
                        TextTrimming="CharacterEllipsis" />
                    <CheckBox
                        x:Name="ModalPreserveCheck"
                        Content="保留目录结构"
                        IsChecked="True"
                        MinWidth="0"
                        MinHeight="22"
                        Padding="6,0,0,0"
                        FontSize="12"
                        Visibility="Collapsed"
                        Checked="ModalPreserve_Changed"
                        Unchecked="ModalPreserve_Changed" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button
                        Content="取消"
                        Style="{StaticResource WorkspaceToolbarButtonStyle}"
                        MinHeight="32"
                        Padding="14,5"
                        Click="ModalClose_Click" />
                    <Button
                        x:Name="ModalConfirmButton"
                        Content="加入"
                        Style="{StaticResource OpActionStyle}"
                        MinHeight="32"
                        Padding="16,5"
                        Click="ModalConfirm_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
