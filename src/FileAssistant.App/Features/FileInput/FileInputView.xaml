<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FileAssistant.App.Features.FileInput.FileInputView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FileAssistant.App.Features.Workspace"
    xmlns:input="using:FileAssistant.Core.Features.FileInput"
    xmlns:inputView="using:FileAssistant.App.Features.FileInput"
    xmlns:controls="using:FileAssistant.App.Controls"
    xmlns:preview="using:FileAssistant.App.Features.Preview">
    <UserControl.Resources>
        <inputView:FileInputColumnWidths x:Key="FileColumns" />
        <DataTemplate x:Key="StagingItemTemplate" x:DataType="local:WorkspaceFile">
            <StackPanel Spacing="4" Padding="4,6">
                <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" FontWeight="Normal" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind FullPath}" TextWrapping="Wrap" Style="{StaticResource WorkspaceCaptionStyle}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ImportResultTemplate" x:DataType="input:FileImportItem">
            <StackPanel Spacing="4" Padding="4,8">
                <TextBlock Text="{x:Bind StatusLabel}" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind Path}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <TextBlock Text="{x:Bind Reason}" TextWrapping="Wrap" Style="{StaticResource WorkspaceCaptionStyle}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="FileTableTemplate" x:DataType="local:WorkspaceFile">
            <Grid ColumnSpacing="12" Background="Transparent" ToolTipService.ToolTip="{x:Bind FullPath}" Tag="{x:Bind}" AllowDrop="True" DragOver="Row_DragOver" DragLeave="Row_DragLeave" Drop="Row_Drop">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding Name, Source={StaticResource FileColumns}, Converter={StaticResource ColumnWidth}}" />
                    <ColumnDefinition Width="{Binding Type, Source={StaticResource FileColumns}, Converter={StaticResource ColumnWidth}}" />
                    <ColumnDefinition Width="{Binding Size, Source={StaticResource FileColumns}, Converter={StaticResource ColumnWidth}}" />
                </Grid.ColumnDefinitions>
                <Grid ColumnSpacing="11">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="7" Background="{ThemeResource WorkspaceSubtleBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="15" Foreground="{x:Bind IconTone, Converter={StaticResource CategoryBrush}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" TextTrimming="CharacterEllipsis" FontSize="13.5" FontWeight="Normal" />
                        <TextBox Text="{x:Bind NamePreview.CustomName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{x:Bind NamePreview.CanEditName, Mode=OneWay}" controls:WorkspaceLocalization.Placeholder="新名称（扩展名自动保留）" AutomationProperties.Name="{x:Bind Name}" controls:WorkspaceLocalization.Help="填写新名称，文件扩展名自动保留" />

                        <StackPanel Spacing="2" Visibility="{x:Bind NamePreview.IsVisible, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind NamePreview.Details, Mode=OneWay}">
                            <Grid HorizontalAlignment="Left" Visibility="{x:Bind NamePreview.HasStructuredDiff, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="→ " FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind NamePreview.LeadUnchanged, Mode=OneWay}" Visibility="{x:Bind NamePreview.HasLeadUnchanged, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource WorkspaceTextBrush}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind NamePreview.RemovedMiddle, Mode=OneWay}" Visibility="{x:Bind NamePreview.ShowRemovedMiddle, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" Margin="2,0" TextDecorations="Strikethrough" Foreground="{ThemeResource WorkspaceDiffRemovedTextBrush}" />
                                <Border Grid.Column="3" Visibility="{x:Bind NamePreview.HasAddedMiddle, Mode=OneWay}" Background="{ThemeResource WorkspaceDiffAddedBackgroundBrush}" CornerRadius="4" Padding="5,0" Margin="1,0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind NamePreview.AddedMiddle, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" FontFamily="Consolas, Microsoft YaHei UI" MaxWidth="220" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource WorkspaceDiffAddedTextBrush}" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="4" Text="{x:Bind NamePreview.TrailUnchanged, Mode=OneWay}" Visibility="{x:Bind NamePreview.HasTrailUnchanged, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" MaxWidth="160" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource WorkspaceTextBrush}" />
                            </Grid>
                            <TextBlock Text="{x:Bind NamePreview.Text, Mode=OneWay}" Visibility="{x:Bind NamePreview.ShowPlainSuccess, Mode=OneWay}" FontWeight="Normal" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{ThemeResource WorkspaceSuccessBrush}" />
                            <TextBlock Text="{x:Bind NamePreview.Text, Mode=OneWay}" Visibility="{x:Bind NamePreview.ShowPlainError, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            <TextBlock Text="{x:Bind NamePreview.Status, Mode=OneWay}" Visibility="{x:Bind NamePreview.HasStatus, Mode=OneWay}" TextTrimming="CharacterEllipsis" FontSize="11.5" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                        </StackPanel>

                        <Border Background="{ThemeResource WorkspaceSubtleBrush}" CornerRadius="4" Padding="6,1" HorizontalAlignment="Left" Visibility="{x:Bind NamePreview.ShowDirectory, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE8B7;" FontSize="10" Foreground="{ThemeResource WorkspaceSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind LocationBadge}" MaxWidth="240" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{ThemeResource WorkspaceSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
                <TextBlock Grid.Column="1" Text="{x:Bind Type}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                <TextBlock Grid.Column="2" Text="{x:Bind SizeLabel, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
            </Grid>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="FileTablePanel"><ItemsStackPanel Orientation="Vertical" /></ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="FileTilePanel"><ItemsWrapGrid Orientation="Horizontal" ItemWidth="220" ItemHeight="192" /></ItemsPanelTemplate>

        <DataTemplate x:Key="FileTileTemplate" x:DataType="local:WorkspaceFile">
            <Grid Background="Transparent" Tag="{x:Bind}" ToolTipService.ToolTip="{x:Bind FullPath}" AllowDrop="True" DragOver="Row_DragOver" DragLeave="Row_DragLeave" Drop="Row_Drop">
                <Grid.RowDefinitions><RowDefinition Height="126" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <preview:FileThumbnail File="{x:Bind Source}" Glyph="{x:Bind Glyph}" />
                <TextBlock Grid.Row="1" Text="{x:Bind DisplayName, Mode=OneWay}" FontSize="12" FontWeight="Normal" Margin="5,9,5,3" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Row="2" Spacing="3" Margin="5,0,5,5" Visibility="{x:Bind NamePreview.IsVisible, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind NamePreview.Details, Mode=OneWay}">
                    <TextBox Text="{x:Bind NamePreview.CustomName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{x:Bind NamePreview.CanEditName, Mode=OneWay}" controls:WorkspaceLocalization.Placeholder="填写新名称" AutomationProperties.Name="{x:Bind Name}" controls:WorkspaceLocalization.Help="文件扩展名自动保留" />
                    <Grid HorizontalAlignment="Left" Visibility="{x:Bind NamePreview.HasStructuredDiff, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="→ " FontSize="11.5" VerticalAlignment="Center" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind NamePreview.LeadUnchanged, Mode=OneWay}" Visibility="{x:Bind NamePreview.HasLeadUnchanged, Mode=OneWay}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource WorkspaceTextBrush}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind NamePreview.RemovedMiddle, Mode=OneWay}" Visibility="{x:Bind NamePreview.ShowRemovedMiddle, Mode=OneWay}" FontSize="11.5" VerticalAlignment="Center" Margin="1,0" TextDecorations="Strikethrough" Foreground="{ThemeResource WorkspaceDiffRemovedTextBrush}" />
                        <Border Grid.Column="3" Visibility="{x:Bind NamePreview.HasAddedMiddle, Mode=OneWay}" Background="{ThemeResource WorkspaceDiffAddedBackgroundBrush}" CornerRadius="4" Padding="4,0" Margin="1,0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind NamePreview.AddedMiddle, Mode=OneWay}" FontSize="11.5" FontWeight="SemiBold" FontFamily="Consolas, Microsoft YaHei UI" MaxWidth="110" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource WorkspaceDiffAddedTextBrush}" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="4" Text="{x:Bind NamePreview.TrailUnchanged, Mode=OneWay}" Visibility="{x:Bind NamePreview.HasTrailUnchanged, Mode=OneWay}" FontSize="11.5" VerticalAlignment="Center" MaxWidth="72" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource WorkspaceTextBrush}" />
                    </Grid>
                    <TextBlock Text="{x:Bind NamePreview.Text, Mode=OneWay}" Visibility="{x:Bind NamePreview.ShowPlainSuccess, Mode=OneWay}" FontWeight="Normal" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource WorkspaceSuccessBrush}" />
                    <TextBlock Text="{x:Bind NamePreview.Text, Mode=OneWay}" Visibility="{x:Bind NamePreview.ShowPlainError, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <TextBlock Text="{x:Bind NamePreview.Status, Mode=OneWay}" Visibility="{x:Bind NamePreview.HasStatus, Mode=OneWay}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="5,0,5,7">
                    <TextBlock Text="{x:Bind Type}" FontSize="11" Foreground="{ThemeResource WorkspaceSecondaryBrush}" MaxWidth="110" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind SizeLabel, Mode=OneWay}" FontSize="11" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="WorkspaceLayout" Style="{StaticResource WorkspacePageLayoutStyle}" Background="Transparent" SizeChanged="WorkspaceLayout_SizeChanged">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <Grid x:Name="WorkspaceHeader" Style="{StaticResource WorkspaceTaskToolbarStyle}" Background="Transparent">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ContentControl x:Name="ToolbarLeadingHost" IsTabStop="False" TabIndex="0" VerticalAlignment="Center" SizeChanged="ToolbarContent_SizeChanged">
                <StackPanel Orientation="Horizontal">
                    <ContentPresenter x:Name="HeaderPresenter" Margin="0,0,14,0" VerticalAlignment="Center" Visibility="Collapsed" />
                </StackPanel>
            </ContentControl>
            <ContentControl x:Name="FilterSearchHost" Grid.Column="1" Margin="0,0,14,0" HorizontalContentAlignment="Stretch" IsTabStop="False" IsEnabled="{x:Bind InputEnabled, Mode=OneWay}">
                <controls:FilterSearchBox x:Name="FilterSearch" controls:WorkspaceLocalization.Placeholder="搜索当前列表" VerticalAlignment="Center" SeparateFields="True" ItemsSource="{x:Bind local:WorkspaceSelectionOptions.Types}" SelectedValue="{x:Bind ViewModel.FilterIndex, Mode=TwoWay}" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanEditList, Mode=OneWay}" />
            </ContentControl>
            <ContentControl x:Name="AlternateHeaderActionsPresenter" Grid.Column="2" TabIndex="2" IsTabStop="False" IsEnabled="{x:Bind InputEnabled, Mode=OneWay}" Visibility="Collapsed" VerticalAlignment="Center" />
            <ContentControl x:Name="HeaderActionsHost" Grid.Column="2" IsEnabled="{x:Bind InputEnabled, Mode=OneWay}" SizeChanged="ToolbarContent_SizeChanged">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <controls:StagingImportButton TargetViewModel="{x:Bind ViewModel, Mode=OneWay}" PickerRequested="ImportFromStaging_Click" QuickImportRequested="QuickImportFromStaging_Requested" Visibility="{x:Bind ViewModel.IsFunctionInput, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanReceiveFiles, Mode=OneWay}" />
                    <controls:AddFilesButton FilesRequested="PickFiles_Click" FolderRequested="PickFolder_Click" IsEnabled="{x:Bind ViewModel.CanReceiveFiles, Mode=OneWay}" />
                    <controls:ActionDropDown controls:WorkspaceLocalization.Content="用于功能" MinWidth="96" Style="{StaticResource WorkspaceToolbarMenuStyle}" Visibility="{x:Bind ViewModel.IsStaging, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanExportAll, Mode=OneWay}">
                        <controls:ActionDropDown.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem controls:WorkspaceLocalization.Text="{x:Bind ViewModel.SendSelectedToConversionLabel, Mode=OneWay}" Click="ConvertSelected_Click" IsEnabled="{x:Bind ViewModel.CanExportSelection, Mode=OneWay}" />
                                <MenuFlyoutItem controls:WorkspaceLocalization.Text="{x:Bind ViewModel.SendAllToConversionLabel, Mode=OneWay}" Click="ConvertAll_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem controls:WorkspaceLocalization.Text="{x:Bind ViewModel.SendSelectedToNamingLabel, Mode=OneWay}" Click="RenameSelected_Click" IsEnabled="{x:Bind ViewModel.CanExportSelection, Mode=OneWay}" />
                                <MenuFlyoutItem controls:WorkspaceLocalization.Text="{x:Bind ViewModel.SendAllToNamingLabel, Mode=OneWay}" Click="RenameAll_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem controls:WorkspaceLocalization.Text="{x:Bind ViewModel.SendSelectedLabel, Mode=OneWay}" Click="SendSelected_Click" IsEnabled="{x:Bind ViewModel.CanExportSelection, Mode=OneWay}" />
                                <MenuFlyoutItem controls:WorkspaceLocalization.Text="{x:Bind ViewModel.SendAllLabel, Mode=OneWay}" Click="SendAll_Click" />
                            </MenuFlyout>
                        </controls:ActionDropDown.Flyout>
                    </controls:ActionDropDown>
                </StackPanel>
            </ContentControl>
        </Grid>

        <Grid x:Name="ListHeightHost" Grid.Row="1" SizeChanged="ListHeightHost_SizeChanged">
            <Grid.RowDefinitions><RowDefinition x:Name="ListHeightRow" Height="*" /><RowDefinition Height="6" /><RowDefinition x:Name="ListRemainderRow" Height="0" /></Grid.RowDefinitions>
            <controls:ResizablePane x:Name="DetailsHost" MinimumContentWidth="536" AllowDrop="True" DragOver="Files_DragOver" DragLeave="Files_DragLeave" Drop="Files_Drop">
                <controls:ResizablePane.MainContent>
                    <ContentControl HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsEnabled="{x:Bind InputEnabled, Mode=OneWay}">
                        <Border Style="{StaticResource WorkspaceSurfaceStyle}" Background="Transparent" BorderThickness="0">
                            <Grid x:Name="InputSurface" SizeChanged="InputSurface_SizeChanged">
                                <Grid.ColumnDefinitions><ColumnDefinition x:Name="FoldersColumn" Width="0" /><ColumnDefinition x:Name="FoldersGapColumn" Width="0" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid x:Name="FolderSidebar" Visibility="Collapsed" Background="{ThemeResource WorkspacePaneBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="0" CornerRadius="0,0,0,11">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <Border Style="{StaticResource WorkspacePaneHeaderStyle}">
                                        <Grid ColumnSpacing="4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="FolderSidebarCaption" controls:WorkspaceLocalization.Text="分组目录" Style="{StaticResource WorkspacePaneTitleStyle}" />
                                            <Button x:Name="NewFolderHeaderButton" Grid.Column="1" Style="{StaticResource WorkspaceIconButtonStyle}" Click="NewFolder_Click" controls:WorkspaceLocalization.Name="新建软件分组目录" controls:WorkspaceLocalization.Tip="新建软件分组目录">
                                                <FontIcon Glyph="&#xE8F4;" FontSize="14" />
                                            </Button>
                                            <Button Grid.Column="2" Style="{StaticResource WorkspaceIconButtonStyle}" Click="CollapseFolders_Click" controls:WorkspaceLocalization.Name="收起分组目录抽屉" controls:WorkspaceLocalization.Tip="收起左侧分组抽屉" Content="" ContentTemplate="{StaticResource WorkspaceLeftPaneIconTemplate}" />
                                        </Grid>
                                    </Border>
                                    <Grid x:Name="FolderTreeArea" Grid.Row="1" Margin="8,8,8,4" Background="Transparent" ContextRequested="FolderTree_ContextRequested" AllowDrop="True" DragEnter="FolderTree_DragOver" DragOver="FolderTree_DragOver" Drop="FolderTree_Drop" DragLeave="FolderTree_DragLeave">
                                        <TreeView x:Name="FolderTree" SelectionMode="Single" SelectionChanged="FolderTree_SelectionChanged" CanDragItems="True" CanReorderItems="False" AllowDrop="True" DragItemsStarting="FolderTree_DragItemsStarting" DragItemsCompleted="FolderTree_DragItemsCompleted" ItemContainerStyle="{StaticResource WorkspaceFolderTreeItemStyle}" controls:WorkspaceLocalization.Name="软件文件夹导航" controls:WorkspaceLocalization.Help="拖到文件夹可变为子文件夹，拖到全部文件或空白处可移到顶层；右键可新建文件夹">
                                            <TreeView.ItemTemplate>
                                                <DataTemplate x:DataType="TreeViewNode">
                                                    <Grid ColumnSpacing="6" ToolTipService.ToolTip="{x:Bind ((local:FolderNavigationItem)Content).Name, Mode=OneWay}">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <FontIcon Style="{StaticResource WorkspaceFolderIconStyle}" Foreground="{ThemeResource WorkspaceCategoryFolderBrush}" />
                                                        <TextBlock Grid.Column="1" Text="{x:Bind ((local:FolderNavigationItem)Content).Name, Mode=OneWay}" Style="{StaticResource WorkspaceFolderNameStyle}" />
                                                        <TextBlock Grid.Column="2" Text="{x:Bind ((local:FolderNavigationItem)Content).Count, Mode=OneWay}" Typography.NumeralAlignment="Tabular" Style="{StaticResource WorkspaceFolderMetadataStyle}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </TreeView.ItemTemplate>
                                        </TreeView>
                                    </Grid>
                                    <ContentPresenter x:Name="AlternateFolderPresenter" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed" />
                                </Grid>

                                <Border x:Name="CollapsedFolders" Visibility="Collapsed" Background="{ThemeResource WorkspacePaneBrush}" CornerRadius="0,0,0,11">
                                    <StackPanel HorizontalAlignment="Center" Margin="0,12,0,0" Spacing="12">
                                        <Button Style="{StaticResource WorkspaceIconButtonStyle}" Click="ExpandFolders_Click" controls:WorkspaceLocalization.Name="展开左侧栏" controls:WorkspaceLocalization.Tip="展开左侧栏" Content="" ContentTemplate="{StaticResource WorkspaceLeftPaneIconTemplate}" />
                                        <TextBlock controls:WorkspaceLocalization.Text="目&#10;录&#10;树" TextAlignment="Center" FontSize="11" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                                    </StackPanel>
                                </Border>

                                <Grid x:Name="FilesContentHost" Grid.Column="2">
                                    <ContentControl x:Name="FileSurfaceHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                        <Border Style="{StaticResource WorkspaceSurfaceStyle}" Background="Transparent">
                                            <controls:MarqueeSelection Target="{x:Bind FileList}" SelectionCommitted="Files_MarqueeCommitted">
                                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                                                <Grid x:Name="FilesPathBar" Style="{StaticResource WorkspacePathBarStyle}" ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <Grid x:Name="FolderIdentity" VerticalAlignment="Center" ColumnSpacing="6">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>

                                                        <ToggleButton x:Name="FolderDrawerToggle" Click="ToggleFolderDrawer_Click" Style="{StaticResource WorkspaceNavigationButtonStyle}" MinHeight="28" Padding="8,4" FontSize="12" AllowDrop="True" DragOver="DrawerToggle_DragOver" Drop="FolderTree_Drop" controls:MarqueeSelection.IsExcluded="True" controls:WorkspaceLocalization.Name="展开或收起软件分组目录抽屉" controls:WorkspaceLocalization.Tip="展开 / 收起软件内分组目录抽屉（也可直接右键新建分组目录）">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <FontIcon Glyph="&#xE8F4;" FontSize="13" />
                                                                <TextBlock controls:WorkspaceLocalization.Text="分组目录" />
                                                                <Border Background="{ThemeResource WorkspaceSubtleBrush}" CornerRadius="7" Padding="5,0" Visibility="{x:Bind ViewModel.HasCustomFolders, Mode=OneWay}">
                                                                    <TextBlock Text="{x:Bind ViewModel.CustomFolderCount, Mode=OneWay}" FontSize="10.5" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                                                                </Border>
                                                            </StackPanel>
                                                        </ToggleButton>

                                                        <Button Grid.Column="1" Click="FolderUp_Click" IsEnabled="{x:Bind ViewModel.CanGoUp, Mode=OneWay}" Style="{StaticResource WorkspaceIconButtonStyle}" Width="28" Height="28" VerticalAlignment="Center" controls:WorkspaceLocalization.Name="返回上一级软件文件夹" controls:WorkspaceLocalization.Tip="返回上一级"><FontIcon Style="{StaticResource WorkspaceParentFolderIconStyle}" /></Button>
                                                        <FontIcon Grid.Column="2" Glyph="&#xE8B7;" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource WorkspaceCategoryFolderBrush}" />
                                                        <BreadcrumbBar Grid.Column="3" ItemsSource="{x:Bind ViewModel.Breadcrumbs, Mode=OneWay}" ItemClicked="CollectionBreadcrumb_Click" IsEnabled="{x:Bind ViewModel.CanReceiveFiles, Mode=OneWay}" VerticalAlignment="Center" controls:WorkspaceLocalization.Name="当前软件文件夹路径" ToolTipService.ToolTip="{x:Bind ViewModel.CurrentFolderPath, Mode=OneWay}" controls:MarqueeSelection.IsExcluded="True">
                                                            <BreadcrumbBar.ItemTemplate>
                                                                <DataTemplate x:DataType="local:FolderBreadcrumb">
                                                                    <controls:BreadcrumbLabel>
                                                                        <TextBlock Text="{x:Bind Name}" ToolTipService.ToolTip="{x:Bind Name}" MaxWidth="148" Style="{StaticResource WorkspaceFolderNameStyle}" FontWeight="Normal" />
                                                                    </controls:BreadcrumbLabel>
                                                                </DataTemplate>
                                                            </BreadcrumbBar.ItemTemplate>
                                                        </BreadcrumbBar>
                                                        <TextBlock Grid.Column="4" FontSize="11.5" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource WorkspaceSecondaryBrush}" VerticalAlignment="Center"><Run Text="{x:Bind ViewModel.VisibleFiles.Count, Mode=OneWay}" /><Run controls:WorkspaceLocalization.Text=" 项" /></TextBlock>
                                                    </Grid>

                                                    <StackPanel x:Name="ViewActions" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right" controls:MarqueeSelection.IsExcluded="True">
                                                        <ContentPresenter x:Name="PathBarActionsPresenter" VerticalAlignment="Center" Visibility="Collapsed" />
                                                        <StackPanel x:Name="ViewModeButtonsHost" Orientation="Horizontal" Spacing="2">
                                                            <ToggleButton x:Name="ListModeButton" Width="30" MinHeight="28" Click="ListMode_Click" Style="{StaticResource WorkspaceNavigationButtonStyle}" Padding="6" controls:WorkspaceLocalization.Name="列表视图" controls:WorkspaceLocalization.Tip="列表视图"><FontIcon Glyph="&#xEA37;" FontSize="14" /></ToggleButton>
                                                            <ToggleButton x:Name="TileModeButton" Width="30" MinHeight="28" Click="TileMode_Click" Style="{StaticResource WorkspaceNavigationButtonStyle}" Padding="6" controls:WorkspaceLocalization.Name="缩略图视图" controls:WorkspaceLocalization.Tip="缩略图视图"><FontIcon Glyph="&#xF0E2;" FontSize="14" /></ToggleButton>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>

                                                <Grid Grid.Row="1" Background="Transparent" RightTapped="Files_RightTapped">
                                                    <Grid.ContextFlyout><MenuFlyout Opening="CollectionMenu_Opening" MenuFlyoutPresenterStyle="{StaticResource ActionDropDownPresenterStyle}" /></Grid.ContextFlyout>
                                                    <Grid.RowDefinitions><RowDefinition x:Name="FilesHeaderRow" Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                                    <ContentPresenter x:Name="CustomBodyPresenter" Grid.RowSpan="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed" controls:MarqueeSelection.IsExcluded="True" />
                                                    <ScrollViewer x:Name="FilesViewport" Grid.RowSpan="2" SizeChanged="FilesViewport_SizeChanged" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                                                        <Grid x:Name="TableContent" Width="{Binding ViewportWidth, ElementName=FilesViewport}">
                                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                                            <Border x:Name="FilesHeader" controls:MarqueeSelection.IsExcluded="True" SizeChanged="FilesHeader_SizeChanged" Padding="18,5" Background="{ThemeResource WorkspaceSubtleBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="0,0,0,1">
                                                                <Grid ColumnSpacing="12">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="{Binding Name, Source={StaticResource FileColumns}, Converter={StaticResource ColumnWidth}}" />
                                                                        <ColumnDefinition Width="{Binding Type, Source={StaticResource FileColumns}, Converter={StaticResource ColumnWidth}}" />
                                                                        <ColumnDefinition Width="{Binding Size, Source={StaticResource FileColumns}, Converter={StaticResource ColumnWidth}}" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Button Tag="Name" Click="SortColumn_Click" Style="{StaticResource WorkspaceColumnHeaderButtonStyle}" Margin="40,0,6,0" controls:WorkspaceLocalization.Name="按文件名排序" controls:WorkspaceLocalization.Tip="点击按文件名升序 / 降序排列">
                                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                                            <TextBlock controls:WorkspaceLocalization.Text="文件名 / 位置与结果预览" />
                                                                            <FontIcon Glyph="{x:Bind ViewModel.NameSortGlyph, Mode=OneWay}" FontSize="9.5" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                    <Button Grid.Column="1" Tag="Type" Click="SortColumn_Click" Style="{StaticResource WorkspaceColumnHeaderButtonStyle}" Margin="-4,0,6,0" controls:WorkspaceLocalization.Name="按文件类型排序" controls:WorkspaceLocalization.Tip="点击按类型升序 / 降序排列">
                                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                                            <TextBlock controls:WorkspaceLocalization.Text="类型" />
                                                                            <FontIcon Glyph="{x:Bind ViewModel.TypeSortGlyph, Mode=OneWay}" FontSize="9.5" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                    <Button Grid.Column="2" Tag="Size" Click="SortColumn_Click" Style="{StaticResource WorkspaceColumnHeaderButtonStyle}" Margin="-4,0,6,0" controls:WorkspaceLocalization.Name="按文件大小排序" controls:WorkspaceLocalization.Tip="点击按大小降序 / 升序排列">
                                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                                            <TextBlock controls:WorkspaceLocalization.Text="大小" />
                                                                            <FontIcon Glyph="{x:Bind ViewModel.SizeSortGlyph, Mode=OneWay}" FontSize="9.5" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                    <controls:ResizeHandle Tag="Name" Style="{StaticResource ColumnResizeHandle}" ResizeRequested="Column_ResizeRequested" controls:WorkspaceLocalization.Name="调整文件名与所在位置列宽" controls:WorkspaceLocalization.Tip="拖动调整文件名与所在位置列宽" />
                                                                    <controls:ResizeHandle Grid.Column="1" Tag="Type" Style="{StaticResource ColumnResizeHandle}" ResizeRequested="Column_ResizeRequested" controls:WorkspaceLocalization.Name="调整类型列宽" controls:WorkspaceLocalization.Tip="拖动调整类型列宽" />
                                                                    <controls:ResizeHandle Grid.Column="2" Tag="Size" Style="{StaticResource ColumnResizeHandle}" ResizeRequested="Column_ResizeRequested" controls:WorkspaceLocalization.Name="调整大小列宽" controls:WorkspaceLocalization.Tip="拖动调整大小列宽" />
                                                                </Grid>
                                                            </Border>
                                                            <ListView x:Name="FileList" ItemTemplate="{StaticResource FileTableTemplate}" SizeChanged="FileList_SizeChanged" ContainerContentChanging="FileList_ContainerContentChanging" Grid.Row="1" ItemsSource="{x:Bind ViewModel.VisibleFiles}" SelectionMode="Extended" IsMultiSelectCheckBoxEnabled="True" ItemContainerStyle="{StaticResource WorkspaceListItemStyle}" SelectionChanged="FileList_SelectionChanged" Margin="4,4" Padding="0,0,0,58" Visibility="{x:Bind ViewModel.ShowList, Mode=OneWay}" KeyDown="Files_KeyDown" CanDragItems="True" CanReorderItems="False" DragItemsStarting="Files_DragItemsStarting" DragItemsCompleted="Files_DragItemsCompleted" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" controls:WorkspaceLocalization.Name="待处理文件列表" controls:WorkspaceLocalization.Help="从空白处拖动可框选文件，按住 Ctrl 或 Shift 可追加选择，Esc 取消框选">
                                                                <ListView.KeyboardAccelerators>
                                                                    <KeyboardAccelerator Key="A" Modifiers="Control" ScopeOwner="{x:Bind FileList}" Invoked="SelectAll_Invoked" />
                                                                    <KeyboardAccelerator Key="Delete" ScopeOwner="{x:Bind FileList}" Invoked="Remove_Invoked" />
                                                                </ListView.KeyboardAccelerators>
                                                            </ListView>
                                                        </Grid>
                                                    </ScrollViewer>

                                                    <!-- Tactile Layered Empty State with Magnetic Fan-Out (Calm Neutral Border Only — No Yellow/Amber Glow) -->
                                                    <ContentControl Grid.Row="1" Style="{StaticResource WorkspaceCenteredStateStyle}" Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}">
                                                        <Border x:Name="EmptyStateCard" MaxWidth="440" Padding="32,28" CornerRadius="12" Background="{ThemeResource WorkspaceCardBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" PointerEntered="EmptyState_PointerEntered" PointerExited="EmptyState_PointerExited">
                                                            <StackPanel Spacing="14" HorizontalAlignment="Center">
                                                                <Grid Width="108" Height="68" HorizontalAlignment="Center" Margin="0,0,0,2">
                                                                    <Border x:Name="EmptyFanLeft" Width="40" Height="50" CornerRadius="7" Background="{ThemeResource WorkspaceSubtleBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                                        <Border.RenderTransform>
                                                                            <TransformGroup>
                                                                                <RotateTransform x:Name="EmptyFanLeftRotate" Angle="-11" />
                                                                                <TranslateTransform x:Name="EmptyFanLeftTranslate" X="-15" Y="4" />
                                                                            </TransformGroup>
                                                                        </Border.RenderTransform>
                                                                    </Border>
                                                                    <Border x:Name="EmptyFanRight" Width="40" Height="50" CornerRadius="7" Background="{ThemeResource WorkspaceSubtleBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                                        <Border.RenderTransform>
                                                                            <TransformGroup>
                                                                                <RotateTransform x:Name="EmptyFanRightRotate" Angle="11" />
                                                                                <TranslateTransform x:Name="EmptyFanRightTranslate" X="15" Y="4" />
                                                                            </TransformGroup>
                                                                        </Border.RenderTransform>
                                                                    </Border>
                                                                    <Border x:Name="EmptyFanCenter" Width="44" Height="54" CornerRadius="8" Background="{ThemeResource WorkspaceSurfaceBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                                        <Border.RenderTransform><TranslateTransform x:Name="EmptyFanCenterTranslate" Y="0" /></Border.RenderTransform>
                                                                        <FontIcon Glyph="&#xE710;" FontSize="18" Foreground="{ThemeResource WorkspaceAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                </Grid>
                                                                <TextBlock controls:WorkspaceLocalization.Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" />
                                                                <TextBlock controls:WorkspaceLocalization.Text="{x:Bind ViewModel.InputDescription, Mode=OneWay}" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource WorkspaceSecondaryBrush}" MaxWidth="340" />
                                                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,4,0,0">
                                                                    <controls:AddFilesButton FilesRequested="PickFiles_Click" FolderRequested="PickFolder_Click" IsEnabled="{x:Bind ViewModel.CanReceiveFiles, Mode=OneWay}" />
                                                                    <controls:StagingImportButton TargetViewModel="{x:Bind ViewModel, Mode=OneWay}" PickerRequested="ImportFromStaging_Click" QuickImportRequested="QuickImportFromStaging_Requested" Visibility="{x:Bind ViewModel.IsFunctionInput, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanReceiveFiles, Mode=OneWay}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </ContentControl>

                                                    <ContentControl Grid.Row="1" Style="{StaticResource WorkspaceCenteredStateStyle}" Visibility="{x:Bind ViewModel.ShowNoResults, Mode=OneWay}">
                                                        <StackPanel Spacing="12" HorizontalAlignment="Center">
                                                            <Grid Width="54" Height="54" HorizontalAlignment="Center">
                                                                <Border Width="44" Height="44" CornerRadius="12" Background="{ThemeResource WorkspaceSubtleBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <Border.RenderTransform><RotateTransform Angle="-8" CenterX="22" CenterY="22" /></Border.RenderTransform>
                                                                </Border>
                                                                <Border Width="44" Height="44" CornerRadius="12" Background="{ThemeResource WorkspaceCardBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <FontIcon Glyph="&#xE721;" FontSize="18" Foreground="{ThemeResource WorkspaceAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </Grid>
                                                            <TextBlock controls:WorkspaceLocalization.Text="没有匹配的文件" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                            <TextBlock controls:WorkspaceLocalization.Text="试试其他关键词，或清除筛选条件。" Foreground="{ThemeResource WorkspaceSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                                                            <Button controls:WorkspaceLocalization.Content="清除筛选" HorizontalAlignment="Center" Command="{x:Bind ViewModel.ResetFiltersCommand}" />
                                                        </StackPanel>
                                                    </ContentControl>

                                                    <ContentControl Grid.Row="1" Style="{StaticResource WorkspaceCenteredStateStyle}" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
                                                        <StackPanel Spacing="14" HorizontalAlignment="Center">
                                                            <ProgressRing Width="34" Height="34" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Foreground="{ThemeResource WorkspaceAccentBrush}" />
                                                            <TextBlock controls:WorkspaceLocalization.Text="{x:Bind ViewModel.LoadingMessage, Mode=OneWay}" FontSize="16" />
                                                            <Button controls:WorkspaceLocalization.Content="取消加载" HorizontalAlignment="Center" Command="{x:Bind ViewModel.CancelLoadingCommand}" />
                                                        </StackPanel>
                                                    </ContentControl>

                                                    <ContentControl Grid.Row="1" Style="{StaticResource WorkspaceCenteredStateStyle}" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}">
                                                        <StackPanel Spacing="12" HorizontalAlignment="Center">
                                                            <FontIcon Glyph="&#xE783;" FontSize="34" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                            <TextBlock controls:WorkspaceLocalization.Text="暂时无法加载文件" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" />
                                                            <TextBlock controls:WorkspaceLocalization.Text="文件可能已移动或无法访问，可重试或返回原列表。" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                                                <Button controls:WorkspaceLocalization.Content="重试示例" Command="{x:Bind ViewModel.LoadSamplesCommand}" />
                                                                <Button controls:WorkspaceLocalization.Content="返回列表" Command="{x:Bind ViewModel.DismissErrorCommand}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </ContentControl>

                                                    <!-- Floating Frosted Multi-Select Action Island -->
                                                    <Border x:Name="FloatingActionIsland" Grid.Row="1" Style="{StaticResource WorkspaceFloatingIslandStyle}" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12,0,12,12" Translation="0,0,24" controls:MarqueeSelection.IsExcluded="True">
                                                        <Border.Shadow><ThemeShadow /></Border.Shadow>
                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <TextBlock x:Name="IslandSummaryText" controls:WorkspaceLocalization.Text="{x:Bind ViewModel.IslandSummary, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource WorkspaceIslandTextBrush}" VerticalAlignment="Center" />
                                                            <Border Width="1" Height="14" Background="{ThemeResource WorkspaceIslandBorderBrush}" Margin="4,0" VerticalAlignment="Center" />
                                                            <Button controls:WorkspaceLocalization.Content="快速预览" Style="{StaticResource WorkspaceIslandActionStyle}" Click="QuickLook_Click" controls:WorkspaceLocalization.Tip="全尺寸快速预览与画质对比" />
                                                            <Button controls:WorkspaceLocalization.Content="加入暂存" Style="{StaticResource WorkspaceIslandActionStyle}" Click="AddToStaging_Click" Visibility="{x:Bind ViewModel.IsFunctionInput, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanExportSelection, Mode=OneWay}" />
                                                            <Button controls:WorkspaceLocalization.Content="转格式" Style="{StaticResource WorkspaceIslandActionStyle}" Click="ConvertSelected_Click" Visibility="{x:Bind ViewModel.IsNotConversionInput, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanExportSelection, Mode=OneWay}" />
                                                            <Button controls:WorkspaceLocalization.Content="批量改名" Style="{StaticResource WorkspaceIslandActionStyle}" Click="RenameSelected_Click" Visibility="{x:Bind ViewModel.IsNotRenameInput, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanExportSelection, Mode=OneWay}" />
                                                            <Button controls:WorkspaceLocalization.Content="复制整理" Style="{StaticResource WorkspaceIslandActionStyle}" Click="SendSelected_Click" Visibility="{x:Bind ViewModel.IsNotCopyInput, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanExportSelection, Mode=OneWay}" />
                                                            <Button controls:WorkspaceLocalization.Content="移出" Style="{StaticResource WorkspaceIslandActionStyle}" Click="Remove_Click" controls:WorkspaceLocalization.Tip="只从当前列表移出引用，不删除原件" />
                                                            <Button Content="✕" Style="{StaticResource WorkspaceIslandActionStyle}" Padding="8,3" Click="ClearSelection_Click" controls:WorkspaceLocalization.Name="取消勾选" controls:WorkspaceLocalization.Tip="取消勾选" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>

                                                <Border Grid.Row="2" controls:MarqueeSelection.IsExcluded="True" Background="{ThemeResource WorkspaceSubtleBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="0,1,0,0" Padding="16,7">
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                            <TextBlock controls:WorkspaceLocalization.Text="{x:Bind ViewModel.ListSummary, Mode=OneWay}" Typography.NumeralAlignment="Tabular" Style="{StaticResource WorkspaceCaptionStyle}" />
                                                            <TextBlock Text="·" Style="{StaticResource WorkspaceCaptionStyle}" />
                                                            <TextBlock controls:WorkspaceLocalization.Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}" MaxWidth="520" TextTrimming="CharacterEllipsis" Style="{StaticResource WorkspaceCaptionStyle}" controls:WorkspaceLocalization.Tip="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                            <Button controls:WorkspaceLocalization.Content="操作明细" Style="{StaticResource WorkspaceToolbarButtonStyle}" MinHeight="26" Padding="9,3" Visibility="{x:Bind ViewModel.HasFooterMessage, Mode=OneWay}" Click="ImportDetails_Click" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </controls:MarqueeSelection>
                                        </Border>
                                    </ContentControl>
                                    <ContentPresenter x:Name="AlternatePresenter" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed" />
                                </Grid>
                                <controls:ResizeHandle x:Name="FoldersResizeHandle" Grid.Column="1" Canvas.ZIndex="20" Visibility="Collapsed" ResizeRequested="Folders_ResizeRequested" ResetRequested="Folders_ResetRequested" controls:WorkspaceLocalization.Name="调整左侧文件夹栏宽度" />
                            </Grid>
                        </Border>
                    </ContentControl>
                </controls:ResizablePane.MainContent>
                <controls:ResizablePane.PaneContent>
                    <Border Style="{StaticResource WorkspaceSurfaceStyle}" Background="{ThemeResource WorkspacePaneBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="0" CornerRadius="0,0,11,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Border Style="{StaticResource WorkspacePaneHeaderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="InspectorTitle" controls:WorkspaceLocalization.Text="文件信息" Style="{StaticResource WorkspacePaneTitleStyle}" />
                                    <Button Grid.Column="1" Style="{StaticResource WorkspaceIconButtonStyle}" Click="CollapseInspector_Click" controls:WorkspaceLocalization.Name="收起右侧栏" controls:WorkspaceLocalization.Tip="收起右侧栏" Content="" ContentTemplate="{StaticResource WorkspaceRightPaneIconTemplate}" />
                                </Grid>
                            </Border>
                            <Grid Grid.Row="1">
                                <local:FileInspector x:Name="Inspector" ViewModel="{x:Bind ViewModel}" />
                                <ContentPresenter x:Name="OperationPresenter" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed" />
                            </Grid>
                        </Grid>
                    </Border>
                </controls:ResizablePane.PaneContent>
                <controls:ResizablePane.CollapsedPaneContent>
                    <Border Style="{StaticResource WorkspaceSurfaceStyle}" Background="{ThemeResource WorkspacePaneBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="0" CornerRadius="0,0,11,0">
                        <StackPanel HorizontalAlignment="Center" Margin="0,12,0,0" Spacing="12">
                            <Button Style="{StaticResource WorkspaceIconButtonStyle}" Click="ExpandInspector_Click" controls:WorkspaceLocalization.Name="展开右侧栏" controls:WorkspaceLocalization.Tip="展开右侧栏" Content="" ContentTemplate="{StaticResource WorkspaceRightPaneIconTemplate}" />
                            <TextBlock controls:WorkspaceLocalization.Text="设&#10;置&#10;与&#10;预&#10;览" TextAlignment="Center" FontSize="11" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </controls:ResizablePane.CollapsedPaneContent>
            </controls:ResizablePane>
            <controls:ResizeHandle Grid.Row="1" ResizeDirection="Vertical" ResizeRequested="ListHeight_ResizeRequested" DoubleTapped="ListHeight_Reset" controls:WorkspaceLocalization.Name="调整文件列表高度" controls:WorkspaceLocalization.Tip="上下拖动调整列表高度，双击恢复填满" />
        </Grid>
    </Grid>
</UserControl>
