<UserControl
    x:Class="FileAssistant.App.Features.FileInput.CollectionSourcePicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FileAssistant.App.Controls"
    xmlns:local="using:FileAssistant.App.Features.FileInput"
    xmlns:workspace="using:FileAssistant.App.Features.Workspace">
    <Grid
        x:Name="PickerLayout"
        Width="700"
        Height="504"
        Background="{ThemeResource WorkspaceDialogBrush}"
        BorderBrush="{ThemeResource WorkspaceBorderBrush}"
        BorderThickness="1"
        CornerRadius="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Band 1: Modal Header ("从暂存区导入" + Target Badge Pill + Close Icon) -->
        <Grid
            Padding="18,14,12,11"
            BorderBrush="{ThemeResource WorkspaceBorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock
                    Text="从暂存区导入"
                    FontSize="16"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
                <Border
                    x:Name="TargetBadgePill"
                    Style="{StaticResource WorkspacePillBadgeStyle}"
                    Padding="8,2"
                    VerticalAlignment="Center">
                    <TextBlock
                        x:Name="TargetBadgeText"
                        Text="格式转换"
                        FontSize="11.5"
                        Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                </Border>
            </StackPanel>
            <Button
                Grid.Column="1"
                Width="28"
                Height="28"
                Style="{StaticResource WorkspaceIconButtonStyle}"
                Click="Close_Click"
                AutomationProperties.Name="关闭导入窗口"
                ToolTipService.ToolTip="关闭（Esc）">
                <FontIcon Glyph="&#xE711;" FontSize="11.5" />
            </Button>
        </Grid>

        <!-- Band 2: Single-Row Breadcrumb + Type Filter + Search Bar -->
        <Grid
            Grid.Row="1"
            Padding="14,8"
            ColumnSpacing="8"
            Background="{ThemeResource WorkspaceSurfaceBrush}"
            BorderBrush="{ThemeResource WorkspaceBorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="176" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="UpButton"
                Width="28"
                Height="28"
                Style="{StaticResource WorkspaceIconButtonStyle}"
                Click="Up_Click"
                AutomationProperties.Name="返回上一级目录"
                ToolTipService.ToolTip="返回上一级（Backspace）">
                <FontIcon Style="{StaticResource WorkspaceParentFolderIconStyle}" />
            </Button>
            <FontIcon
                Grid.Column="1"
                Glyph="&#xE8B7;"
                FontSize="14"
                Margin="2,0,0,0"
                Foreground="{ThemeResource WorkspaceCategoryFolderBrush}"
                VerticalAlignment="Center" />
            <BreadcrumbBar
                x:Name="PathBreadcrumbs"
                Grid.Column="2"
                ItemClicked="Breadcrumb_Click"
                VerticalAlignment="Center"
                AutomationProperties.Name="暂存区当前目录路径">
                <BreadcrumbBar.ItemTemplate>
                    <DataTemplate x:DataType="workspace:FolderBreadcrumb">
                        <controls:BreadcrumbLabel>
                            <TextBlock
                                Text="{x:Bind Name}"
                                ToolTipService.ToolTip="{x:Bind Name}"
                                MaxWidth="140"
                                Style="{StaticResource WorkspaceFolderNameStyle}"
                                FontWeight="Normal" />
                        </controls:BreadcrumbLabel>
                    </DataTemplate>
                </BreadcrumbBar.ItemTemplate>
            </BreadcrumbBar>
            <controls:SelectionDropDown
                x:Name="TypeFilter"
                Grid.Column="3"
                Width="104"
                MinHeight="30"
                Style="{StaticResource WorkspaceToolbarSelectorStyle}"
                VerticalAlignment="Center"
                ItemsSource="{x:Bind workspace:WorkspaceSelectionOptions.Types}"
                SelectionCommitted="TypeFilter_SelectionCommitted"
                AutomationProperties.Name="按文件类型筛选" />
            <Grid Grid.Column="4" VerticalAlignment="Center">
                <TextBox
                    x:Name="SearchBox"
                    Style="{StaticResource WorkspaceToolbarFieldStyle}"
                    MinHeight="30"
                    Padding="10,4,28,4"
                    FontSize="12"
                    PlaceholderText="搜索暂存区…"
                    TextChanged="SearchBox_TextChanged"
                    AutomationProperties.Name="搜索暂存区文件" />
                <FontIcon
                    Glyph="&#xE721;"
                    FontSize="12"
                    HorizontalAlignment="Right"
                    Margin="0,0,9,0"
                    Foreground="{ThemeResource WorkspaceSecondaryBrush}"
                    IsHitTestVisible="False"
                    AutomationProperties.AccessibilityView="Raw" />
            </Grid>
        </Grid>

        <!-- Band 3: Edge-to-Edge Two-Column Split Body -->
        <Grid Grid.Row="2" Background="{ThemeResource WorkspaceSurfaceBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TreeColumn" Width="184" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left staging folder tree (auto-collapsed when staging has no custom folders) -->
            <Border
                x:Name="TreePane"
                Background="{ThemeResource WorkspacePaneBrush}"
                BorderBrush="{ThemeResource WorkspaceBorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="8,8,8,6">
                <Grid RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Text="暂存区分组"
                        Margin="8,2,8,2"
                        Style="{StaticResource WorkspaceCaptionStyle}"
                        FontSize="11"
                        FontWeight="SemiBold" />
                    <TreeView
                        x:Name="FolderTree"
                        Grid.Row="1"
                        SelectionMode="Single"
                        CanDragItems="False"
                        CanReorderItems="False"
                        SelectionChanged="FolderTree_SelectionChanged"
                        ItemContainerStyle="{StaticResource WorkspaceFolderTreeItemStyle}"
                        AutomationProperties.Name="暂存区分组目录树">
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="TreeViewNode">
                                <Grid ColumnSpacing="6" ToolTipService.ToolTip="{x:Bind ((local:StagingTreeNodeItem)Content).Name, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Style="{StaticResource WorkspaceFolderIconStyle}" Foreground="{ThemeResource WorkspaceCategoryFolderBrush}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind ((local:StagingTreeNodeItem)Content).Name, Mode=OneWay}"
                                        Style="{StaticResource WorkspaceFolderNameStyle}" />
                                    <Ellipse
                                        Grid.Column="2"
                                        Width="6"
                                        Height="6"
                                        Fill="{ThemeResource WorkspaceSuccessBrush}"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind ((local:StagingTreeNodeItem)Content).HasSelection, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Column="3"
                                        Text="{x:Bind ((local:StagingTreeNodeItem)Content).Count, Mode=OneWay}"
                                        Typography.NumeralAlignment="Tabular"
                                        Style="{StaticResource WorkspaceFolderMetadataStyle}" />
                                </Grid>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <!-- Right high-density multi-select file table -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Table header with 3-state select-all checkbox -->
                <Border
                    Height="34"
                    Background="{ThemeResource WorkspaceSubtleBrush}"
                    BorderBrush="{ThemeResource WorkspaceBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,0,16,0">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="98" />
                            <ColumnDefinition Width="82" />
                        </Grid.ColumnDefinitions>
                        <CheckBox
                            x:Name="SelectAllCheck"
                            MinWidth="0"
                            MinHeight="20"
                            Padding="0"
                            IsThreeState="True"
                            VerticalAlignment="Center"
                            Click="SelectAllCheck_Click"
                            AutomationProperties.Name="全选或取消全选当前列表"
                            ToolTipService.ToolTip="全选 / 取消全选本层" />
                        <TextBlock
                            Grid.Column="1"
                            Text="名称"
                            Style="{StaticResource WorkspaceCaptionStyle}"
                            FontSize="11.5"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Grid.Column="2"
                            Text="类型"
                            Style="{StaticResource WorkspaceCaptionStyle}"
                            FontSize="11.5"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Grid.Column="3"
                            Text="大小 / 项数"
                            Style="{StaticResource WorkspaceCaptionStyle}"
                            FontSize="11.5"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <ListView
                    x:Name="Files"
                    Grid.Row="1"
                    SelectionMode="Multiple"
                    IsMultiSelectCheckBoxEnabled="True"
                    IsItemClickEnabled="False"
                    Padding="6,4"
                    ItemContainerStyle="{StaticResource WorkspaceListItemStyle}"
                    SelectionChanged="Files_SelectionChanged"
                    KeyDown="Files_KeyDown"
                    AutomationProperties.Name="暂存区文件夹和文件列表">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="workspace:WorkspaceFile">
                            <Grid
                                ColumnSpacing="8"
                                MinHeight="36"
                                Padding="0,3,8,3"
                                Background="Transparent"
                                ToolTipService.ToolTip="{x:Bind FullPath}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="98" />
                                    <ColumnDefinition Width="82" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    Glyph="{x:Bind Glyph}"
                                    FontSize="15"
                                    Foreground="{x:Bind IconTone, Converter={StaticResource CategoryBrush}}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{x:Bind Name}"
                                    FontSize="12.5"
                                    TextTrimming="CharacterEllipsis"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Grid.Column="2"
                                    Text="{x:Bind PickerTypeLabel}"
                                    FontSize="11.5"
                                    Foreground="{ThemeResource WorkspaceSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Grid.Column="3"
                                    Text="{x:Bind PickerSizeOrCountLabel}"
                                    FontSize="11.5"
                                    Foreground="{ThemeResource WorkspaceSecondaryBrush}"
                                    HorizontalAlignment="Right"
                                    Typography.NumeralAlignment="Tabular"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel
                    x:Name="EmptyState"
                    Grid.Row="1"
                    Spacing="4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="EmptyStateText"
                        Text="当前目录为空"
                        Style="{StaticResource WorkspaceCaptionStyle}"
                        HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Band 4: Unified Single-Row / Stacked-Left Footer -->
        <Border
            Grid.Row="3"
            Padding="16,10"
            CornerRadius="0,0,11,11"
            Background="{ThemeResource WorkspacePaneBrush}"
            BorderBrush="{ThemeResource WorkspaceBorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Bottom-left destination pill + preserve structure checkbox -->
                <StackPanel
                    x:Name="DestinationRegion"
                    Spacing="5"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left">
                    <Button
                        x:Name="DestinationButton"
                        Style="{StaticResource WorkspaceToolbarButtonStyle}"
                        MinHeight="30"
                        Padding="10,4"
                        AutomationProperties.Name="选择导入目标分组"
                        ToolTipService.ToolTip="点击切换或新建导入目标文件夹（原文件位置不变，重复项自动跳过）">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock
                                Text="导入至："
                                FontSize="12"
                                Foreground="{ThemeResource WorkspaceSecondaryBrush}"
                                VerticalAlignment="Center" />
                            <FontIcon
                                Glyph="&#xE8B7;"
                                FontSize="13"
                                Foreground="{ThemeResource WorkspaceCategoryFolderBrush}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="DestinationNameText"
                                Text="全部文件"
                                FontSize="12"
                                MaxWidth="190"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center" />
                            <FontIcon
                                Glyph="&#xE70D;"
                                FontSize="9"
                                Foreground="{ThemeResource WorkspaceSecondaryBrush}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout x:Name="DestinationFlyout" Placement="TopEdgeAlignedLeft">
                                <local:CollectionFolderPicker x:Name="DestinationPicker" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <CheckBox
                        x:Name="PreserveCheck"
                        Content="保留目录结构"
                        IsChecked="True"
                        MinWidth="0"
                        MinHeight="22"
                        Padding="6,0,0,0"
                        FontSize="12"
                        Visibility="Collapsed"
                        Checked="PreserveCheck_Changed"
                        Unchecked="PreserveCheck_Changed"
                        ToolTipService.ToolTip="导入软件文件夹时，在目标位置同步建立同名分组" />
                </StackPanel>

                <!-- Fallback left hint when destination picker is hidden (e.g. Cleanup flat list) -->
                <TextBlock
                    x:Name="FlatModeHint"
                    Text="原文件位置不变，重复项自动跳过"
                    Style="{StaticResource WorkspaceCaptionStyle}"
                    VerticalAlignment="Center"
                    Visibility="Collapsed" />

                <!-- Bottom-right live dedup count + Clear + Cancel + Primary Import -->
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <TextBlock
                        x:Name="CountText"
                        Text="已选 0 项"
                        Style="{StaticResource WorkspaceCaptionStyle}"
                        FontSize="12"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="含子文件夹，已自动去重；原文件位置不变，重复项自动跳过" />
                    <Button
                        x:Name="ClearButton"
                        Style="{StaticResource WorkspaceLinkButtonStyle}"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        Click="Clear_Click"
                        AutomationProperties.Name="清空已选项">
                        <TextBlock Text="清空" TextDecorations="Underline" FontSize="12" />
                    </Button>
                    <Button
                        x:Name="CancelButton"
                        Content="取消"
                        Style="{StaticResource WorkspaceToolbarButtonStyle}"
                        MinHeight="32"
                        Padding="14,5"
                        Click="Close_Click" />
                    <Button
                        x:Name="ConfirmButton"
                        Content="导入 0 项"
                        Style="{StaticResource OpActionStyle}"
                        MinHeight="32"
                        Padding="16,5"
                        IsEnabled="False"
                        Click="Confirm_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
