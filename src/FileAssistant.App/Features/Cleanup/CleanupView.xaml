<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FileAssistant.App.Features.Cleanup.CleanupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FileAssistant.App.Features.Cleanup"
    xmlns:controls="using:FileAssistant.App.Controls">
    <UserControl.Resources>
        <DataTemplate x:Key="SoftwareTemplate" x:DataType="local:SoftwareRow">
            <Grid ColumnSpacing="14" Padding="6,6" Background="Transparent" Tag="{x:Bind}" DoubleTapped="SoftwareRow_DoubleTapped">
                <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="96" /></Grid.ColumnDefinitions>
                <Border Width="32" Height="32" CornerRadius="7" Background="{ThemeResource WorkspaceSubtleBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE74C;" FontSize="14" Foreground="{ThemeResource WorkspaceCategoryDocumentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Name}" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Detail}" Style="{StaticResource WorkspaceCaptionStyle}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{x:Bind Size}" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource WorkspaceCaptionStyle}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="FileTemplate" x:DataType="local:CleanupFileRow">
            <Grid ColumnSpacing="12" Padding="2,4" ToolTipService.ToolTip="{x:Bind Path}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="156" /></Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="6" Background="{ThemeResource WorkspaceSubtleBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" Foreground="{ThemeResource WorkspaceCategoryFolderBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Name}" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Directory}" Style="{StaticResource WorkspaceCaptionStyle}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{x:Bind Detail}" Style="{StaticResource WorkspaceCaptionStyle}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Detail}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ResidueTemplate" x:DataType="local:ResidueRow">
            <StackPanel Spacing="4" Padding="6,6">
                <TextBlock Text="{x:Bind Path}" FontSize="13" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource WorkspaceCaptionStyle}" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="LockTemplate" x:DataType="local:CleanupLockRow">
            <StackPanel Spacing="4" Padding="4,6">
                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource WorkspaceCaptionStyle}" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Style="{StaticResource WorkspacePageLayoutStyle}" Background="Transparent">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <Grid x:Name="TaskToolbar" Style="{StaticResource WorkspaceTaskToolbarStyle}" Background="Transparent" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <ToggleButton x:Name="SoftwareTab" Content="软件卸载" IsChecked="True" Style="{StaticResource WorkspaceToolbarModeStyle}" Click="SoftwareTab_Click" />
                <ToggleButton x:Name="FilesTab" Content="文件清理" Style="{StaticResource WorkspaceToolbarModeStyle}" Click="FilesTab_Click" />
            </StackPanel>
            <Grid Grid.Column="1">
                <controls:FilterSearchBox x:Name="Search" Margin="0" VerticalAlignment="Center" PlaceholderText="搜索软件名称或发布者" AutomationProperties.Name="筛选当前列表" MinWidth="180" SeparateFields="True" />
                <Grid x:Name="SoftwareQueryField">
                    <TextBox x:Name="SoftwareQuery" Style="{StaticResource WorkspaceToolbarFieldStyle}" Text="{x:Bind Search.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="搜索软件名称或发布者" Padding="10,5,32,5" VerticalAlignment="Center" AutomationProperties.Name="搜索软件名称或发布者" />
                    <FontIcon Glyph="&#xE721;" FontSize="14" HorizontalAlignment="Right" Margin="0,0,10,0" Foreground="{ThemeResource WorkspaceSecondaryBrush}" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                </Grid>
            </Grid>
            <Button x:Name="SoftwareFilter" Style="{StaticResource WorkspaceToolbarButtonStyle}" Grid.Column="2" Content="筛选" VerticalAlignment="Center" AutomationProperties.Name="按登记大小筛选软件">
                <Button.Flyout>
                    <Flyout>
                        <StackPanel Width="240" Spacing="8">
                            <TextBlock Text="登记大小" Style="{StaticResource WorkspaceSectionStyle}" />
                            <controls:SelectionDropDown ItemsSource="{x:Bind Search.ItemsSource, Mode=OneWay}" SelectedValue="{x:Bind Search.SelectedValue, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="软件登记大小条件" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Grid Grid.Column="3">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <StackPanel x:Name="FileActions" Orientation="Horizontal" Spacing="6" Visibility="Collapsed" HorizontalAlignment="Right">
                        <controls:StagingImportButton x:Name="FromStaging" TargetLabel="清理清单" PickerRequested="FromStaging_Click" QuickImportRequested="FromStaging_QuickImportRequested" />
                        <Button x:Name="RemoveFiles" Style="{StaticResource WorkspaceToolbarButtonStyle}" Content="移出" Click="RemoveFiles_Click" ToolTipService.ToolTip="从列表移出选中项，磁盘文件不变" />
                    </StackPanel>
                    <Button x:Name="Refresh" Style="{StaticResource WorkspaceToolbarButtonStyle}" Content="刷新软件" Click="Refresh_Click" VerticalAlignment="Center" />
                    <controls:AddFilesButton x:Name="AddButtons" FilesRequested="AddFiles_Click" FolderRequested="AddFolder_Click" VerticalAlignment="Center" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Grid>

        <controls:ResizablePane x:Name="DetailsPane" Grid.Row="1" WidthPreferenceKey="Cleanup.Details" MinimumContentWidth="546">
            <controls:ResizablePane.MainContent>
                <Grid x:Name="InputSurface" SizeChanged="InputSurface_SizeChanged">
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="FoldersColumn" Width="189" /><ColumnDefinition x:Name="FoldersGapColumn" Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border x:Name="FolderSidebar" Grid.ColumnSpan="2" Margin="0,0,5,0" Style="{StaticResource WorkspaceSurfaceStyle}" Background="{ThemeResource WorkspacePaneBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="0" CornerRadius="0,0,0,11">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Border Style="{StaticResource WorkspacePaneHeaderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="CategoryTitle" Text="软件分类" Style="{StaticResource WorkspacePaneTitleStyle}" />
                                    <Button Grid.Column="1" Style="{StaticResource WorkspaceIconButtonStyle}" Content="" ContentTemplate="{StaticResource WorkspaceLeftPaneIconTemplate}" Click="CollapseFolders_Click" AutomationProperties.Name="收起分类" ToolTipService.ToolTip="收起分类" />
                                </Grid>
                            </Border>
                            <ScrollViewer Grid.Row="1" Margin="8,8,8,4" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="Categories" Spacing="3">
                                    <ToggleButton x:Name="AllCategory" Tag="0" IsChecked="True" Click="Category_Click" Style="{StaticResource WorkspaceLeftNavItemStyle}">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE80A;" FontSize="14" />
                                            <TextBlock x:Name="AllCategoryLabel" Grid.Column="1" Text="全部软件" TextTrimming="CharacterEllipsis" FontSize="12.5" VerticalAlignment="Center" />
                                            <TextBlock x:Name="AllCategoryCount" Grid.Column="2" Typography.NumeralAlignment="Tabular" Style="{StaticResource WorkspaceCaptionStyle}" VerticalAlignment="Center" />
                                        </Grid>
                                    </ToggleButton>
                                    <ToggleButton x:Name="AvailableCategory" Tag="1" Click="Category_Click" Style="{StaticResource WorkspaceLeftNavItemStyle}">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                            <TextBlock x:Name="AvailableCategoryLabel" Grid.Column="1" Text="可卸载" TextTrimming="CharacterEllipsis" FontSize="12.5" VerticalAlignment="Center" />
                                            <TextBlock x:Name="AvailableCategoryCount" Grid.Column="2" Typography.NumeralAlignment="Tabular" Style="{StaticResource WorkspaceCaptionStyle}" VerticalAlignment="Center" />
                                        </Grid>
                                    </ToggleButton>
                                    <ToggleButton x:Name="ProtectedCategory" Tag="2" Click="Category_Click" Style="{StaticResource WorkspaceLeftNavItemStyle}">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xEA18;" FontSize="14" />
                                            <TextBlock x:Name="ProtectedCategoryLabel" Grid.Column="1" Text="受保护 / 无入口" TextTrimming="CharacterEllipsis" FontSize="12.5" VerticalAlignment="Center" />
                                            <TextBlock x:Name="ProtectedCategoryCount" Grid.Column="2" Typography.NumeralAlignment="Tabular" Style="{StaticResource WorkspaceCaptionStyle}" VerticalAlignment="Center" />
                                        </Grid>
                                    </ToggleButton>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    <Border x:Name="CollapsedFolders" Style="{StaticResource WorkspaceSurfaceStyle}" Background="{ThemeResource WorkspacePaneBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="0" CornerRadius="0,0,0,11" Padding="7" Visibility="Collapsed">
                        <Button Style="{StaticResource WorkspaceIconButtonStyle}" Content="" ContentTemplate="{StaticResource WorkspaceLeftPaneIconTemplate}" VerticalAlignment="Top" Click="ExpandFolders_Click" AutomationProperties.Name="展开分类" ToolTipService.ToolTip="展开分类" />
                    </Border>
                    <controls:ResizeHandle x:Name="FoldersResizeHandle" Grid.Column="1" Canvas.ZIndex="20" ResizeRequested="Folders_ResizeRequested" ResetRequested="Folders_ResetRequested" AutomationProperties.Name="调整分类栏宽度" />

                    <Border x:Name="MainListBorder" Grid.Column="1" Grid.ColumnSpan="2" Margin="5,0,0,0" Style="{StaticResource WorkspaceSurfaceStyle}" Background="Transparent">
                        <Grid RowSpacing="0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

                            <Grid Style="{StaticResource WorkspacePathBarStyle}">
                                <StackPanel x:Name="ListIdentity" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button x:Name="Back" Visibility="Collapsed" Style="{StaticResource WorkspaceIconButtonStyle}" Click="Back_Click" AutomationProperties.Name="返回软件列表" ToolTipService.ToolTip="返回软件列表"><FontIcon Style="{StaticResource WorkspaceParentFolderIconStyle}" /></Button>
                                    <TextBlock x:Name="ListTitle" Text="全部软件" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ListCount" Typography.NumeralAlignment="Tabular" Style="{StaticResource WorkspaceCaptionStyle}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid x:Name="SoftwareArea">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <Border Background="{ThemeResource WorkspaceSubtleBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="0,0,0,1" Padding="18,7">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="96" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="软件 / 发布者与版本" Style="{StaticResource WorkspaceCaptionStyle}" FontSize="11.5" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="登记大小" Style="{StaticResource WorkspaceCaptionStyle}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Border>
                                    <ListView x:Name="SoftwareList" Grid.Row="1" SelectionMode="Single" Margin="4" ItemContainerStyle="{StaticResource WorkspaceListItemStyle}" ItemTemplate="{StaticResource SoftwareTemplate}" SelectionChanged="Software_SelectionChanged" AutomationProperties.Name="已安装软件" />
                                    <TextBlock x:Name="SoftwareEmpty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource WorkspaceCaptionStyle}" />
                                </Grid>

                                <Grid x:Name="FilesArea" Visibility="Collapsed" AllowDrop="True" DragOver="Files_DragOver" Drop="Files_Drop" Background="Transparent">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <Border Background="{ThemeResource WorkspaceSubtleBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="0,0,0,1" Padding="18,7">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="156" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="文件名 / 所在位置" Style="{StaticResource WorkspaceCaptionStyle}" FontSize="11.5" FontWeight="SemiBold" Margin="38,0,0,0" />
                                            <TextBlock Grid.Column="1" Text="处理状态" Style="{StaticResource WorkspaceCaptionStyle}" FontSize="11.5" FontWeight="SemiBold" />
                                        </Grid>
                                    </Border>
                                    <controls:MarqueeSelection Target="{x:Bind FilesList}" SelectionCommitted="Files_MarqueeCommitted" Grid.Row="1">
                                        <ListView x:Name="FilesList" SelectionMode="Extended" IsMultiSelectCheckBoxEnabled="True" Margin="4" ItemContainerStyle="{StaticResource WorkspaceListItemStyle}" ItemTemplate="{StaticResource FileTemplate}" SelectionChanged="FileSelection_Changed" AutomationProperties.Name="待清理目标" />
                                    </controls:MarqueeSelection>
                                    <Border x:Name="FilesEmpty" Grid.Row="1" MaxWidth="420" Padding="32,26" CornerRadius="12" Background="{ThemeResource WorkspaceCardBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <StackPanel Spacing="10" HorizontalAlignment="Center">
                                            <Border Width="42" Height="42" CornerRadius="21" Background="{ThemeResource WorkspaceSubtleBrush}" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE74D;" FontSize="18" Foreground="{ThemeResource WorkspaceAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock x:Name="FilesEmptyTitle" Text="将文件或文件夹拖到这里" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                            <TextBlock x:Name="FilesEmptyHint" Text="也可点击右上角添加文件，或从暂存区导入；清理前会先核对清单与占用。" Style="{StaticResource WorkspaceCaptionStyle}" TextWrapping="Wrap" TextAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid x:Name="ResidueArea" Visibility="Collapsed" RowSpacing="8">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <Border Background="{ThemeResource WorkspaceSubtleBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="0,0,0,1" Padding="16,8">
                                        <TextBlock Text="勾选要清理的残留；个人设置和数据也可能包含在内，请逐项核对。" TextWrapping="Wrap" Style="{StaticResource WorkspaceCaptionStyle}" />
                                    </Border>
                                    <ListView x:Name="ResidueList" Grid.Row="1" SelectionMode="Multiple" Margin="4" ItemContainerStyle="{StaticResource WorkspaceListItemStyle}" ItemTemplate="{StaticResource ResidueTemplate}" SelectionChanged="Residue_SelectionChanged" AutomationProperties.Name="候选残留，勾选后清理" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </controls:ResizablePane.MainContent>

            <controls:ResizablePane.PaneContent>
                <Border Style="{StaticResource WorkspaceSurfaceStyle}" Background="{ThemeResource WorkspacePaneBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="0" CornerRadius="0,0,11,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Style="{StaticResource WorkspacePaneHeaderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="OptionsTitle" Text="处理选项" Style="{StaticResource WorkspacePaneTitleStyle}" />
                                <Button Grid.Column="1" Style="{StaticResource WorkspaceIconButtonStyle}" Content="" ContentTemplate="{StaticResource WorkspaceRightPaneIconTemplate}" Click="Collapse_Click" AutomationProperties.Name="收起处理选项" ToolTipService.ToolTip="收起处理选项" />
                            </Grid>
                        </Border>
                        <controls:OperationPanel x:Name="OptionsPanel" Grid.Row="1">
                            <controls:OperationPanel.Body>
                                <StackPanel Spacing="12">
                                    <Grid x:Name="RadarScanBanner" Visibility="Collapsed" ColumnSpacing="10" Padding="10,8" CornerRadius="8" Background="{ThemeResource WorkspaceSubtleBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid Width="24" Height="24" VerticalAlignment="Center">
                                            <Border x:Name="RadarOuterRing" Width="22" Height="22" CornerRadius="11" BorderBrush="{ThemeResource WorkspaceAccentBrush}" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform><ScaleTransform x:Name="RadarOuterScale" ScaleX="0.6" ScaleY="0.6" /></Border.RenderTransform>
                                            </Border>
                                            <Border Width="8" Height="8" CornerRadius="4" Background="{ThemeResource WorkspaceAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock x:Name="Status" TextWrapping="Wrap" Style="{StaticResource WorkspaceCaptionStyle}" AutomationProperties.LiveSetting="Polite" />
                                            <ProgressBar x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed" AutomationProperties.Name="清理操作进度" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="IdleStatusText" TextWrapping="Wrap" Style="{StaticResource WorkspaceCaptionStyle}" AutomationProperties.LiveSetting="Polite" />
                                    <Border x:Name="FreedBytesCard" Style="{StaticResource WorkspaceBentoCardStyle}" Visibility="Collapsed">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="目标预计涉及容量" Style="{StaticResource WorkspaceCaptionStyle}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="FreedBytesValue" Grid.Column="1" FontSize="15" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource WorkspaceSuccessBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <Button x:Name="Details" Content="查看处理详情" FontSize="12" Padding="9,4" Click="Details_Click" HorizontalAlignment="Left" Visibility="Collapsed" />

                                    <StackPanel x:Name="SoftwareOptions" Spacing="10">
                                        <Border Style="{StaticResource WorkspaceBentoCardStyle}">
                                            <StackPanel Spacing="8">
                                                <TextBlock x:Name="SoftwareName" Text="选择一个软件" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock x:Name="SoftwareDetails" Text="卸载后可继续检查文件和注册表残留。" Style="{StaticResource WorkspaceCaptionStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                <Button x:Name="ScanResidue" Content="检查残留项" Click="ScanResidue_Click" HorizontalAlignment="Stretch" />
                                                <TextBlock x:Name="ResidueHint" Text="完成软件卸载登记移除后即可检查残留" Style="{StaticResource WorkspaceCaptionStyle}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource WorkspaceBentoCardStyle}">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="安全卸载三步闭环" Style="{StaticResource WorkspaceSectionLabelStyle}" />
                                                <TextBlock Text="1. 双击支持后台卸载的软件并确认&#10;2. 深度扫描关联目录与注册表候选残留&#10;3. 核对所选残留、删除方式和注册表备份设置" Style="{StaticResource WorkspaceCaptionStyle}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <Border x:Name="LocksPanel" Style="{StaticResource WorkspaceBentoCardStyle}" BorderBrush="{ThemeResource WorkspaceAccentBrush}" Visibility="Collapsed">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="检测到占用程序" FontWeight="SemiBold" />
                                            <ListView x:Name="LocksList" MaxHeight="240" SelectionMode="Multiple" ItemTemplate="{StaticResource LockTemplate}" SelectionChanged="Locks_SelectionChanged" AutomationProperties.Name="占用程序" />
                                            <Button x:Name="CloseLocks" Content="关闭选中程序后重试…" Click="CloseLocks_Click" HorizontalAlignment="Stretch" />
                                            <Button x:Name="TerminateLocks" Content="结束选中进程…" Click="TerminateLocks_Click" HorizontalAlignment="Stretch" />
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="CleanupOptions" Style="{StaticResource WorkspaceBentoCardStyle}">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="文件处理方式" Style="{StaticResource WorkspaceSectionLabelStyle}" />
                                            <controls:SelectionDropDown x:Name="Method" HorizontalAlignment="Stretch" SelectionCommitted="Options_Changed" AutomationProperties.Name="文件处理方式" />
                                            <TextBlock x:Name="MethodNote" Text="移入回收站，支持时可通过系统恢复。" Style="{StaticResource WorkspaceCaptionStyle}" TextWrapping="Wrap" />
                                            <Button Content="权限与高级设置" FontSize="12" Padding="9,4" HorizontalAlignment="Left">
                                                <Button.Flyout>
                                                    <Flyout Placement="Left">
                                                        <StackPanel Width="248" Spacing="8">
                                                            <CheckBox x:Name="Administrator" Content="以管理员权限处理" Checked="Options_Checked" Unchecked="Options_Checked" />
                                                            <TextBlock Text="权限不足时再启用。无法解除的占用会明确报告。" Style="{StaticResource WorkspaceCaptionStyle}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </controls:OperationPanel.Body>
                            <controls:OperationPanel.Footer>
                                <Border Style="{StaticResource OpFooterStyle}">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            x:Name="ActionNote"
                                            Text="先选择软件。"
                                            Style="{StaticResource OpLabelStyle}"
                                            VerticalAlignment="Center"
                                            MaxLines="2"
                                            TextWrapping="Wrap"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind ActionNote.Text, Mode=OneWay}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button x:Name="Execute" Content="卸载所选软件…" Style="{StaticResource OpActionStyle}" Click="Execute_Click" />
                                            <Button x:Name="Cancel" Content="停止" Click="Cancel_Click" Visibility="Collapsed" Style="{StaticResource OpActionStyle}" />
                                            <Button x:Name="ContinueSettings" Content="继续设置" Click="ContinueSettings_Click" Visibility="Collapsed" Style="{StaticResource OpActionStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </controls:OperationPanel.Footer>
                        </controls:OperationPanel>
                    </Grid>
                </Border>
            </controls:ResizablePane.PaneContent>
            <controls:ResizablePane.CollapsedPaneContent>
                <Border Style="{StaticResource WorkspaceSurfaceStyle}" Background="{ThemeResource WorkspacePaneBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="0" CornerRadius="0,0,11,0" Padding="7">
                    <Button Style="{StaticResource WorkspaceIconButtonStyle}" Content="" ContentTemplate="{StaticResource WorkspaceRightPaneIconTemplate}" VerticalAlignment="Top" Click="Expand_Click" AutomationProperties.Name="展开处理选项" ToolTipService.ToolTip="展开处理选项" />
                </Border>
            </controls:ResizablePane.CollapsedPaneContent>
        </controls:ResizablePane>
    </Grid>
</UserControl>
