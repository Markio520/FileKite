<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="FileAssistant.App.Features.Settings.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Style="{StaticResource DefaultContentDialogStyle}" Background="{ThemeResource WorkspaceDialogBrush}"
    Foreground="{ThemeResource WorkspaceTextBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" CornerRadius="12">
    <ContentDialog.Resources>
        <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key="Light">
                <StaticResource x:Key="ExpanderHeaderBackground" ResourceKey="WorkspaceCardBrush" />
                <StaticResource x:Key="ExpanderHeaderBackgroundPointerOver" ResourceKey="WorkspaceSubtleBrush" />
                <StaticResource x:Key="ExpanderHeaderBorderBrush" ResourceKey="WorkspaceBorderBrush" />
                <SolidColorBrush x:Key="ExpanderChevronBackground" Color="Transparent" />
                <SolidColorBrush x:Key="ExpanderChevronBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="ExpanderChevronBackgroundPressed" Color="Transparent" />
                <SolidColorBrush x:Key="ExpanderChevronBorderBrush" Color="Transparent" />
                <StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="WorkspaceAccentBrush" />
                <StaticResource x:Key="ToggleSwitchStrokeOn" ResourceKey="WorkspaceAccentBrush" />
                <StaticResource x:Key="ToggleSwitchKnobFillOn" ResourceKey="WorkspaceOnAccentBrush" />
                <StaticResource x:Key="ToggleSwitchKnobFillOnPointerOver" ResourceKey="WorkspaceOnAccentBrush" />
                <StaticResource x:Key="ToggleSwitchKnobFillOnPressed" ResourceKey="WorkspaceOnAccentBrush" />
            </ResourceDictionary>
            <ResourceDictionary x:Key="Dark">
                <StaticResource x:Key="ExpanderHeaderBackground" ResourceKey="WorkspaceCardBrush" />
                <StaticResource x:Key="ExpanderHeaderBackgroundPointerOver" ResourceKey="WorkspaceSubtleBrush" />
                <StaticResource x:Key="ExpanderHeaderBorderBrush" ResourceKey="WorkspaceBorderBrush" />
                <SolidColorBrush x:Key="ExpanderChevronBackground" Color="Transparent" />
                <SolidColorBrush x:Key="ExpanderChevronBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="ExpanderChevronBackgroundPressed" Color="Transparent" />
                <SolidColorBrush x:Key="ExpanderChevronBorderBrush" Color="Transparent" />
                <StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="WorkspaceAccentBrush" />
                <StaticResource x:Key="ToggleSwitchStrokeOn" ResourceKey="WorkspaceAccentBrush" />
                <StaticResource x:Key="ToggleSwitchKnobFillOn" ResourceKey="WorkspaceOnAccentBrush" />
                <StaticResource x:Key="ToggleSwitchKnobFillOnPointerOver" ResourceKey="WorkspaceOnAccentBrush" />
                <StaticResource x:Key="ToggleSwitchKnobFillOnPressed" ResourceKey="WorkspaceOnAccentBrush" />
            </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
        <Thickness x:Key="ExpanderContentPadding">16,14,16,14</Thickness>
        <x:Double x:Key="ContentDialogMaxWidth">960</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">720</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
        <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
        <Thickness x:Key="ContentDialogTitleMargin">0</Thickness>
        <Thickness x:Key="ContentDialogSeparatorThickness">0</Thickness>
        <Style x:Key="SettingCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource WorkspaceCardBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource WorkspaceBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="15,9" />
        </Style>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource WorkspaceTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SettingCaption" TargetType="TextBlock" BasedOn="{StaticResource SettingLabel}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource WorkspaceSecondaryBrush}" />
        </Style>
        <Style x:Key="SettingHeading" TargetType="TextBlock" BasedOn="{StaticResource SettingLabel}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SettingWarning" TargetType="TextBlock" BasedOn="{StaticResource SettingCaption}">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
        </Style>
        <Style x:Key="SettingSuccess" TargetType="TextBlock" BasedOn="{StaticResource SettingCaption}">
            <Setter Property="Foreground" Value="{ThemeResource WorkspaceSuccessBrush}" />
        </Style>
        <Style x:Key="SettingRule" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource WorkspaceBorderBrush}" />
        </Style>
        <Style x:Key="SettingWireAccent" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource WorkspaceAccentBrush}" />
        </Style>
        <Style x:Key="SettingInset" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource WorkspaceSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource WorkspaceBorderBrush}" />
        </Style>
        <Style x:Key="SettingStatusPillOk" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource WorkspaceDiffAddedBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource WorkspaceSuccessBrush}" />
        </Style>
        <Style x:Key="SettingStatusDotOk" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource WorkspaceSuccessBrush}" />
        </Style>
        <Style x:Key="SettingStatusDotMuted" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource WorkspaceSecondaryBrush}" />
        </Style>
        <Style x:Key="SettingBuiltinBadge" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{ThemeResource WorkspaceBorderBrush}" />
        </Style>
        <Style x:Key="SettingEngineIconGlyph" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource WorkspaceTextBrush}" />
        </Style>
        <Style x:Key="SettingKeycap" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource WorkspaceControlBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource WorkspaceBorderBrush}" />
        </Style>
        <Style x:Key="SettingWireContent" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource WorkspaceCardBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource WorkspaceBorderBrush}" />
        </Style>
        <Style x:Key="SettingButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Foreground" Value="{ThemeResource WorkspaceTextBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="31" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style x:Key="SettingDangerButton" TargetType="Button" BasedOn="{StaticResource SettingButton}">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        </Style>
        <Style x:Key="SettingPrimaryButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="Foreground" Value="{ThemeResource WorkspaceOnAccentBrush}" />
            <Setter Property="Background" Value="{ThemeResource WorkspaceAccentBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource WorkspaceAccentBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="31" />
            <Setter Property="Padding" Value="13,4" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style x:Key="SettingHeaderAction" TargetType="Button" BasedOn="{StaticResource SettingButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{ThemeResource WorkspaceSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="8,3" />
        </Style>
        <Style x:Key="SettingBareButton" TargetType="Button" BasedOn="{StaticResource SettingButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="SettingFieldStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{ThemeResource WorkspaceFieldBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource WorkspaceBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="SettingDropDownStyle" TargetType="DropDownButton" BasedOn="{StaticResource WorkspaceToolbarSelectorStyle}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="{ThemeResource WorkspaceControlBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource WorkspaceBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="SettingExpander" TargetType="Expander">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="16,18,16,14" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style x:Key="SettingSegment" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{ThemeResource WorkspaceSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="12,3" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualMargin" Value="-2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Surface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Surface.Background" Value="{ThemeResource WorkspaceHoverBrush}" /><Setter Target="Presenter.Foreground" Value="{ThemeResource WorkspaceTextBrush}" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Surface.Background" Value="{ThemeResource WorkspaceControlHoverBrush}" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="Checked"><VisualState.Setters><Setter Target="Surface.Background" Value="{ThemeResource WorkspaceControlBrush}" /><Setter Target="Surface.BorderBrush" Value="{ThemeResource WorkspaceBorderBrush}" /><Setter Target="Presenter.Foreground" Value="{ThemeResource WorkspaceTextBrush}" /><Setter Target="Presenter.FontWeight" Value="SemiBold" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="CheckedPointerOver"><VisualState.Setters><Setter Target="Surface.Background" Value="{ThemeResource WorkspaceControlBrush}" /><Setter Target="Surface.BorderBrush" Value="{ThemeResource WorkspaceBorderBrush}" /><Setter Target="Presenter.Foreground" Value="{ThemeResource WorkspaceTextBrush}" /><Setter Target="Presenter.FontWeight" Value="SemiBold" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="CheckedPressed"><VisualState.Setters><Setter Target="Surface.Background" Value="{ThemeResource WorkspaceControlHoverBrush}" /><Setter Target="Surface.BorderBrush" Value="{ThemeResource WorkspaceBorderBrush}" /><Setter Target="Presenter.Foreground" Value="{ThemeResource WorkspaceTextBrush}" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Presenter.Opacity" Value="0.5" /></VisualState.Setters></VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="Presenter" Content="{TemplateBinding Content}" FontSize="{TemplateBinding FontSize}"
                                              Foreground="{TemplateBinding Foreground}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingNavigationItem" TargetType="ToggleButton">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="35" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource WorkspaceSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="NavRoot.Background" Value="{ThemeResource WorkspaceSubtleBrush}" /><Setter Target="Presenter.Foreground" Value="{ThemeResource WorkspaceTextBrush}" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="NavRoot.Background" Value="{ThemeResource WorkspaceHoverBrush}" /><Setter Target="Presenter.Foreground" Value="{ThemeResource WorkspaceTextBrush}" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="Checked"><VisualState.Setters><Setter Target="NavRoot.Background" Value="{ThemeResource WorkspaceNavigationSelectedBrush}" /><Setter Target="Presenter.Foreground" Value="{ThemeResource WorkspaceNavigationTextBrush}" /><Setter Target="Presenter.FontWeight" Value="SemiBold" /><Setter Target="ActivePill.Opacity" Value="1" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="CheckedPointerOver"><VisualState.Setters><Setter Target="NavRoot.Background" Value="{ThemeResource WorkspaceHoverBrush}" /><Setter Target="Presenter.Foreground" Value="{ThemeResource WorkspaceNavigationTextBrush}" /><Setter Target="Presenter.FontWeight" Value="SemiBold" /><Setter Target="ActivePill.Opacity" Value="1" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="CheckedPressed"><VisualState.Setters><Setter Target="NavRoot.Background" Value="{ThemeResource WorkspaceHoverBrush}" /><Setter Target="Presenter.Foreground" Value="{ThemeResource WorkspaceNavigationTextBrush}" /><Setter Target="Presenter.FontWeight" Value="SemiBold" /><Setter Target="ActivePill.Opacity" Value="1" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="NavRoot.Opacity" Value="0.45" /></VisualState.Setters></VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Unfocused" />
                                    <VisualState x:Name="Focused" />
                                    <VisualState x:Name="PointerFocused" />
                                    <VisualState x:Name="KeyboardFocused"><VisualState.Setters><Setter Target="FocusRing.Opacity" Value="1" /></VisualState.Setters></VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="NavRoot" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="Presenter" Content="{TemplateBinding Content}" FontSize="{TemplateBinding FontSize}"
                                                  Foreground="{TemplateBinding Foreground}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="ActivePill" Width="3" Height="16" CornerRadius="1.5" Background="{ThemeResource WorkspaceAccentBrush}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="FocusRing" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1.5"
                                    CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingNavigationCard" TargetType="ToggleButton">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{ThemeResource WorkspaceCardBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource WorkspaceAccentBrush}" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualMargin" Value="-2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Body.Background" Value="{ThemeResource WorkspaceControlHoverBrush}" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Body.Background" Value="{ThemeResource WorkspaceControlBrush}" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="Checked"><VisualState.Setters><Setter Target="Outline.Opacity" Value="1" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="CheckedPointerOver"><VisualState.Setters><Setter Target="Outline.Opacity" Value="1" /><Setter Target="Body.Background" Value="{ThemeResource WorkspaceControlHoverBrush}" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="CheckedPressed"><VisualState.Setters><Setter Target="Outline.Opacity" Value="1" /><Setter Target="Body.Background" Value="{ThemeResource WorkspaceControlBrush}" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Body.Opacity" Value="0.5" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="CheckedDisabled"><VisualState.Setters><Setter Target="Outline.Opacity" Value="0.5" /><Setter Target="Body.Opacity" Value="0.5" /></VisualState.Setters></VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{ThemeResource WorkspaceBorderBrush}"
                                    BorderThickness="1" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter Content="{TemplateBinding Content}" Foreground="{ThemeResource WorkspaceTextBrush}" FontSize="{TemplateBinding FontSize}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="Outline" BorderBrush="{TemplateBinding Foreground}" BorderThickness="1.5" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingVolume" TargetType="ToggleButton" BasedOn="{StaticResource SettingNavigationCard}">
            <Setter Property="Background" Value="{ThemeResource WorkspaceControlBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource WorkspaceSuccessBrush}" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style x:Key="SettingIconCheck" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="SettingIconCheckGlyph" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="SettingSwatch" TargetType="ToggleButton">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualMargin" Value="-1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="SwatchBody" Padding="1" CornerRadius="6" Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="SwatchBody.Background" Value="{ThemeResource WorkspaceSubtleBrush}" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="SwatchBody.Opacity" Value="0.8" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="Checked" /><VisualState x:Name="CheckedPointerOver" />
                                    <VisualState x:Name="CheckedPressed"><VisualState.Setters><Setter Target="SwatchBody.Opacity" Value="0.8" /></VisualState.Setters></VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Stretch" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </ContentDialog.Resources>

    <Grid x:Name="DialogLayout" Width="920" Height="604" Background="{ThemeResource WorkspaceDialogBrush}" CornerRadius="11" PreviewKeyDown="Dialog_PreviewKeyDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="208" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border x:Name="Rail" Background="{ThemeResource WorkspacePaneBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}"
                BorderThickness="0,0,1,0" CornerRadius="11,0,0,11" Padding="12,20,12,14">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="*" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="RailTitle" Margin="8,0" FontWeight="Bold" FontSize="18" AutomationProperties.HeadingLevel="Level1" />
                <Grid x:Name="SearchHost" Grid.Row="1">
                    <TextBox x:Name="SettingsSearch" MinHeight="32" FontSize="12.5" Padding="29,4,6,4"
                             Background="{ThemeResource WorkspaceFieldBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}"
                             TextChanged="SettingsSearch_Changed" AutomationProperties.AutomationId="Settings.Search" />
                    <FontIcon Glyph="&#xE721;" Margin="10,0,0,0" HorizontalAlignment="Left" FontSize="13"
                              Foreground="{ThemeResource WorkspaceSecondaryBrush}" IsHitTestVisible="False" />
                </Grid>
                <Button x:Name="CompactFind" Grid.Row="1" Visibility="Collapsed" Click="CompactFind_Click"
                        Style="{StaticResource WorkspaceIconButtonStyle}" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE721;" FontSize="15" />
                </Button>
                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="NavigationList" Spacing="2" Margin="0,2,0,0" />
                </ScrollViewer>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="8,0">
                    <Image x:Name="RailBrandIcon" Width="17" Height="17" />
                    <TextBlock x:Name="BrandText" Style="{StaticResource SettingCaption}" FontSize="11.5" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid x:Name="DetailPane" Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <StackPanel x:Name="HeadingArea" Margin="36,24,36,17" Spacing="5">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="PageTitle" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"
                               VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2" />
                    <StackPanel x:Name="HeaderActions" Grid.Column="1" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                        <TextBlock x:Name="SaveBadge" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource WorkspaceSuccessBrush}"
                                   Visibility="Collapsed" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                        <Button x:Name="CloseSettings" Click="Close_Click" Width="30" Height="30" MinWidth="0" MinHeight="0"
                                Style="{StaticResource WorkspaceIconButtonStyle}" AutomationProperties.AutomationId="Settings.Close">
                            <FontIcon Glyph="&#xE711;" FontSize="13" />
                        </Button>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="PageDescription" Style="{StaticResource SettingCaption}" FontSize="12.5" />
                <TextBox x:Name="CompactSearch" Visibility="Collapsed" FontSize="12.5" MinHeight="32" Margin="0,4,0,2"
                         Background="{ThemeResource WorkspaceFieldBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}"
                         TextChanged="SettingsSearch_Changed" AutomationProperties.AutomationId="Settings.CompactSearch" />
                <InfoBar x:Name="MessageBar" IsOpen="False" IsClosable="True" IsIconVisible="True" Margin="0,3,0,0"
                         AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <ScrollViewer x:Name="PageScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
                <Grid x:Name="BodyInset" Padding="36,1,36,32">
                    <StackPanel x:Name="SectionsHost" Spacing="20" />
                    <TextBlock x:Name="NoResults" Visibility="Collapsed" Style="{StaticResource SettingCaption}"
                               HorizontalAlignment="Center" Margin="12,28" TextAlignment="Center" />
                </Grid>
            </ScrollViewer>
        </Grid>
        <Grid x:Name="ConfirmationLayer" Grid.ColumnSpan="2" Background="{ThemeResource SmokeFillColorDefaultBrush}"
              Visibility="Collapsed" Padding="16" CornerRadius="11" XYFocusKeyboardNavigation="Enabled">
            <Border Background="{ThemeResource WorkspaceDialogBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="20" MaxWidth="390"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="13">
                    <TextBlock x:Name="ConfirmTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level3" />
                    <TextBlock x:Name="ConfirmDetails" Style="{StaticResource SettingCaption}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button x:Name="ConfirmCancel" Click="ConfirmCancel_Click" HorizontalAlignment="Stretch" />
                        <Button x:Name="ConfirmAccept" Grid.Column="1" Click="ConfirmAccept_Click" HorizontalAlignment="Stretch"
                                Style="{StaticResource AccentButtonStyle}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ContentDialog>
