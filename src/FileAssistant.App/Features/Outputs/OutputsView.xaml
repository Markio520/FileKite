<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FileAssistant.App.Features.Outputs.OutputsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FileAssistant.App.Features.Outputs"
    xmlns:workspace="using:FileAssistant.App.Features.Workspace"
    xmlns:controls="using:FileAssistant.App.Controls">
    <Grid Style="{StaticResource WorkspacePageLayoutStyle}" Background="Transparent">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <Grid Style="{StaticResource WorkspaceTaskToolbarStyle}" Background="Transparent" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid>
                <TextBox x:Name="Query" Style="{StaticResource WorkspaceToolbarFieldStyle}" controls:WorkspaceLocalization.Placeholder="搜索输出产物名称或路径" TextChanged="Query_TextChanged" Padding="10,5,32,5" VerticalAlignment="Center" controls:WorkspaceLocalization.Name="搜索输出文件" />
                <FontIcon Glyph="&#xE721;" FontSize="14" HorizontalAlignment="Right" Margin="0,0,10,0" Foreground="{ThemeResource WorkspaceSecondaryBrush}" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Style="{StaticResource WorkspaceToolbarButtonStyle}" controls:WorkspaceLocalization.Content="打开" Command="{x:Bind ViewModel.OpenCommand}" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" />
                <controls:ActionDropDown Style="{StaticResource WorkspaceToolbarMenuStyle}" controls:WorkspaceLocalization.Content="接力处理" IsEnabled="{x:Bind ViewModel.HasFiles, Mode=OneWay}">
                    <controls:ActionDropDown.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem controls:WorkspaceLocalization.Text="所选产物 → 批量改名" Click="Rename_Click" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" />
                            <MenuFlyoutItem controls:WorkspaceLocalization.Text="所选产物 → 格式转换" Click="Convert_Click" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" />
                            <MenuFlyoutItem controls:WorkspaceLocalization.Text="所选产物 → 复制整理" Click="Copy_Click" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" />
                            <MenuFlyoutItem controls:WorkspaceLocalization.Text="所选产物 → 加入暂存区" Click="AddToStaging_Click" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem controls:WorkspaceLocalization.Text="当前列表全部 → 批量改名" Click="RenameAll_Click" />
                            <MenuFlyoutItem controls:WorkspaceLocalization.Text="当前列表全部 → 格式转换" Click="ConvertAll_Click" />
                            <MenuFlyoutItem controls:WorkspaceLocalization.Text="当前列表全部 → 复制整理" Click="CopyAll_Click" />
                        </MenuFlyout>
                    </controls:ActionDropDown.Flyout>
                </controls:ActionDropDown>
                <Button Style="{StaticResource WorkspaceToolbarButtonStyle}" controls:WorkspaceLocalization.Content="清空记录" Command="{x:Bind ViewModel.ClearRecordsCommand}" IsEnabled="{x:Bind ViewModel.HasFiles, Mode=OneWay}" controls:WorkspaceLocalization.Tip="仅清空软件内记录，磁盘生成文件完整保留。" />
            </StackPanel>
        </Grid>

        <controls:ResizablePane x:Name="SourcesHost" Grid.Row="1" IsPaneOnLeft="True" DefaultPaneWidth="194" MinimumPaneWidth="160" MinimumContentWidth="600" CollapseBelowWidth="1050" WidthPreferenceKey="Outputs.Sources">
            <controls:ResizablePane.MainContent>
                <controls:ResizablePane x:Name="DetailsHost" WidthPreferenceKey="Outputs.Details">
                    <controls:ResizablePane.MainContent>
                        <Border Style="{StaticResource WorkspaceSurfaceStyle}" Background="Transparent">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Style="{StaticResource WorkspaceFileListHeaderStyle}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /><ColumnDefinition Width="84" /></Grid.ColumnDefinitions>
                                        <TextBlock controls:WorkspaceLocalization.Text="生成产物 / 所在目录" Style="{StaticResource WorkspaceCaptionStyle}" FontSize="11.5" FontWeight="SemiBold" Margin="42,0,0,0" />
                                        <TextBlock Grid.Column="1" controls:WorkspaceLocalization.Text="来源任务批次" Style="{StaticResource WorkspaceCaptionStyle}" FontSize="11.5" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" controls:WorkspaceLocalization.Text="大小" Style="{StaticResource WorkspaceCaptionStyle}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="1">
                                    <controls:MarqueeSelection Target="{x:Bind Files}" SelectionCommitted="Files_MarqueeCommitted">
                                        <ListView x:Name="Files" ItemsSource="{x:Bind ViewModel.VisibleFiles}" SelectionMode="Extended" IsMultiSelectCheckBoxEnabled="True" SelectionChanged="Files_SelectionChanged" DoubleTapped="Files_DoubleTapped" ItemContainerStyle="{StaticResource WorkspaceListItemStyle}" Margin="4" Padding="0,0,0,58" controls:WorkspaceLocalization.Name="实际输出文件列表">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="local:OutputEntry">
                                                    <Grid ColumnSpacing="12" ToolTipService.ToolTip="{x:Bind FullPath}">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /><ColumnDefinition Width="84" /></Grid.ColumnDefinitions>
                                                        <Grid ColumnSpacing="10">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                            <Border Width="30" Height="30" CornerRadius="6" Background="{ThemeResource WorkspaceSubtleBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" Foreground="{x:Bind IconTone, Converter={StaticResource CategoryBrush}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                                                <Border Background="{ThemeResource WorkspaceSubtleBrush}" CornerRadius="4" Padding="6,1" HorizontalAlignment="Left">
                                                                    <TextBlock Text="{x:Bind LocationBadge}" MaxWidth="240" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                                                                </Border>
                                                            </StackPanel>
                                                        </Grid>
                                                        <Border Grid.Column="1" Background="{ThemeResource WorkspaceSubtleBrush}" CornerRadius="5" Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind TaskName}" TextTrimming="CharacterEllipsis" FontSize="11.5" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                                                        </Border>
                                                        <TextBlock Grid.Column="2" Text="{x:Bind SizeLabel, Mode=OneWay}" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource WorkspaceCaptionStyle}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </controls:MarqueeSelection>

                                    <Border MaxWidth="420" Padding="32,26" CornerRadius="12" Background="{ThemeResource WorkspaceCardBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel Spacing="10" HorizontalAlignment="Center">
                                            <Border Width="42" Height="42" CornerRadius="21" Background="{ThemeResource WorkspaceSubtleBrush}" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE8A5;" FontSize="18" Foreground="{ThemeResource WorkspaceSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock controls:WorkspaceLocalization.Text="暂无输出产物记录" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                            <TextBlock controls:WorkspaceLocalization.Text="完成转换、改名或复制后，生成的文件会按任务批次归集在此，可一键接力流转到下一工序。" Style="{StaticResource WorkspaceCaptionStyle}" TextWrapping="Wrap" TextAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Floating Multi-Select Action Island for Outputs -->
                                    <ContentControl x:Name="OutputsFloatingIsland" Style="{StaticResource WorkspaceFloatingIslandStyle}" Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12,0,12,12" controls:MarqueeSelection.IsExcluded="True">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock controls:WorkspaceLocalization.Text="{x:Bind ViewModel.IslandSummary, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource WorkspaceIslandTextBrush}" VerticalAlignment="Center" />
                                            <Border Width="1" Height="14" Background="{ThemeResource WorkspaceIslandBorderBrush}" Margin="4,0" VerticalAlignment="Center" />
                                            <Button controls:WorkspaceLocalization.Content="加入暂存" Style="{StaticResource WorkspaceIslandActionStyle}" Click="AddToStaging_Click" />
                                            <Button controls:WorkspaceLocalization.Content="批量改名" Style="{StaticResource WorkspaceIslandActionStyle}" Click="Rename_Click" />
                                            <Button controls:WorkspaceLocalization.Content="转格式" Style="{StaticResource WorkspaceIslandActionStyle}" Click="Convert_Click" />
                                            <Button controls:WorkspaceLocalization.Content="复制整理" Style="{StaticResource WorkspaceIslandActionStyle}" Click="Copy_Click" />
                                            <Button controls:WorkspaceLocalization.Content="复制路径" Style="{StaticResource WorkspaceIslandActionStyle}" Command="{x:Bind ViewModel.CopyPathCommand}" />
                                            <Button Content="✕" Style="{StaticResource WorkspaceIslandActionStyle}" Padding="8,3" Click="ClearSelection_Click" controls:WorkspaceLocalization.Name="取消勾选" controls:WorkspaceLocalization.Tip="取消勾选" />
                                        </StackPanel>
                                    </ContentControl>
                                </Grid>

                                <Border Grid.Row="2" Style="{StaticResource WorkspaceFileListFooterStyle}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Typography.NumeralAlignment="Tabular" Style="{StaticResource WorkspaceCaptionStyle}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Feedback, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource WorkspaceAccentBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </controls:ResizablePane.MainContent>

                    <controls:ResizablePane.PaneContent>
                        <Border Style="{StaticResource WorkspaceSurfaceStyle}" Background="{ThemeResource WorkspacePaneBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="0" CornerRadius="0,0,11,0">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Border Style="{StaticResource WorkspacePaneHeaderStyle}">
                                    <Grid>
                                        <TextBlock controls:WorkspaceLocalization.Text="产物详情" Style="{StaticResource WorkspacePaneTitleStyle}" />
                                        <Button HorizontalAlignment="Right" Style="{StaticResource WorkspaceIconButtonStyle}" Content="" ContentTemplate="{StaticResource WorkspaceRightPaneIconTemplate}" Click="ToggleDetails_Click" controls:WorkspaceLocalization.Name="收起文件信息" controls:WorkspaceLocalization.Tip="收起文件信息" />
                                    </Grid>
                                </Border>
                                <workspace:FileInspector Grid.Row="1" x:Name="Inspector" ViewModel="{x:Bind ViewModel.Inspector}" />
                                <Border Grid.Row="2" Style="{StaticResource OpFooterStyle}">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            controls:WorkspaceLocalization.Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}"
                                            Style="{StaticResource OpLabelStyle}"
                                            VerticalAlignment="Center"
                                            MaxLines="1"
                                            TextTrimming="CharacterEllipsis"
                                            controls:WorkspaceLocalization.Tip="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}" />
                                        <Button
                                            Grid.Column="1"
                                            controls:WorkspaceLocalization.Content="打开所在文件夹"
                                            Command="{x:Bind ViewModel.RevealCommand}"
                                            IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                                            Style="{StaticResource OpActionStyle}" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </controls:ResizablePane.PaneContent>
                    <controls:ResizablePane.CollapsedPaneContent>
                        <Border Style="{StaticResource WorkspaceSurfaceStyle}" Background="{ThemeResource WorkspacePaneBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="0" CornerRadius="0,0,11,0" Padding="6,5">
                            <Button HorizontalAlignment="Center" VerticalAlignment="Top" Style="{StaticResource WorkspaceIconButtonStyle}" Content="" ContentTemplate="{StaticResource WorkspaceRightPaneIconTemplate}" Click="ToggleDetails_Click" controls:WorkspaceLocalization.Name="展开文件信息" controls:WorkspaceLocalization.Tip="展开文件信息" />
                        </Border>
                    </controls:ResizablePane.CollapsedPaneContent>
                </controls:ResizablePane>
            </controls:ResizablePane.MainContent>

            <controls:ResizablePane.PaneContent>
                <Grid Background="{ThemeResource WorkspacePaneBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="0" CornerRadius="0,0,0,11">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Style="{StaticResource WorkspacePaneHeaderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock controls:WorkspaceLocalization.Text="来源任务批次" Style="{StaticResource WorkspacePaneTitleStyle}" />
                            <Button Grid.Column="1" Style="{StaticResource WorkspaceIconButtonStyle}" Content="" ContentTemplate="{StaticResource WorkspaceLeftPaneIconTemplate}" Click="ToggleSources_Click" controls:WorkspaceLocalization.Name="收起左侧栏" controls:WorkspaceLocalization.Tip="收起左侧栏" />
                        </Grid>
                    </Border>
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Tasks}" SelectedValuePath="Value" SelectedValue="{x:Bind ViewModel.TaskId, Mode=OneWay}" SelectionChanged="SourceTask_SelectionChanged" SelectionMode="Single" Padding="8,8" ItemContainerStyle="{StaticResource WorkspaceListItemStyle}" HorizontalContentAlignment="Stretch" controls:WorkspaceLocalization.Name="输出来源任务">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="controls:SelectionOption">
                                <TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Label}" FontSize="13" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </controls:ResizablePane.PaneContent>
            <controls:ResizablePane.CollapsedPaneContent>
                <Border Background="{ThemeResource WorkspacePaneBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="0" CornerRadius="0,0,0,11" Padding="6,7">
                    <Button Style="{StaticResource WorkspaceIconButtonStyle}" VerticalAlignment="Top" Content="" ContentTemplate="{StaticResource WorkspaceLeftPaneIconTemplate}" Click="ToggleSources_Click" controls:WorkspaceLocalization.Name="展开左侧栏" controls:WorkspaceLocalization.Tip="展开左侧栏" />
                </Border>
            </controls:ResizablePane.CollapsedPaneContent>
        </controls:ResizablePane>
    </Grid>
</UserControl>
