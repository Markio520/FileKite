<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FileAssistant.App.Features.Search.SearchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FileAssistant.App.Features.Search"
    xmlns:controls="using:FileAssistant.App.Controls"
    xmlns:preview="using:FileAssistant.App.Features.Preview">
    <UserControl.Resources>
        <Style x:Key="SearchColumnHeaderButton" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource WorkspaceSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource WorkspacePageLayoutStyle}" Background="Transparent">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <Grid x:Name="TaskToolbar" Style="{StaticResource WorkspaceTaskToolbarStyle}" Background="Transparent" ColumnSpacing="8" SizeChanged="TaskToolbar_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <controls:SelectionDropDown x:Name="KindBox" Style="{StaticResource WorkspaceToolbarSelectorStyle}" controls:WorkspaceLocalization.Options="True" ItemsSource="{x:Bind local:SearchFilterOptions.Kinds}" SelectedValue="{x:Bind ViewModel.KindIndex, Mode=TwoWay}" controls:WorkspaceLocalization.Name="搜索类型" VerticalAlignment="Center" MinWidth="104" MaxWidth="120" />
            </Grid>
            <Grid Grid.Column="1" MinWidth="160">
                <TextBox x:Name="QueryBox" Style="{StaticResource WorkspaceToolbarFieldStyle}" MaxLength="2048" controls:WorkspaceLocalization.Placeholder="搜索名称或表达式（如 ext:png;webp size:&gt;5mb）" Text="{x:Bind ViewModel.QueryText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextCompositionStarted="Query_CompositionStarted" TextCompositionEnded="Query_CompositionEnded" controls:WorkspaceLocalization.Name="搜索文件名或表达式" VerticalAlignment="Center" Padding="10,5,32,5">
                    <TextBox.KeyboardAccelerators><KeyboardAccelerator Key="Enter" Invoked="Refresh_Invoked" /></TextBox.KeyboardAccelerators>
                </TextBox>
                <FontIcon Glyph="&#xE721;" FontSize="14" HorizontalAlignment="Right" Margin="0,0,10,0" Foreground="{ThemeResource WorkspaceSecondaryBrush}" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
            </Grid>
            <Grid Grid.Column="2">
                <CheckBox x:Name="IncludeSubfoldersBox" controls:WorkspaceLocalization.Content="包含子目录" IsChecked="{x:Bind ViewModel.IncludeSubfolders, Mode=TwoWay}" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.IsFolderScope, Mode=OneWay}" MinWidth="0" FontSize="12" MinHeight="32" />
            </Grid>
            <Grid Grid.Column="3">
                <Button x:Name="FiltersButton" Style="{StaticResource WorkspaceToolbarButtonStyle}" controls:WorkspaceLocalization.Content="筛选" controls:WorkspaceLocalization.Name="更多搜索筛选" VerticalAlignment="Center">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <ScrollViewer Width="356" MaxHeight="440" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="10">
                                    <!-- Row 1: Side-by-side Size & Date dropdowns -->
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock controls:WorkspaceLocalization.Text="文件大小" Style="{StaticResource WorkspaceCaptionStyle}" FontSize="11.5" FontWeight="SemiBold" />
                                            <controls:SelectionDropDown controls:WorkspaceLocalization.Options="True" ItemsSource="{x:Bind ViewModel.SizeOptions, Mode=OneWay}" SelectedValue="{x:Bind ViewModel.SizeIndex, Mode=TwoWay}" MinWidth="0" HorizontalAlignment="Stretch" controls:WorkspaceLocalization.Name="文件大小条件" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock controls:WorkspaceLocalization.Text="修改日期" Style="{StaticResource WorkspaceCaptionStyle}" FontSize="11.5" FontWeight="SemiBold" />
                                            <controls:SelectionDropDown controls:WorkspaceLocalization.Options="True" ItemsSource="{x:Bind local:SearchFilterOptions.Dates}" SelectedValue="{x:Bind ViewModel.DateIndex, Mode=TwoWay}" MinWidth="0" HorizontalAlignment="Stretch" controls:WorkspaceLocalization.Name="修改日期条件" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Custom Size Inline Card -->
                                    <Border Style="{StaticResource WorkspaceSubtleCardStyle}" Padding="10,8" Visibility="{x:Bind ViewModel.IsCustomSize, Mode=OneWay}">
                                        <StackPanel Spacing="6">
                                            <TextBlock controls:WorkspaceLocalization.Text="{x:Bind ViewModel.SizeUnitHint, Mode=OneWay}" Style="{StaticResource WorkspaceCaptionStyle}" FontSize="11" />
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="74" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Style="{StaticResource WorkspaceToolbarFieldStyle}" MinHeight="30" Padding="8,4" MaxLength="32" controls:WorkspaceLocalization.Placeholder="最小" controls:WorkspaceLocalization.Name="最小文件大小" Text="{x:Bind ViewModel.CustomMinimum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Grid.Column="1" Text="—" VerticalAlignment="Center" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                                                <TextBox Grid.Column="2" Style="{StaticResource WorkspaceToolbarFieldStyle}" MinHeight="30" Padding="8,4" MaxLength="32" controls:WorkspaceLocalization.Placeholder="最大" controls:WorkspaceLocalization.Name="最大文件大小" Text="{x:Bind ViewModel.CustomMaximum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <controls:SelectionDropDown Grid.Column="3" controls:WorkspaceLocalization.Options="True" ItemsSource="{x:Bind ViewModel.SizeUnitOptions, Mode=OneWay}" SelectedValue="{x:Bind ViewModel.SizeUnitIndex, Mode=TwoWay}" MinWidth="0" MinHeight="30" HorizontalAlignment="Stretch" controls:WorkspaceLocalization.Name="大小单位" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Custom Date Inline Card -->
                                    <Border Style="{StaticResource WorkspaceSubtleCardStyle}" Padding="10,8" Visibility="{x:Bind ViewModel.IsCustomDate, Mode=OneWay}">
                                        <StackPanel Spacing="6">
                                            <TextBlock controls:WorkspaceLocalization.Text="日期区间（含结束日期全天）" Style="{StaticResource WorkspaceCaptionStyle}" FontSize="11" />
                                            <Grid ColumnSpacing="6" RowSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock controls:WorkspaceLocalization.Text="开始" Style="{StaticResource WorkspaceCaptionStyle}" VerticalAlignment="Center" />
                                                <CalendarDatePicker Grid.Column="1" HorizontalAlignment="Stretch" MinWidth="0" controls:WorkspaceLocalization.Placeholder="不限开始日期" DateFormat="{}{year.full}-{month.integer(2)}-{day.integer(2)}" Date="{x:Bind ViewModel.CustomDateFrom, Mode=TwoWay}" controls:WorkspaceLocalization.Name="开始日期" />
                                                <Button Grid.Column="2" Tag="From" Style="{StaticResource WorkspaceIconButtonStyle}" Width="28" Height="28" Click="ClearDate_Click" controls:WorkspaceLocalization.Name="清空开始日期" controls:WorkspaceLocalization.Tip="清空开始日期"><FontIcon Glyph="&#xE711;" FontSize="11" /></Button>
                                                <TextBlock Grid.Row="1" controls:WorkspaceLocalization.Text="结束" Style="{StaticResource WorkspaceCaptionStyle}" VerticalAlignment="Center" />
                                                <CalendarDatePicker Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" MinWidth="0" controls:WorkspaceLocalization.Placeholder="不限结束日期" DateFormat="{}{year.full}-{month.integer(2)}-{day.integer(2)}" Date="{x:Bind ViewModel.CustomDateThrough, Mode=TwoWay}" controls:WorkspaceLocalization.Name="结束日期" />
                                                <Button Grid.Row="1" Grid.Column="2" Tag="Through" Style="{StaticResource WorkspaceIconButtonStyle}" Width="28" Height="28" Click="ClearDate_Click" controls:WorkspaceLocalization.Name="清空结束日期" controls:WorkspaceLocalization.Tip="清空结束日期"><FontIcon Glyph="&#xE711;" FontSize="11" /></Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="{x:Bind ViewModel.FilterError, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasFilterError, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite" />
                                    <InfoBar IsOpen="{x:Bind ViewModel.HasPreferencesError, Mode=OneWay}" IsClosable="False" Severity="Warning" Message="{x:Bind ViewModel.PreferencesError, Mode=OneWay}">
                                        <InfoBar.ActionButton><Button controls:WorkspaceLocalization.Content="重试保存" Command="{x:Bind ViewModel.SavePreferencesCommand}" /></InfoBar.ActionButton>
                                    </InfoBar>

                                    <StackPanel Spacing="4">
                                        <TextBlock controls:WorkspaceLocalization.Text="排序方式" Style="{StaticResource WorkspaceCaptionStyle}" FontSize="11.5" FontWeight="SemiBold" />
                                        <controls:SelectionDropDown HorizontalAlignment="Stretch" controls:WorkspaceLocalization.Options="True" ItemsSource="{x:Bind local:SearchFilterOptions.Sorts}" SelectedValue="{x:Bind ViewModel.SortIndex, Mode=TwoWay}" controls:WorkspaceLocalization.Name="搜索结果排序" />
                                    </StackPanel>

                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox controls:WorkspaceLocalization.Content="匹配完整路径" IsChecked="{x:Bind ViewModel.MatchPath, Mode=TwoWay}" MinWidth="0" FontSize="12" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" controls:WorkspaceLocalization.Content="清空条件" Style="{StaticResource WorkspaceToolbarButtonStyle}" MinHeight="28" Padding="10,3" Command="{x:Bind ViewModel.ResetFiltersCommand}" controls:WorkspaceLocalization.Name="清空搜索条件" controls:WorkspaceLocalization.Tip="清空搜索文字和筛选条件，恢复当前范围的全部结果。" />
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
            <Grid Grid.Column="4">
                <Button x:Name="PresetsButton" Style="{StaticResource WorkspaceToolbarButtonStyle}" controls:WorkspaceLocalization.Content="常用条件" controls:WorkspaceLocalization.Tip="保存或套用范围、关键词、筛选和排序" VerticalAlignment="Center">
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Width="336" Spacing="12">
                                <TextBlock controls:WorkspaceLocalization.Text="常用搜索条件" FontWeight="SemiBold" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <controls:SelectionDropDown ItemsSource="{x:Bind ViewModel.PresetOptions}" SelectedValue="{x:Bind ViewModel.PresetIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" controls:WorkspaceLocalization.Name="套用常用条件" />
                                    <Button Grid.Column="1" controls:WorkspaceLocalization.Content="移除" Command="{x:Bind ViewModel.RemovePresetCommand}" IsEnabled="{x:Bind ViewModel.CanRemovePreset, Mode=OneWay}" controls:WorkspaceLocalization.Tip="只移除保存的条件，不影响文件或当前搜索" />
                                </Grid>
                                <TextBox controls:WorkspaceLocalization.Header="保存当前条件" controls:WorkspaceLocalization.Placeholder="条件名称，如：本周大图片" MaxLength="60" Text="{x:Bind ViewModel.PresetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock controls:WorkspaceLocalization.Text="保存范围、关键词、筛选和排序；不保存搜索结果或所选文件。" Style="{StaticResource WorkspaceCaptionStyle}" TextWrapping="Wrap" />
                                <Button controls:WorkspaceLocalization.Content="保存当前条件" Command="{x:Bind ViewModel.SavePresetCommand}" HorizontalAlignment="Right" />
                                <TextBlock Text="{x:Bind ViewModel.PresetMessage, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
            <Grid Grid.Column="5">
                <Button x:Name="HelpButton" controls:WorkspaceLocalization.Tip="支持的搜索语法" controls:WorkspaceLocalization.Name="搜索语法帮助" VerticalAlignment="Center" Style="{StaticResource WorkspaceIconButtonStyle}">
                    <FontIcon Glyph="&#xE897;" FontSize="16" />
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel MaxWidth="340" Spacing="10">
                                <TextBlock controls:WorkspaceLocalization.Text="常用搜索表达式" FontWeight="SemiBold" />
                                <TextBlock controls:WorkspaceLocalization.Text="产品 主图　同时包含两个词&#10;ext:jpg;png　按扩展名&#10;size:&gt;100mb　按大小&#10;dm:today / dm:7days　修改日期&#10;!备份　排除名称&#10;*.pdf | *.docx　任一种匹配&#10;file: / folder:　文件或文件夹" TextWrapping="Wrap" FontSize="13" />
                                <TextBlock controls:WorkspaceLocalization.Text="含空格的名称可加双引号。content:文字 可查找本地 UTF-8 或带 BOM 的文本、Markdown、CSV、日志与代码文件。" TextWrapping="Wrap" Style="{StaticResource WorkspaceCaptionStyle}" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
            <Button x:Name="MoreButton" Grid.Column="6" Style="{StaticResource WorkspaceIconButtonStyle}" Visibility="Collapsed" VerticalAlignment="Center" controls:WorkspaceLocalization.Name="更多搜索操作" controls:WorkspaceLocalization.Tip="常用条件与搜索帮助">
                <FontIcon Glyph="&#xE712;" FontSize="16" />
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem controls:WorkspaceLocalization.Text="常用条件" Click="MorePresets_Click" />
                        <MenuFlyoutItem controls:WorkspaceLocalization.Text="搜索语法帮助" Click="MoreHelp_Click" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <Grid Grid.Column="7">
                <Button x:Name="RefreshButton" Command="{x:Bind ViewModel.RefreshCommand}" controls:WorkspaceLocalization.Tip="刷新结果；指定目录将重新扫描" controls:WorkspaceLocalization.Name="刷新搜索" VerticalAlignment="Center" Click="RefreshLocations_Click" Style="{StaticResource WorkspaceIconButtonStyle}"><FontIcon Glyph="&#xE72C;" FontSize="16" /></Button>
                <Button x:Name="CancelButton" Command="{x:Bind ViewModel.CancelCommand}" IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay}" controls:WorkspaceLocalization.Tip="取消本次查询" controls:WorkspaceLocalization.Name="取消搜索" VerticalAlignment="Center" Style="{StaticResource WorkspaceIconButtonStyle}" Visibility="Collapsed"><FontIcon Glyph="&#xE711;" FontSize="14" /></Button>
            </Grid>
            <controls:AddFilesButton x:Name="AddFolderButton" Grid.Column="8" FolderOnly="True" FolderRequested="Browse_Click" VerticalAlignment="Center" controls:WorkspaceLocalization.Tip="选择要搜索的文件夹" />
        </Grid>

        <controls:ResizablePane x:Name="SourcesHost" Grid.Row="1" IsPaneOnLeft="True" DefaultPaneWidth="194" MinimumPaneWidth="160" MinimumContentWidth="600" CollapseBelowWidth="1050" WidthPreferenceKey="Search.Sources">
            <controls:ResizablePane.MainContent>
                <controls:ResizablePane x:Name="DetailsHost" WidthPreferenceKey="Search.Details" IsPaneOpen="{x:Bind ViewModel.ShowDetails, Mode=TwoWay}">
                    <controls:ResizablePane.MainContent>
                        <Border Style="{StaticResource WorkspaceSurfaceStyle}" Background="Transparent">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Style="{StaticResource WorkspacePathBarStyle}" ColumnSpacing="4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Button x:Name="ParentLocation" Click="ParentLocation_Click" Style="{StaticResource WorkspaceIconButtonStyle}" controls:WorkspaceLocalization.Name="返回上级搜索目录" controls:WorkspaceLocalization.Tip="返回上级目录"><FontIcon Style="{StaticResource WorkspaceParentFolderIconStyle}" /></Button>
                                    <Grid Grid.Column="1">
                                        <BreadcrumbBar x:Name="LocationCrumbs" ItemClicked="LocationCrumbs_ItemClicked" VerticalAlignment="Center" controls:WorkspaceLocalization.Name="当前搜索目录">
                                            <BreadcrumbBar.ItemTemplate>
                                                <DataTemplate x:DataType="local:SearchLocationCrumb">
                                                    <controls:BreadcrumbLabel>
                                                        <TextBlock Text="{x:Bind Name}" MaxWidth="180" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                                                    </controls:BreadcrumbLabel>
                                                </DataTemplate>
                                            </BreadcrumbBar.ItemTemplate>
                                        </BreadcrumbBar>
                                        <TextBlock x:Name="ScopeCaption" Text="{x:Bind ViewModel.ScopeLabel, Mode=OneWay}" Style="{StaticResource WorkspacePaneTitleStyle}" />
                                    </Grid>
                                    <TextBlock x:Name="VisibleResultCount" Grid.Column="2" Typography.NumeralAlignment="Tabular" Style="{StaticResource WorkspaceCaptionStyle}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </Grid>

                                <ProgressBar Grid.Row="2" IsIndeterminate="True" Height="2" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

                                <Grid Grid.Row="3">
                                    <Grid.RowDefinitions><RowDefinition x:Name="ResultsHeaderRow" Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <controls:MarqueeSelection Grid.RowSpan="2" Target="{x:Bind ResultsList}" SelectionCommitted="Results_MarqueeCommitted">
                                        <ScrollViewer x:Name="ResultsViewport" SizeChanged="ResultsViewport_SizeChanged" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                                            <Grid MinWidth="{x:Bind ViewModel.ColumnWidths.MinimumTableWidth, Mode=OneWay}" Width="{Binding ViewportWidth, ElementName=ResultsViewport}">
                                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                                <Border x:Name="ResultsHeader" controls:MarqueeSelection.IsExcluded="True" SizeChanged="ResultsHeader_SizeChanged" Background="{ThemeResource WorkspaceSubtleBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="0,0,0,1" Padding="14,7">
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="{x:Bind ViewModel.ColumnWidths.Name, Mode=OneWay, Converter={StaticResource ColumnWidth}}" />
                                                            <ColumnDefinition Width="{x:Bind ViewModel.ColumnWidths.Location, Mode=OneWay, Converter={StaticResource ColumnWidth}}" />
                                                            <ColumnDefinition Width="{x:Bind ViewModel.ColumnWidths.Size, Mode=OneWay, Converter={StaticResource ColumnWidth}}" />
                                                            <ColumnDefinition Width="{x:Bind ViewModel.ColumnWidths.Modified, Mode=OneWay, Converter={StaticResource ColumnWidth}}" />
                                                        </Grid.ColumnDefinitions>
                                                        <Button Tag="0" Click="SortHeader_Click" Style="{StaticResource SearchColumnHeaderButton}" AutomationProperties.Name="{x:Bind ViewModel.NameSortDescription, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.NameSortDescription, Mode=OneWay}">
                                                            <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock controls:WorkspaceLocalization.Text="名称" /><FontIcon Glyph="{x:Bind ViewModel.NameSortGlyph, Mode=OneWay}" FontSize="10" /></StackPanel>
                                                        </Button>
                                                        <Button Grid.Column="1" Tag="1" Click="SortHeader_Click" Style="{StaticResource SearchColumnHeaderButton}" AutomationProperties.Name="{x:Bind ViewModel.PathSortDescription, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.PathSortDescription, Mode=OneWay}">
                                                            <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock controls:WorkspaceLocalization.Text="所在位置" /><FontIcon Glyph="{x:Bind ViewModel.PathSortGlyph, Mode=OneWay}" FontSize="10" /></StackPanel>
                                                        </Button>
                                                        <Button Grid.Column="2" Tag="2" Click="SortHeader_Click" Style="{StaticResource SearchColumnHeaderButton}" AutomationProperties.Name="{x:Bind ViewModel.SizeSortDescription, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.SizeSortDescription, Mode=OneWay}">
                                                            <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock controls:WorkspaceLocalization.Text="大小" /><FontIcon Glyph="{x:Bind ViewModel.SizeSortGlyph, Mode=OneWay}" FontSize="10" /></StackPanel>
                                                        </Button>
                                                        <Button Grid.Column="3" Tag="3" Click="SortHeader_Click" Style="{StaticResource SearchColumnHeaderButton}" AutomationProperties.Name="{x:Bind ViewModel.ModifiedSortDescription, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.ModifiedSortDescription, Mode=OneWay}">
                                                            <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock controls:WorkspaceLocalization.Text="修改时间" /><FontIcon Glyph="{x:Bind ViewModel.ModifiedSortGlyph, Mode=OneWay}" FontSize="10" /></StackPanel>
                                                        </Button>
                                                        <controls:ResizeHandle Tag="Name" Style="{StaticResource ColumnResizeHandle}" controls:WorkspaceLocalization.Name="调整名称列宽" controls:WorkspaceLocalization.Tip="拖动调整名称列宽" ResizeRequested="Column_ResizeRequested" />
                                                        <controls:ResizeHandle Grid.Column="1" Tag="Location" Style="{StaticResource ColumnResizeHandle}" controls:WorkspaceLocalization.Name="调整所在位置列宽" controls:WorkspaceLocalization.Tip="拖动调整所在位置列宽" ResizeRequested="Column_ResizeRequested" />
                                                        <controls:ResizeHandle Grid.Column="2" Tag="Size" Style="{StaticResource ColumnResizeHandle}" controls:WorkspaceLocalization.Name="调整大小列宽" controls:WorkspaceLocalization.Tip="拖动调整大小列宽" ResizeRequested="Column_ResizeRequested" />
                                                        <controls:ResizeHandle Grid.Column="3" Tag="Modified" Style="{StaticResource ColumnResizeHandle}" controls:WorkspaceLocalization.Name="调整修改时间列宽" controls:WorkspaceLocalization.Tip="拖动调整修改时间列宽" ResizeRequested="Column_ResizeRequested" />
                                                    </Grid>
                                                </Border>

                                                <ListView x:Name="ResultsList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}" SelectionMode="Extended" IsMultiSelectCheckBoxEnabled="False" IsEnabled="{x:Bind ViewModel.CanUseResults, Mode=OneWay}" Padding="4,4,4,58" SelectionChanged="Results_SelectionChanged" ContextRequested="Results_ContextRequested" DoubleTapped="Results_DoubleTapped" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" controls:WorkspaceLocalization.Name="搜索结果列表">
                                                    <ListView.ItemContainerTransitions><TransitionCollection /></ListView.ItemContainerTransitions>
                                                    <ListView.ItemContainerStyle>
                                                        <Style TargetType="ListViewItem" BasedOn="{StaticResource WorkspaceListItemStyle}">
                                                            <Setter Property="MinHeight" Value="40" />
                                                            <Setter Property="Margin" Value="4,1" />
                                                            <Setter Property="Padding" Value="10,0" />
                                                            <Setter Property="CornerRadius" Value="6" />
                                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        </Style>
                                                    </ListView.ItemContainerStyle>
                                                    <ListView.KeyboardAccelerators>
                                                        <KeyboardAccelerator Key="A" Modifiers="Control" ScopeOwner="{x:Bind ResultsList}" Invoked="SelectAll_Invoked" />
                                                        <KeyboardAccelerator Key="Enter" ScopeOwner="{x:Bind ResultsList}" Invoked="Open_Invoked" />
                                                    </ListView.KeyboardAccelerators>
                                                    <ListView.ItemTemplate>
                                                        <DataTemplate x:DataType="local:SearchResultItem" x:DefaultBindMode="OneWay">
                                                            <Grid ColumnSpacing="12" Padding="0,6" ToolTipService.ToolTip="{x:Bind FullPath}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="{x:Bind Columns.Name, Mode=OneWay, Converter={StaticResource ColumnWidth}}" />
                                                                    <ColumnDefinition Width="{x:Bind Columns.Location, Mode=OneWay, Converter={StaticResource ColumnWidth}}" />
                                                                    <ColumnDefinition Width="{x:Bind Columns.Size, Mode=OneWay, Converter={StaticResource ColumnWidth}}" />
                                                                    <ColumnDefinition Width="{x:Bind Columns.Modified, Mode=OneWay, Converter={StaticResource ColumnWidth}}" />
                                                                </Grid.ColumnDefinitions>
                                                                <Grid ColumnSpacing="10">
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                                    <Border Width="26" Height="26" CornerRadius="6" Background="{ThemeResource WorkspaceSubtleBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="13.5" Foreground="{x:Bind IconTone, Converter={StaticResource CategoryBrush}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                </Grid>
                                                                <TextBlock Grid.Column="1" Text="{x:Bind Directory}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource WorkspaceSecondaryBrush}" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="2" Text="{x:Bind SizeLabel, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind SizeLabel, Mode=OneWay}" TextTrimming="CharacterEllipsis" FontSize="12" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                                                                <TextBlock Grid.Column="3" Text="{x:Bind ModifiedLabel, Mode=OneWay}" FontSize="12" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>
                                            </Grid>
                                        </ScrollViewer>
                                    </controls:MarqueeSelection>

                                    <ScrollViewer x:Name="EmptyStateViewport" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}">
                                        <StackPanel Spacing="10" MaxWidth="380" Margin="20,32" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid Width="54" Height="54" HorizontalAlignment="Center">
                                                <Border Width="44" Height="44" CornerRadius="12" Background="{ThemeResource WorkspaceSubtleBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border.RenderTransform><RotateTransform Angle="-8" CenterX="22" CenterY="22" /></Border.RenderTransform>
                                                </Border>
                                                <Border Width="44" Height="44" CornerRadius="12" Background="{ThemeResource WorkspaceCardBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE721;" FontSize="18" Foreground="{ThemeResource WorkspaceAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                            <TextBlock controls:WorkspaceLocalization.Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" />
                                            <TextBlock controls:WorkspaceLocalization.Text="{x:Bind ViewModel.EmptyDescription, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                                        </StackPanel>
                                    </ScrollViewer>

                                    <ScrollViewer x:Name="ErrorStateViewport" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{x:Bind ViewModel.ShowSearchError, Mode=OneWay}">
                                        <StackPanel Spacing="10" MaxWidth="400" Margin="20,32" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE946;" FontSize="30" Foreground="{ThemeResource WorkspaceAccentBrush}" />
                                            <TextBlock controls:WorkspaceLocalization.Text="搜索未完成" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" />
                                            <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                                <Button controls:WorkspaceLocalization.Content="重试搜索" Command="{x:Bind ViewModel.RefreshCommand}" />
                                                <Button controls:WorkspaceLocalization.Content="添加文件夹" Click="Browse_Click" />
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <!-- Floating Multi-Select Action Island for Search Results -->
                                    <ContentControl x:Name="SearchFloatingIsland" Grid.Row="1" Style="{StaticResource WorkspaceFloatingIslandStyle}" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12,0,12,12" controls:MarqueeSelection.IsExcluded="True">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock x:Name="SearchIslandSummaryText" controls:WorkspaceLocalization.Text="{x:Bind ViewModel.IslandSummary, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource WorkspaceIslandTextBrush}" VerticalAlignment="Center" />
                                            <Border Width="1" Height="14" Background="{ThemeResource WorkspaceIslandBorderBrush}" Margin="4,0" VerticalAlignment="Center" />
                                            <Button controls:WorkspaceLocalization.Content="快速预览" Style="{StaticResource WorkspaceIslandActionStyle}" Click="QuickLookSearch_Click" controls:WorkspaceLocalization.Tip="快速预览所选文件" />
                                            <Button controls:WorkspaceLocalization.Content="加入暂存" Style="{StaticResource WorkspaceIslandActionStyle}" Click="Add_Click" IsEnabled="{x:Bind ViewModel.CanAdd, Mode=OneWay}" />
                                            <Button controls:WorkspaceLocalization.Content="转格式" Style="{StaticResource WorkspaceIslandActionStyle}" Click="ConvertSelection_Click" />
                                            <Button controls:WorkspaceLocalization.Content="批量改名" Style="{StaticResource WorkspaceIslandActionStyle}" Click="RenameSelection_Click" />
                                            <Button controls:WorkspaceLocalization.Content="复制整理" Style="{StaticResource WorkspaceIslandActionStyle}" Click="CopySelectionToOrganize_Click" />
                                            <Button controls:WorkspaceLocalization.Content="复制路径" Style="{StaticResource WorkspaceIslandActionStyle}" Click="CopyPathSelection_Click" />
                                            <Button Content="✕" Style="{StaticResource WorkspaceIslandActionStyle}" Padding="8,3" Click="ClearSelection_Click" controls:WorkspaceLocalization.Name="取消选择" controls:WorkspaceLocalization.Tip="取消选择" />
                                        </StackPanel>
                                    </ContentControl>
                                </Grid>

                                <StackPanel Grid.Row="4" Background="{ThemeResource WorkspaceSubtleBrush}">
                                    <InfoBar IsOpen="{x:Bind ViewModel.ShowInlineError, Mode=OneWay}" IsClosable="False" Severity="Warning" Margin="12,8,12,0" Title="{x:Bind ViewModel.InlineErrorTitle, Mode=OneWay}" Message="{x:Bind ViewModel.Message, Mode=OneWay}">
                                        <InfoBar.ActionButton><Button controls:WorkspaceLocalization.Content="重试" Command="{x:Bind ViewModel.RetryCommand}" /></InfoBar.ActionButton>
                                    </InfoBar>
                                    <Grid Padding="14,7" ColumnSpacing="8" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="0,1,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <TextBlock controls:WorkspaceLocalization.Text="{x:Bind ViewModel.ResultCountLabel, Mode=OneWay}" Typography.NumeralAlignment="Tabular" FontSize="12" />
                                            <TextBlock controls:WorkspaceLocalization.Text="· 全选仅限已加载项（Ctrl+A）" FontSize="12" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" controls:WorkspaceLocalization.Content="{x:Bind ViewModel.LoadMoreLabel, Mode=OneWay}" FontSize="12" Padding="10,4" Command="{x:Bind ViewModel.LoadMoreCommand}" IsEnabled="{x:Bind ViewModel.CanLoadMore, Mode=OneWay}" controls:WorkspaceLocalization.Tip="每次加载 200 项；Ctrl+A 只选择已载入项" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </controls:ResizablePane.MainContent>

                    <controls:ResizablePane.PaneContent>
                        <Border Style="{StaticResource WorkspaceSurfaceStyle}" Background="{ThemeResource WorkspacePaneBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="0" CornerRadius="0,0,11,0">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Border Style="{StaticResource WorkspacePaneHeaderStyle}">
                                    <Grid>
                                        <TextBlock controls:WorkspaceLocalization.Text="文件信息" Style="{StaticResource WorkspacePaneTitleStyle}" />
                                        <Button HorizontalAlignment="Right" Style="{StaticResource WorkspaceIconButtonStyle}" Content="" ContentTemplate="{StaticResource WorkspaceRightPaneIconTemplate}" Click="ToggleDetails_Click" controls:WorkspaceLocalization.Name="收起文件信息" controls:WorkspaceLocalization.Tip="收起文件信息" />
                                    </Grid>
                                </Border>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Padding="14,12" Spacing="12">
                                        <Border Style="{StaticResource WorkspaceBentoCardStyle}" Padding="16,22" Visibility="{x:Bind ViewModel.ShowSelectionHint, Mode=OneWay}">
                                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                                <Border Width="38" Height="38" CornerRadius="19" Background="{ThemeResource WorkspaceSubtleBrush}" HorizontalAlignment="Center">
                                                    <FontIcon Glyph="&#xE721;" FontSize="16" Foreground="{ThemeResource WorkspaceSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock controls:WorkspaceLocalization.Text="选择结果查看预览" FontSize="13.5" FontWeight="SemiBold" TextAlignment="Center" />
                                                <TextBlock controls:WorkspaceLocalization.Text="单击搜索结果查看缩略预览与完整路径；多选后可直接通过底部浮动动作岛流转到各处理模块。" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                                            <preview:FilePreviewView File="{x:Bind ViewModel.SelectedItem.File, Mode=OneWay}" Glyph="{x:Bind ViewModel.DetailGlyph, Mode=OneWay}" PreviewHeight="184" />
                                            <TextBlock Text="{x:Bind ViewModel.DetailName, Mode=OneWay}" TextWrapping="Wrap" FontSize="15" FontWeight="SemiBold" IsTextSelectionEnabled="True" />
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <Button controls:WorkspaceLocalization.Content="打开" HorizontalAlignment="Stretch" FontSize="12" Padding="8,5" Click="OpenSelected_Click" />
                                                <Button Grid.Column="1" controls:WorkspaceLocalization.Content="所在文件夹" HorizontalAlignment="Stretch" FontSize="12" Padding="8,5" Click="RevealSelected_Click" />
                                            </Grid>
                                            <Border Style="{StaticResource WorkspaceBentoCardStyle}">
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnSpacing="10" RowSpacing="8">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                        <TextBlock controls:WorkspaceLocalization.Text="类型" Style="{StaticResource WorkspaceCaptionStyle}" />
                                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DetailType, Mode=OneWay}" FontSize="12" />
                                                        <TextBlock Grid.Row="1" controls:WorkspaceLocalization.Text="大小" Style="{StaticResource WorkspaceCaptionStyle}" />
                                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.DetailSize, Mode=OneWay}" FontSize="12" Typography.NumeralAlignment="Tabular" />
                                                        <TextBlock Grid.Row="2" controls:WorkspaceLocalization.Text="修改时间" Style="{StaticResource WorkspaceCaptionStyle}" />
                                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.DetailModified, Mode=OneWay}" FontSize="12" Typography.NumeralAlignment="Tabular" />
                                                    </Grid>
                                                    <Border Height="1" Background="{ThemeResource WorkspaceBorderBrush}" />
                                                    <StackPanel Spacing="4">
                                                        <TextBlock controls:WorkspaceLocalization.Text="完整路径" Style="{StaticResource WorkspaceCaptionStyle}" />
                                                        <TextBlock Text="{x:Bind ViewModel.DetailPath, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="11.5" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                                <Border Grid.Row="2" Style="{StaticResource WorkspaceOperationFooterStyle}">
                                    <StackPanel Spacing="7">
                                        <TextBlock Style="{StaticResource WorkspaceScopeStyle}"><Run controls:WorkspaceLocalization.Text="已选 " /><Run Text="{x:Bind ViewModel.SelectionCount, Mode=OneWay}" /><Run controls:WorkspaceLocalization.Text=" 项 · 仅处理已加载的选中结果" /></TextBlock>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource WorkspaceSecondaryBrush}" AutomationProperties.LiveSetting="Polite" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.Status, Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind ViewModel.Feedback, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource WorkspaceAccentBrush}" AutomationProperties.LiveSetting="Polite" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.Feedback, Mode=OneWay}" />
                                        </StackPanel>
                                        <Button controls:WorkspaceLocalization.Content="加入文件暂存区" Style="{StaticResource WorkspacePrimaryActionStyle}" IsEnabled="{x:Bind ViewModel.CanAdd, Mode=OneWay}" Click="Add_Click" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </controls:ResizablePane.PaneContent>
                    <controls:ResizablePane.CollapsedPaneContent>
                        <Border Style="{StaticResource WorkspaceSurfaceStyle}" Background="{ThemeResource WorkspacePaneBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="0" CornerRadius="0,0,11,0" Padding="6,5">
                            <Button HorizontalAlignment="Center" VerticalAlignment="Top" Style="{StaticResource WorkspaceIconButtonStyle}" Content="" ContentTemplate="{StaticResource WorkspaceRightPaneIconTemplate}" Click="ToggleDetails_Click" controls:WorkspaceLocalization.Name="展开文件信息" controls:WorkspaceLocalization.Tip="展开文件信息" />
                        </Border>
                    </controls:ResizablePane.CollapsedPaneContent>
                </controls:ResizablePane>
            </controls:ResizablePane.MainContent>

            <controls:ResizablePane.PaneContent>
                <Grid Background="{ThemeResource WorkspacePaneBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="0" CornerRadius="0,0,0,11">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border Style="{StaticResource WorkspacePaneHeaderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock controls:WorkspaceLocalization.Text="位置导航" Style="{StaticResource WorkspacePaneTitleStyle}" />
                            <Button Grid.Column="1" Style="{StaticResource WorkspaceIconButtonStyle}" Content="" ContentTemplate="{StaticResource WorkspaceLeftPaneIconTemplate}" Click="ToggleSources_Click" controls:WorkspaceLocalization.Name="收起左侧栏" controls:WorkspaceLocalization.Tip="收起左侧栏" />
                        </Grid>
                    </Border>
                    <TreeView x:Name="LocationsTree" Grid.Row="1" Margin="8,4,8,4" CanDragItems="False" CanReorderItems="False" SelectionMode="Single" Expanding="Locations_Expanding" ItemInvoked="Locations_ItemInvoked" ItemContainerStyle="{StaticResource WorkspaceFolderTreeItemStyle}" controls:WorkspaceLocalization.Name="搜索范围与目录导航" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="TreeViewNode">
                                <Grid ColumnSpacing="8" Padding="0,5" MinWidth="112" ToolTipService.ToolTip="{x:Bind ((local:SearchLocationNode)Content).Path}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind ((local:SearchLocationNode)Content).Glyph}" FontSize="14" Foreground="{ThemeResource WorkspaceCategoryFolderBrush}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ((local:SearchLocationNode)Content).Name}" Style="{StaticResource WorkspaceFolderNameStyle}" />
                                </Grid>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    <TextBlock x:Name="NavigationMessage" Grid.Row="2" Margin="12,8" Style="{StaticResource WorkspaceCaptionStyle}" TextWrapping="Wrap" MaxLines="3" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                </Grid>
            </controls:ResizablePane.PaneContent>
            <controls:ResizablePane.CollapsedPaneContent>
                <Border Background="{ThemeResource WorkspacePaneBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="0" CornerRadius="0,0,0,11" Padding="6,7">
                    <Button Style="{StaticResource WorkspaceIconButtonStyle}" VerticalAlignment="Top" Content="" ContentTemplate="{StaticResource WorkspaceLeftPaneIconTemplate}" Click="ToggleSources_Click" controls:WorkspaceLocalization.Name="展开左侧栏" controls:WorkspaceLocalization.Tip="展开左侧栏" />
                </Border>
            </controls:ResizablePane.CollapsedPaneContent>
        </controls:ResizablePane>
    </Grid>
</UserControl>
