<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="FileAssistant.App.Features.CreateOrRename.NamingOptionsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:FileAssistant.App.Controls" xmlns:local="using:FileAssistant.App.Features.CreateOrRename" xmlns:model="using:FileAssistant.Core.Features.CreateOrRename">
    <controls:OperationPanel x:Name="OptionsPanel" IsCompact="True">
        <controls:OperationPanel.Body>
            <ContentControl IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="6">
                    <Button x:Name="SettingsBack" Command="{x:Bind ViewModel.BackToSettingsCommand}" Visibility="{x:Bind ViewModel.ShowPanelBack, Mode=OneWay}" HorizontalAlignment="Left" AutomationProperties.Name="返回主设置">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72B;" FontSize="12" />
                            <TextBlock Text="返回主设置" />
                        </StackPanel>
                    </Button>

                    <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.ShowMainSettings, Mode=OneWay}">

                        <!-- ==================== RENAME MODE (SIMPLIFIED 3-TAB INSPECTOR) ==================== -->
                        <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.IsRename, Mode=OneWay}">
                            <!-- Inline warning when stale/missing files exist in the rename list -->
                            <Border Visibility="{x:Bind ViewModel.HasUnavailableFiles, Mode=OneWay}" CornerRadius="8" Padding="9,7" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" BorderBrush="{ThemeResource SystemFillColorCriticalBrush}" BorderThickness="1">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{x:Bind ViewModel.UnavailableFilesMessage, Mode=OneWay}" FontSize="11.5" TextWrapping="Wrap" Foreground="{ThemeResource WorkspaceTextBrush}" />
                                    <Button Content="一键移除失效项" Command="{x:Bind ViewModel.RemoveUnavailableFilesCommand}" Style="{StaticResource OpPillButtonStyle}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>

                            <!-- Single-row 3-mode segmented switcher -->
                            <Border Style="{StaticResource OpPrimaryCardStyle}" Padding="4">
                                <Grid ColumnSpacing="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="RenameTabAdd" Content="加前缀/序号" Tag="0" Click="RenameTab_Click" IsChecked="{x:Bind ViewModel.IsRenameAddTab, Mode=OneWay}" HorizontalAlignment="Stretch" Style="{StaticResource OpPillToggleStyle}" CornerRadius="6" Padding="4,5" FontSize="11.5" />
                                    <ToggleButton x:Name="RenameTabClean" Grid.Column="1" Content="换字/删字" Tag="1" Click="RenameTab_Click" IsChecked="{x:Bind ViewModel.IsRenameCleanTab, Mode=OneWay}" HorizontalAlignment="Stretch" Style="{StaticResource OpPillToggleStyle}" CornerRadius="6" Padding="4,5" FontSize="11.5" />
                                    <ToggleButton x:Name="RenameTabUniform" Grid.Column="2" Content="统一重命名" Tag="2" Click="RenameTab_Click" IsChecked="{x:Bind ViewModel.IsRenameUniformTab, Mode=OneWay}" HorizontalAlignment="Stretch" Style="{StaticResource OpPillToggleStyle}" CornerRadius="6" Padding="4,5" FontSize="11.5" />
                                </Grid>
                            </Border>

                            <!-- TAB 0: Additive Prefix / Date / Parent / Serial -->
                            <StackPanel Spacing="5" Visibility="{x:Bind ViewModel.IsRenameAddTab, Mode=OneWay}">
                                <Grid Style="{StaticResource OpPropertyRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="叠加元素" Style="{StaticResource OpLabelStyle}" ToolTipService.ToolTip="可同时勾选多个元素叠加组合" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                                        <ToggleButton x:Name="ChipParentToggle" Content="+父目录" IsChecked="{x:Bind ViewModel.ChipAddParent, Mode=TwoWay}" Padding="6,3" Style="{StaticResource OpPillToggleStyle}" ToolTipService.ToolTip="在名称前叠加父文件夹名" />
                                        <ToggleButton x:Name="ChipDateToggle" Content="+日期" IsChecked="{x:Bind ViewModel.ChipAddDate, Mode=TwoWay}" Padding="6,3" Style="{StaticResource OpPillToggleStyle}" ToolTipService.ToolTip="在名称中叠加修改日期" />
                                        <ToggleButton x:Name="ChipSerialToggle" Content="+序号" IsChecked="{x:Bind ViewModel.ChipAddSerial, Mode=TwoWay}" Padding="6,3" Style="{StaticResource OpPillToggleStyle}" ToolTipService.ToolTip="叠加递增编号" />
                                    </StackPanel>
                                </Grid>

                                <Grid Style="{StaticResource OpPropertyRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="前后文字" Style="{StaticResource OpLabelStyle}" />
                                    <Grid Grid.Column="1" ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{x:Bind ViewModel.Prefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OpSoftTextBoxStyle}" PlaceholderText="前缀…" AutomationProperties.Name="在名称前面添加" />
                                        <TextBox Grid.Column="1" Text="{x:Bind ViewModel.Suffix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OpSoftTextBoxStyle}" PlaceholderText="后缀…" AutomationProperties.Name="在名称后面添加" />
                                    </Grid>
                                </Grid>
                            </StackPanel>

                            <!-- TAB 1: Replace / Delete / Case -->
                            <StackPanel Spacing="5" Visibility="{x:Bind ViewModel.IsRenameCleanTab, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <ToggleButton Content="换字/删字" Tag="1" Click="CleanSubMode_Click" IsChecked="{x:Bind ViewModel.IsReplaceSubMode, Mode=OneWay}" Style="{StaticResource OpPillToggleStyle}" />
                                    <ToggleButton Content="按位置删" Tag="3" Click="CleanSubMode_Click" IsChecked="{x:Bind ViewModel.IsDeletePosSubMode, Mode=OneWay}" Style="{StaticResource OpPillToggleStyle}" />
                                    <ToggleButton Content="大小写" Tag="4" Click="CleanSubMode_Click" IsChecked="{x:Bind ViewModel.IsCaseSubMode, Mode=OneWay}" Style="{StaticResource OpPillToggleStyle}" />
                                </StackPanel>

                                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsReplaceSubMode, Mode=OneWay}">
                                    <Grid Style="{StaticResource OpPropertyRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="查找文字" Style="{StaticResource OpLabelStyle}" />
                                        <TextBox Grid.Column="1" Text="{x:Bind ViewModel.Find, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OpSoftTextBoxStyle}" AutomationProperties.Name="查找文字" PlaceholderText="例如：初稿" />
                                    </Grid>
                                    <Grid Style="{StaticResource OpPropertyRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="替换为" Style="{StaticResource OpLabelStyle}" />
                                        <TextBox Grid.Column="1" Text="{x:Bind ViewModel.Replacement, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OpSoftTextBoxStyle}" AutomationProperties.Name="替换为" PlaceholderText="留空即直接删除" />
                                    </Grid>
                                    <Button Content="示例：初稿 → 定稿" Tag="replaceDraft" Click="QuickRecipe_Click" Style="{StaticResource OpPillButtonStyle}" HorizontalAlignment="Left" />
                                </StackPanel>

                                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsDeletePosSubMode, Mode=OneWay}">
                                    <Grid Style="{StaticResource OpPropertyRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="起始位置" Style="{StaticResource OpLabelStyle}" />
                                        <TextBox Grid.Column="1" Text="{x:Bind ViewModel.RemoveAt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OpSoftTextBoxStyle}" AutomationProperties.Name="从第几个字符开始删除" InputScope="Number" PlaceholderText="从 1 开始" />
                                    </Grid>
                                    <Grid Style="{StaticResource OpPropertyRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="删除字数" Style="{StaticResource OpLabelStyle}" />
                                        <TextBox Grid.Column="1" Text="{x:Bind ViewModel.RemoveCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OpSoftTextBoxStyle}" AutomationProperties.Name="删除几个字符" InputScope="Number" />
                                    </Grid>
                                </StackPanel>

                                <Grid Style="{StaticResource OpPropertyRowStyle}" Visibility="{x:Bind ViewModel.IsCaseSubMode, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="大小写" Style="{StaticResource OpLabelStyle}" />
                                    <controls:SelectionDropDown Grid.Column="1" ItemsSource="{x:Bind ViewModel.Cases}" SelectedValue="{x:Bind ViewModel.CaseValue, Mode=TwoWay}" Style="{StaticResource OpSoftDropDownStyle}" AutomationProperties.Name="调整大小写" />
                                </Grid>
                            </StackPanel>

                            <!-- TAB 2: Uniform / Manual / Custom Template -->
                            <StackPanel Spacing="5" Visibility="{x:Bind ViewModel.IsRenameUniformTab, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <ToggleButton Content="统一新名" Tag="0" Click="UniformSubMode_Click" IsChecked="{x:Bind ViewModel.IsUniformSubMode, Mode=OneWay}" Style="{StaticResource OpPillToggleStyle}" />
                                    <ToggleButton Content="逐项手改" Tag="7" Click="UniformSubMode_Click" IsChecked="{x:Bind ViewModel.IsManualSubMode, Mode=OneWay}" Style="{StaticResource OpPillToggleStyle}" />
                                    <ToggleButton Content="高级模板" Tag="5" Click="UniformSubMode_Click" IsChecked="{x:Bind ViewModel.IsTemplateSubMode, Mode=OneWay}" Style="{StaticResource OpPillToggleStyle}" />
                                </StackPanel>

                                <Grid Style="{StaticResource OpPropertyRowStyle}" Visibility="{x:Bind ViewModel.IsUniformSubMode, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="统一名称" Style="{StaticResource OpLabelStyle}" />
                                    <TextBox Grid.Column="1" Text="{x:Bind ViewModel.RenameBaseName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OpSoftTextBoxStyle}" AutomationProperties.Name="统一名称" PlaceholderText="例如：旅行照片" />
                                </Grid>

                                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsManualSubMode, Mode=OneWay}">
                                    <Grid Style="{StaticResource OpPropertyRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="逐项改名" Style="{StaticResource OpLabelStyle}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CustomNameSummary, Mode=OneWay}" Style="{StaticResource WorkspaceCaptionStyle}" TextTrimming="CharacterEllipsis" TextAlignment="Right" AutomationProperties.LiveSetting="Polite" />
                                    </Grid>
                                    <TextBlock Text="直接在中央文件列表填写新名称，扩展名自动保留。" Style="{StaticResource WorkspaceCaptionStyle}" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsTemplateSubMode, Mode=OneWay}">
                                    <Grid Style="{StaticResource OpPropertyRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="命名模板" Style="{StaticResource OpLabelStyle}" />
                                        <TextBox Grid.Column="1" Text="{x:Bind ViewModel.RenamePattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OpSoftTextBoxStyle}" AutomationProperties.Name="改名组合模板" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Button Content="+原名称" Tag="{}{name}" Click="InsertToken_Click" Style="{StaticResource OpPillButtonStyle}" />
                                        <Button Content="+序号" Tag="{}{n}" Click="InsertToken_Click" Style="{StaticResource OpPillButtonStyle}" />
                                        <Button Content="+日期" Tag="{}{date}" Click="InsertToken_Click" Style="{StaticResource OpPillButtonStyle}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Button Content="+父目录" Tag="{}{parent}" Click="InsertToken_Click" Style="{StaticResource OpPillButtonStyle}" />
                                        <Button Content="下划线 _" Tag="_" Click="InsertToken_Click" Style="{StaticResource OpPillButtonStyle}" />
                                        <Button Content="短横线 -" Tag="-" Click="InsertToken_Click" Style="{StaticResource OpPillButtonStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- 4-in-1 Serial Style Dropdown (collapses Position/Digits/Separator into 1 clean row) -->
                            <Grid Style="{StaticResource OpPropertyRowStyle}" Visibility="{x:Bind ViewModel.ShowSerialStylePicker, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="序号样式" Style="{StaticResource OpLabelStyle}" />
                                <controls:SelectionDropDown x:Name="SerialStyleDropDown" Grid.Column="1" ItemsSource="{x:Bind ViewModel.SerialStyleOptions}" SelectedValue="{x:Bind ViewModel.SerialStyleValue, Mode=TwoWay}" Style="{StaticResource OpSoftDropDownStyle}" AutomationProperties.Name="序号样式" />
                            </Grid>

                            <!-- Expanded Custom Serial Controls (only when 自定义… is chosen) -->
                            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.ShowCustomSerialControls, Mode=OneWay}">
                                <Grid Style="{StaticResource OpPropertyRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="编号位置" Style="{StaticResource OpLabelStyle}" />
                                    <controls:SelectionDropDown Grid.Column="1" ItemsSource="{x:Bind ViewModel.NumberPositions}" SelectedValue="{x:Bind ViewModel.NumberPosition, Mode=TwoWay}" Style="{StaticResource OpSoftDropDownStyle}" AutomationProperties.Name="编号位置" />
                                </Grid>
                                <Grid Style="{StaticResource OpPropertyRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="起 / 位" Style="{StaticResource OpLabelStyle}" ToolTipService.ToolTip="{x:Bind ViewModel.NamingExample, Mode=OneWay}" />
                                    <Grid Grid.Column="1" ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Grid>
                                            <TextBox Text="{x:Bind ViewModel.Start, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OpSoftTextBoxStyle}" AutomationProperties.Name="起始数字" InputScope="Number" Padding="23,6,6,6" TextAlignment="Center" />
                                            <TextBlock Text="起" Margin="6,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Style="{StaticResource OpLabelStyle}" />
                                        </Grid>
                                        <Grid Grid.Column="1">
                                            <TextBox Text="{x:Bind ViewModel.Digits, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OpSoftTextBoxStyle}" AutomationProperties.Name="数字位数" InputScope="Number" Padding="23,6,6,6" TextAlignment="Center" />
                                            <TextBlock Text="位" Margin="6,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Style="{StaticResource OpLabelStyle}" />
                                        </Grid>
                                    </Grid>
                                </Grid>
                                <Grid Style="{StaticResource OpPropertyRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="连接符号" Style="{StaticResource OpLabelStyle}" />
                                    <controls:SelectionDropDown Grid.Column="1" ItemsSource="{x:Bind ViewModel.Separators}" SelectedValue="{x:Bind ViewModel.SeparatorValue, Mode=TwoWay}" Style="{StaticResource OpSoftDropDownStyle}" AutomationProperties.Name="编号分隔符" />
                                </Grid>
                            </StackPanel>

                            <!-- Start / Digits for Advanced Template -->
                            <Grid Style="{StaticResource OpPropertyRowStyle}" Visibility="{x:Bind ViewModel.ShowRenameTemplateNumbering, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="起 / 位" Style="{StaticResource OpLabelStyle}" />
                                <Grid Grid.Column="1" ColumnSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <TextBox Text="{x:Bind ViewModel.Start, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OpSoftTextBoxStyle}" AutomationProperties.Name="模板起始数字" InputScope="Number" Padding="23,6,6,6" TextAlignment="Center" />
                                        <TextBlock Text="起" Margin="6,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Style="{StaticResource OpLabelStyle}" />
                                    </Grid>
                                    <Grid Grid.Column="1">
                                        <TextBox Text="{x:Bind ViewModel.Digits, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OpSoftTextBoxStyle}" AutomationProperties.Name="模板数字位数" InputScope="Number" Padding="23,6,6,6" TextAlignment="Center" />
                                        <TextBlock Text="位" Margin="6,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Style="{StaticResource OpLabelStyle}" />
                                    </Grid>
                                </Grid>
                            </Grid>

                            <!-- Conflict Policy -->
                            <Grid Style="{StaticResource OpPropertyRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="同名处理" Style="{StaticResource OpLabelStyle}" />
                                <controls:SelectionDropDown Grid.Column="1" ItemsSource="{x:Bind ViewModel.Conflicts}" SelectedValue="{x:Bind ViewModel.ConflictValue, Mode=TwoWay}" Style="{StaticResource OpSoftDropDownStyle}" AutomationProperties.Name="改名同名冲突处理" />
                            </Grid>

                            <!-- Folder Scope (only when folders are selected) -->
                            <StackPanel Spacing="2" Visibility="{x:Bind ViewModel.HasFolderRenameTargets, Mode=OneWay}">
                                <Border Style="{StaticResource OpDividerStyle}" Margin="0,2" />
                                <TextBlock Text="文件夹范围" Style="{StaticResource OpLabelStyle}" />
                                <CheckBox Content="修改文件夹本身名称" FontSize="12" MinHeight="28" IsChecked="{x:Bind ViewModel.RenameFolders, Mode=TwoWay}" />
                                <CheckBox Content="处理文件夹里面的名称" FontSize="12" MinHeight="28" IsChecked="{x:Bind ViewModel.FolderContents, Mode=TwoWay}" />
                                <CheckBox Content="包含更深层子文件夹内容" FontSize="12" MinHeight="28" IsChecked="{x:Bind ViewModel.IncludeSubfolders, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.FolderContents, Mode=OneWay}" />
                            </StackPanel>

                            <!-- In-Place Collapsible Drawer 1: Numbering Step & Sort Tuning -->
                            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.ShowNumbering, Mode=OneWay}">
                                <Border Style="{StaticResource OpDividerStyle}" />
                                <Button x:Name="NumberingTuningButton" Style="{StaticResource OpDisclosureStyle}" Click="ToggleNumberingTuning_Click" AutomationProperties.Name="步长与排序微调">
                                    <Grid ColumnSpacing="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon x:Name="NumberingTuningChevron" Glyph="&#xE76C;" FontSize="10" VerticalAlignment="Center" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="步长与排序微调" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.NumberingTuningSummary, Mode=OneWay}" Style="{StaticResource OpLabelStyle}" TextAlignment="Right" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    </Grid>
                                </Button>
                                <StackPanel x:Name="NumberingTuningBody" Spacing="4" Visibility="Collapsed">
                                    <Grid Style="{StaticResource OpPropertyRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="每次递增" Style="{StaticResource OpLabelStyle}" />
                                        <TextBox Grid.Column="1" Text="{x:Bind ViewModel.Step, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OpSoftTextBoxStyle}" AutomationProperties.Name="每次递增" InputScope="Number" />
                                    </Grid>
                                    <Grid Style="{StaticResource OpPropertyRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="编号顺序" Style="{StaticResource OpLabelStyle}" />
                                        <controls:SelectionDropDown Grid.Column="1" ItemsSource="{x:Bind ViewModel.Orders}" SelectedValue="{x:Bind ViewModel.OrderValue, Mode=TwoWay}" Style="{StaticResource OpSoftDropDownStyle}" AutomationProperties.Name="编号顺序" />
                                    </Grid>
                                    <CheckBox Content="每个磁盘目录重新编号" FontSize="12" MinHeight="28" IsChecked="{x:Bind ViewModel.PerDirectory, Mode=TwoWay}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- In-Place Collapsible Drawer 2: Extra Text Cleaning under Advanced Template -->
                            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsTemplateSubMode, Mode=OneWay}">
                                <Border Style="{StaticResource OpDividerStyle}" />
                                <Button x:Name="ComboCleaningButton" Style="{StaticResource OpDisclosureStyle}" Click="ToggleComboCleaning_Click" AutomationProperties.Name="附加文字清洗">
                                    <Grid ColumnSpacing="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon x:Name="ComboCleaningChevron" Glyph="&#xE76C;" FontSize="10" VerticalAlignment="Center" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="附加文字清洗" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="前后缀 / 替换 / 删除" Style="{StaticResource OpLabelStyle}" TextAlignment="Right" />
                                    </Grid>
                                </Button>
                                <StackPanel x:Name="ComboCleaningBody" Spacing="4" Visibility="Collapsed">
                                    <Grid Style="{StaticResource OpPropertyRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="名称前缀" Style="{StaticResource OpLabelStyle}" />
                                        <TextBox Grid.Column="1" Text="{x:Bind ViewModel.Prefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OpSoftTextBoxStyle}" AutomationProperties.Name="名称前缀" />
                                    </Grid>
                                    <Grid Style="{StaticResource OpPropertyRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="名称后缀" Style="{StaticResource OpLabelStyle}" />
                                        <TextBox Grid.Column="1" Text="{x:Bind ViewModel.Suffix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OpSoftTextBoxStyle}" AutomationProperties.Name="名称后缀" />
                                    </Grid>
                                    <Grid Style="{StaticResource OpPropertyRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="查找文字" Style="{StaticResource OpLabelStyle}" />
                                        <TextBox Grid.Column="1" Text="{x:Bind ViewModel.Find, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OpSoftTextBoxStyle}" AutomationProperties.Name="查找文字" />
                                    </Grid>
                                    <Grid Style="{StaticResource OpPropertyRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="替换为" Style="{StaticResource OpLabelStyle}" />
                                        <TextBox Grid.Column="1" Text="{x:Bind ViewModel.Replacement, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OpSoftTextBoxStyle}" AutomationProperties.Name="替换为" />
                                    </Grid>
                                    <Grid Style="{StaticResource OpPropertyRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="删除文字" Style="{StaticResource OpLabelStyle}" />
                                        <TextBox Grid.Column="1" Text="{x:Bind ViewModel.DeleteText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OpSoftTextBoxStyle}" AutomationProperties.Name="删除文字" />
                                    </Grid>
                                    <Grid Style="{StaticResource OpPropertyRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="删除位置" Style="{StaticResource OpLabelStyle}" />
                                        <TextBox Grid.Column="1" Text="{x:Bind ViewModel.RemoveAt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OpSoftTextBoxStyle}" AutomationProperties.Name="删除位置" InputScope="Number" />
                                    </Grid>
                                    <Grid Style="{StaticResource OpPropertyRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="删除字数" Style="{StaticResource OpLabelStyle}" />
                                        <TextBox Grid.Column="1" Text="{x:Bind ViewModel.RemoveCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OpSoftTextBoxStyle}" AutomationProperties.Name="删除字符数" InputScope="Number" />
                                    </Grid>
                                    <Grid Style="{StaticResource OpPropertyRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="大小写" Style="{StaticResource OpLabelStyle}" />
                                        <controls:SelectionDropDown Grid.Column="1" ItemsSource="{x:Bind ViewModel.Cases}" SelectedValue="{x:Bind ViewModel.CaseValue, Mode=TwoWay}" Style="{StaticResource OpSoftDropDownStyle}" AutomationProperties.Name="组合文字大小写" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- ==================== CREATE MODE (DIRECT OUTLINE WORKFLOW - METHOD A) ==================== -->
                        <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.IsCreate, Mode=OneWay}">
                            <!-- Top Card: Save Location + Conflict Policy -->
                            <Border Style="{StaticResource OpPrimaryCardStyle}" Padding="9,6">
                                <StackPanel Spacing="6">
                                    <Grid Style="{StaticResource OpPropertyRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="保存位置" Style="{StaticResource OpLabelStyle}" />
                                        <Grid Grid.Column="1" CornerRadius="6" Background="{ThemeResource OpSoftBrush}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="30" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="CreateDestinationBox" Text="{x:Bind ViewModel.Destination, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OpSoftTextBoxStyle}" BorderThickness="0" PlaceholderText="选择目标文件夹…" AutomationProperties.Name="保存位置" ToolTipService.ToolTip="{x:Bind ViewModel.Destination, Mode=OneWay}" />
                                            <Button Grid.Column="1" Style="{StaticResource WorkspaceIconButtonStyle}" MinWidth="0" MinHeight="0" Width="30" Height="30" Padding="0" Click="PickDestination_Click" ToolTipService.ToolTip="选择目标文件夹" AutomationProperties.Name="选择目标文件夹">
                                                <FontIcon Glyph="&#xE838;" FontSize="15" Foreground="{ThemeResource WorkspaceCategoryFolderBrush}" />
                                            </Button>
                                        </Grid>
                                    </Grid>
                                    <Border Style="{StaticResource OpDividerStyle}" />
                                    <Grid Style="{StaticResource OpPropertyRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="同名处理" Style="{StaticResource OpLabelStyle}" />
                                        <controls:SelectionDropDown Grid.Column="1" ItemsSource="{x:Bind ViewModel.Conflicts}" SelectedValue="{x:Bind ViewModel.ConflictValue, Mode=TwoWay}" Style="{StaticResource OpSoftDropDownStyle}" AutomationProperties.Name="创建同名冲突处理" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{x:Bind ViewModel.CreationHeading, Mode=OneWay}" Style="{StaticResource OpLabelStyle}" ToolTipService.ToolTip="{x:Bind ViewModel.CreationTargetPaths, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxLines="1" />

                            <!-- Quick Bulk Numbered Generator -> Inserts directly into Center Outline -->
                            <Border CornerRadius="8" Background="{ThemeResource WorkspaceSubtleBrush}" BorderBrush="{ThemeResource OpDividerBrush}" BorderThickness="1" Padding="9,7">
                                <StackPanel Spacing="5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="快速批量编号填入" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3">
                                            <ToggleButton x:Name="BulkKindFolder" Content="文件夹" Tag="0" Click="CreationKind_Click" IsChecked="{x:Bind ViewModel.IsDirectoryCreation, Mode=OneWay}" Style="{StaticResource OpPillToggleStyle}" />
                                            <ToggleButton x:Name="BulkKindFile" Content="文件" Tag="1" Click="CreationKind_Click" IsChecked="{x:Bind ViewModel.IsFileCreation, Mode=OneWay}" Style="{StaticResource OpPillToggleStyle}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Style="{StaticResource OpPropertyRowStyle}" Visibility="{x:Bind ViewModel.IsFileCreation, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="扩展名" Style="{StaticResource OpLabelStyle}" />
                                        <controls:SelectionDropDown x:Name="FileExtensionDropDown" Grid.Column="1" ItemsSource="{x:Bind ViewModel.FileExtensionOptions}" SelectedValue="{x:Bind ViewModel.FileExtensionPresetValue, Mode=TwoWay}" Style="{StaticResource OpSoftDropDownStyle}" AutomationProperties.Name="文件扩展名" />
                                    </Grid>
                                    <Grid Style="{StaticResource OpPropertyRowStyle}" Visibility="{x:Bind ViewModel.IsCustomFileExtension, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="自定义" Style="{StaticResource OpLabelStyle}" />
                                        <TextBox Grid.Column="1" Text="{x:Bind ViewModel.FileExtension, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OpSoftTextBoxStyle}" PlaceholderText="例如：.psd" AutomationProperties.Name="自定义文件扩展名" />
                                    </Grid>
                                    <Grid Style="{StaticResource OpPropertyRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="基础名称" Style="{StaticResource OpLabelStyle}" />
                                        <TextBox x:Name="BulkBaseNameBox" Grid.Column="1" Text="{x:Bind ViewModel.CreateBaseName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OpSoftTextBoxStyle}" AutomationProperties.Name="基础名称" PlaceholderText="例如：项目" />
                                    </Grid>
                                    <Grid Style="{StaticResource OpPropertyRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="生成数量" Style="{StaticResource OpLabelStyle}" />
                                        <TextBox x:Name="BulkCountBox" Grid.Column="1" Text="{x:Bind ViewModel.Count, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OpSoftTextBoxStyle}" AutomationProperties.Name="创建数量" InputScope="Number" />
                                        <Button x:Name="InsertNumberedToOutlineButton" Grid.Column="2" Content="填入大纲" Click="InsertNumberedToOutline_Click" Style="{StaticResource OpPillButtonStyle}" Padding="9,4" ToolTipService.ToolTip="生成编号项并直接填入中央大纲" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Collapsible File Content / Template Options -->
                            <StackPanel Spacing="4">
                                <Button x:Name="FileTemplateToggle" Style="{StaticResource OpDisclosureStyle}" Click="ToggleFileTemplate_Click" AutomationProperties.Name="新建文件默认内容">
                                    <Grid ColumnSpacing="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon x:Name="FileTemplateChevron" Glyph="&#xE76C;" FontSize="10" VerticalAlignment="Center" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="新建文件默认内容" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="空白 / 复制模板" Style="{StaticResource OpLabelStyle}" TextAlignment="Right" />
                                    </Grid>
                                </Button>
                                <StackPanel x:Name="FileTemplateBody" Spacing="4" Visibility="Collapsed">
                                    <Grid Style="{StaticResource OpPropertyRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="内容来源" Style="{StaticResource OpLabelStyle}" />
                                        <controls:SelectionDropDown Grid.Column="1" ItemsSource="{x:Bind ViewModel.FileContents}" SelectedValue="{x:Bind ViewModel.FileContentValue, Mode=TwoWay}" Style="{StaticResource OpSoftDropDownStyle}" AutomationProperties.Name="文件内容来源" />
                                    </Grid>
                                    <Grid Style="{StaticResource OpPropertyRowStyle}" Visibility="{x:Bind ViewModel.IsTemplateCreation, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="模板文件" Style="{StaticResource OpLabelStyle}" />
                                        <Grid Grid.Column="1" CornerRadius="6" Background="{ThemeResource OpSoftBrush}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="30" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{x:Bind ViewModel.Template, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OpSoftTextBoxStyle}" BorderThickness="0" AutomationProperties.Name="模板文件" PlaceholderText="模板路径" ToolTipService.ToolTip="{x:Bind ViewModel.Template, Mode=OneWay}" />
                                            <Button Grid.Column="1" Style="{StaticResource WorkspaceIconButtonStyle}" MinWidth="0" MinHeight="0" Width="30" Height="30" Padding="0" Click="PickTemplate_Click" ToolTipService.ToolTip="选择模板文件" AutomationProperties.Name="选择模板文件">
                                                <FontIcon Glyph="&#xE838;" FontSize="15" Foreground="{ThemeResource WorkspaceCategoryFolderBrush}" />
                                            </Button>
                                        </Grid>
                                    </Grid>
                                    <TextBlock Text="{x:Bind ViewModel.FileContentHint, Mode=OneWay}" Style="{StaticResource WorkspaceCaptionStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="存在同名项目，将按上方「同名处理」规则执行，也可在左侧目录核对。" Visibility="{x:Bind ViewModel.HasCreationConflicts, Mode=OneWay}" Style="{StaticResource WorkspaceCaptionStyle}" TextWrapping="Wrap" />

                            <!-- Live Creation Estimate -->
                            <Border Style="{StaticResource OpPreviewStyle}">
                                <Grid Style="{StaticResource OpPropertyRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="预计生成" Style="{StaticResource OpLabelStyle}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CreationEstimate, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource WorkspaceSuccessBrush}" VerticalAlignment="Center" TextAlignment="Right" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- In-Place Collapsible History & Recovery Drawer (moved cleanly from top toolbar into right panel) -->
                        <StackPanel Spacing="4">
                            <Border Style="{StaticResource OpDividerStyle}" />
                            <Button x:Name="InlineHistoryToggle" Style="{StaticResource OpDisclosureStyle}" Click="ToggleHistory_Click" AutomationProperties.Name="操作记录">
                                <Grid ColumnSpacing="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon x:Name="InlineHistoryChevron" Glyph="&#xE76C;" FontSize="10" VerticalAlignment="Center" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="操作记录" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.HistorySummary, Mode=OneWay}" Style="{StaticResource OpLabelStyle}" TextAlignment="Right" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                </Grid>
                            </Button>
                            <StackPanel x:Name="InlineHistoryBody" Spacing="6" Visibility="Collapsed">
                                <TextBlock Text="改名可恢复原名称；创建可撤销未修改的文件与空文件夹。" FontSize="11.5" TextWrapping="Wrap" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                                <TextBlock Text="暂无可恢复的操作" Visibility="{x:Bind ViewModel.NoRecoveries, Mode=OneWay}" Style="{StaticResource WorkspaceCaptionStyle}" />
                                <ListView ItemsSource="{x:Bind ViewModel.Recoveries, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedRecovery, Mode=TwoWay}" SelectionMode="Single" MaxHeight="220" ItemContainerStyle="{StaticResource WorkspaceListItemStyle}" AutomationProperties.Name="最近操作记录">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="model:NamingRecovery">
                                            <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" Margin="0,4" FontSize="12" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="撤销所选操作" Command="{x:Bind ViewModel.RestoreCommand}" HorizontalAlignment="Stretch" FontSize="12" Padding="10,4" />
                                    <Button Grid.Column="1" Content="刷新" Command="{x:Bind ViewModel.RefreshRecoveriesCommand}" FontSize="12" Padding="10,4" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Result / Progress / History Panels -->
                    <Border Visibility="{x:Bind ViewModel.ShowResultPanel, Mode=OneWay}">
                        <StackPanel Spacing="7">
                            <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="逐项结果显示在中央。创建文件夹时，可点击左侧目录查看其内部结果。" FontSize="12.5" TextWrapping="Wrap" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                            <Button Content="撤销本次" Command="{x:Bind ViewModel.UndoLastCommand}" IsEnabled="{x:Bind ViewModel.CanUndoLast, Mode=OneWay}" HorizontalAlignment="Stretch" />
                            <Border Style="{StaticResource WorkspaceSubtleCardStyle}" Padding="10" Visibility="{x:Bind ViewModel.HasOutputs, Mode=OneWay}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="继续处理本次产物" Style="{StaticResource WorkspaceCaptionStyle}" FontWeight="SemiBold" />
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="用新文件去转换" Click="HandoffToConversion_Click" FontSize="12" Padding="8,5" HorizontalAlignment="Stretch" ToolTipService.ToolTip="将本次改名/创建后的项目送入格式转换" />
                                        <Button Grid.Column="1" Content="用新文件去整理" Click="HandoffToCopy_Click" FontSize="12" Padding="8,5" HorizontalAlignment="Stretch" ToolTipService.ToolTip="将本次改名/创建后的项目送入复制与整理" />
                                    </Grid>
                                    <Button Content="新文件加入暂存区" Click="HandoffToStaging_Click" FontSize="12" Padding="10,5" HorizontalAlignment="Stretch" ToolTipService.ToolTip="将本次改名/创建后的项目加入暂存区" />
                                    <Button Content="查看本次输出" Command="{x:Bind ViewModel.ShowOutputsCommand}" FontSize="12" Padding="10,5" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Visibility="{x:Bind ViewModel.HasProgress, Mode=OneWay}">
                        <StackPanel Spacing="8">
                            <ProgressBar Value="{x:Bind ViewModel.ActiveJob.Progress, Mode=OneWay}" Maximum="100" Foreground="{ThemeResource WorkspaceAccentBrush}" AutomationProperties.Name="批量处理进度" />
                            <TextBlock Text="{x:Bind ViewModel.ActiveJob.Status, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource WorkspaceCaptionStyle}" />
                        </StackPanel>
                    </Border>
                    <StackPanel Spacing="7" Visibility="{x:Bind ViewModel.ShowHistory, Mode=OneWay}">
                        <TextBlock Text="改名可恢复原名称；创建可撤销未修改的文件与空文件夹。" FontSize="12.5" TextWrapping="Wrap" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                        <TextBlock Text="暂无可恢复的操作" Visibility="{x:Bind ViewModel.NoRecoveries, Mode=OneWay}" Style="{StaticResource WorkspaceCaptionStyle}" />
                        <ListView ItemsSource="{x:Bind ViewModel.Recoveries, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedRecovery, Mode=TwoWay}" SelectionMode="Single" MaxHeight="400" AutomationProperties.Name="历史操作记录">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="model:NamingRecovery">
                                    <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" Margin="0,6" FontSize="12.5" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Button Content="撤销所选操作" Command="{x:Bind ViewModel.RestoreCommand}" HorizontalAlignment="Stretch" />
                        <Button Content="刷新记录" Command="{x:Bind ViewModel.RefreshRecoveriesCommand}" HorizontalAlignment="Stretch" />
                        <TextBlock Text="{x:Bind ViewModel.Feedback, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" />
                    </StackPanel>
                </StackPanel>
            </ContentControl>
        </controls:OperationPanel.Body>
        <controls:OperationPanel.Footer>
            <Border Style="{StaticResource OpFooterStyle}" Visibility="{x:Bind ViewModel.ShowActionFooter, Mode=OneWay}">
                <StackPanel Spacing="3">
                    <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsImporting, Mode=OneWay}" AutomationProperties.Name="正在添加文件" />
                    <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}" AutomationProperties.Name="正在检查名称" />
                    <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsSelectingTargets, Mode=OneWay}" AutomationProperties.Name="正在读取目标文件夹" />
                    <Button Content="取消目录选择" Command="{x:Bind ViewModel.CancelTargetSelectionCommand}" Visibility="{x:Bind ViewModel.IsSelectingTargets, Mode=OneWay}" HorizontalAlignment="Right" />
                    <StackPanel Spacing="2" Visibility="{x:Bind ViewModel.ShowMainSettings, Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.NextStep, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasActionMessage, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" Style="{StaticResource WorkspaceCaptionStyle}" ToolTipService.ToolTip="{x:Bind ViewModel.NextStep, Mode=OneWay}" AutomationProperties.LiveSetting="Polite" />
                        <Grid ColumnSpacing="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind ViewModel.FooterCount, Mode=OneWay}" Style="{StaticResource OpLabelStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxLines="1" ToolTipService.ToolTip="{x:Bind ViewModel.ExecutionScope, Mode=OneWay}" AutomationProperties.HelpText="{x:Bind ViewModel.ExecutionScopeText, Mode=OneWay}" />
                            <Button Grid.Column="1" Content="{x:Bind ViewModel.PrimaryActionLabel, Mode=OneWay}" Command="{x:Bind ViewModel.RunCommand}" Style="{StaticResource OpActionStyle}" AutomationProperties.HelpText="{x:Bind ViewModel.RunLabel, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                    <Grid Visibility="{x:Bind ViewModel.ShowResultPanel, Mode=OneWay}" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="继续设置" Command="{x:Bind ViewModel.ContinueEditingCommand}" HorizontalAlignment="Left" />
                        <Button Grid.Column="1" Content="重试未完成项" Command="{x:Bind ViewModel.RetryCommand}" Visibility="{x:Bind ViewModel.CanRetry, Mode=OneWay}" Style="{StaticResource OpActionStyle}" />
                    </Grid>
                    <Button Content="取消处理" Command="{x:Bind ViewModel.CancelCommand}" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" HorizontalAlignment="Right" />
                    <Button Content="取消添加" Command="{x:Bind ViewModel.Input.CancelLoadingCommand}" Visibility="{x:Bind ViewModel.CanCancelImport, Mode=OneWay}" HorizontalAlignment="Right" />
                </StackPanel>
            </Border>
        </controls:OperationPanel.Footer>
    </controls:OperationPanel>
</UserControl>
