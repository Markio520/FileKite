<UserControl
    x:Class="FileAssistant.App.Features.Organize.CopyOptionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FileAssistant.App.Controls"
    xmlns:copy="using:FileAssistant.Core.Features.Organize"
    xmlns:local="using:FileAssistant.App.Features.Organize">
    <UserControl.Resources>
        <Style x:Key="ConflictRow" TargetType="ListViewItem" BasedOn="{StaticResource WorkspaceListItemStyle}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,1" />
        </Style>

        <DataTemplate x:Key="PlanRow" x:DataType="copy:CopyPlanItem">
            <StackPanel Spacing="3" Margin="0,4">
                <TextBlock Text="{x:Bind Description}" Style="{StaticResource WorkspaceSectionLabelStyle}" />
                <TextBlock Text="{x:Bind Paths}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource WorkspaceCaptionStyle}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ResultRow" x:DataType="copy:CopyItemResult">
            <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" Margin="0,5" IsTextSelectionEnabled="True" FontSize="12" />
        </DataTemplate>

        <!-- Top Segmented Operation Button (Copy vs Move) -->
        <Style x:Key="OperationSegmentButtonStyle" TargetType="ToggleButton">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="27" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Foreground" Value="{ThemeResource WorkspaceSecondaryBrush}" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualMargin" Value="-1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="SegRoot"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="SegRoot.Background" Value="{ThemeResource WorkspaceHoverBrush}" />
                                            <Setter Target="SegText.Foreground" Value="{ThemeResource WorkspaceTextBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="SegRoot.Background" Value="{ThemeResource WorkspaceHoverBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="SegRoot.Background" Value="{ThemeResource OpChoiceBrush}" />
                                            <Setter Target="SegRoot.BorderBrush" Value="{ThemeResource WorkspaceBorderBrush}" />
                                            <Setter Target="SegText.Foreground" Value="{ThemeResource WorkspaceTextBrush}" />
                                            <Setter Target="SegText.FontWeight" Value="SemiBold" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="SegRoot.Background" Value="{ThemeResource OpChoiceBrush}" />
                                            <Setter Target="SegRoot.BorderBrush" Value="{ThemeResource WorkspaceBorderBrush}" />
                                            <Setter Target="SegText.Foreground" Value="{ThemeResource WorkspaceTextBrush}" />
                                            <Setter Target="SegText.FontWeight" Value="SemiBold" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="SegRoot.Background" Value="{ThemeResource WorkspaceHoverBrush}" />
                                            <Setter Target="SegRoot.BorderBrush" Value="{ThemeResource WorkspaceBorderBrush}" />
                                            <Setter Target="SegText.Foreground" Value="{ThemeResource WorkspaceTextBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="SegRoot.Opacity" Value="0.42" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter
                                x:Name="SegText"
                                Content="{TemplateBinding Content}"
                                FontSize="{TemplateBinding FontSize}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Progressive Sub-Option Pill Chip Style (matches user's approved screenshot) -->
        <Style x:Key="OrganizeSubChipStyle" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="25" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{ThemeResource WorkspaceSecondaryBrush}" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualMargin" Value="-1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="ChipBody"
                            Background="{ThemeResource OpSoftBrush}"
                            BorderBrush="{ThemeResource WorkspaceBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="ChipBody.Background" Value="{ThemeResource OpSoftHoverBrush}" />
                                            <Setter Target="ChipText.Foreground" Value="{ThemeResource WorkspaceTextBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="ChipBody.Background" Value="{ThemeResource WorkspaceHoverBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="ChipBody.Background" Value="{ThemeResource WorkspaceAccentBrush}" />
                                            <Setter Target="ChipBody.BorderBrush" Value="{ThemeResource WorkspaceAccentBrush}" />
                                            <Setter Target="ChipText.Foreground" Value="{ThemeResource WorkspaceOnAccentBrush}" />
                                            <Setter Target="ChipText.FontWeight" Value="SemiBold" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="ChipBody.Background" Value="{ThemeResource AccentButtonBackgroundPointerOver}" />
                                            <Setter Target="ChipBody.BorderBrush" Value="{ThemeResource AccentButtonBackgroundPointerOver}" />
                                            <Setter Target="ChipText.Foreground" Value="{ThemeResource WorkspaceOnAccentBrush}" />
                                            <Setter Target="ChipText.FontWeight" Value="SemiBold" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="ChipBody.Background" Value="{ThemeResource AccentButtonBackgroundPressed}" />
                                            <Setter Target="ChipBody.BorderBrush" Value="{ThemeResource AccentButtonBackgroundPressed}" />
                                            <Setter Target="ChipText.Foreground" Value="{ThemeResource WorkspaceOnAccentBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="ChipBody.Opacity" Value="0.45" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter
                                x:Name="ChipText"
                                Content="{TemplateBinding Content}"
                                FontSize="{TemplateBinding FontSize}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Symmetrical Layout Radio Header Style -->
        <Style x:Key="DirectoryChoiceStyle" TargetType="RadioButton">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="Row" CornerRadius="6" Padding="9,6" ColumnSpacing="8" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                            </Grid.ColumnDefinitions>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Hover.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Hover.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Row.Opacity" Value="0.48" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Presenter.Foreground" Value="{ThemeResource OpChoiceTextBrush}" />
                                            <Setter Target="Hover.Opacity" Value="0" />
                                            <Setter Target="Ring.Fill" Value="{ThemeResource WorkspaceAccentBrush}" />
                                            <Setter Target="Ring.Stroke" Value="{ThemeResource WorkspaceAccentBrush}" />
                                            <Setter Target="Dot.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border
                                x:Name="Hover"
                                Grid.ColumnSpan="2"
                                Margin="-9,-6"
                                Background="{ThemeResource WorkspaceHoverBrush}"
                                CornerRadius="6"
                                Opacity="0"
                                IsHitTestVisible="False" />
                            <ContentPresenter
                                x:Name="Presenter"
                                Foreground="{ThemeResource WorkspaceTextBrush}"
                                Content="{TemplateBinding Content}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center" />
                            <Grid Grid.Column="1" Width="14" Height="14" VerticalAlignment="Center">
                                <Ellipse x:Name="Ring" Stroke="{ThemeResource WorkspaceSecondaryBrush}" StrokeThickness="1.4" />
                                <Ellipse x:Name="Dot" Width="4.5" Height="4.5" Fill="{ThemeResource WorkspaceOnAccentBrush}" Opacity="0" />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactSubCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="6,2,0,2" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
    </UserControl.Resources>

    <controls:OperationPanel x:Name="Panel" IsCompact="True">
        <controls:OperationPanel.Body>
            <Grid>
                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowSettings, Mode=OneWay}">
                    <!-- Top Action Switcher: Copy (Default) vs Move (Explicit) -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            controls:WorkspaceLocalization.Text="操作"
                            Style="{StaticResource OpLabelStyle}"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />
                        <Border
                            Grid.Column="1"
                            Background="{ThemeResource WorkspaceSubtleBrush}"
                            BorderBrush="{ThemeResource WorkspaceBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="2">
                            <Grid ColumnSpacing="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ToggleButton
                                    controls:WorkspaceLocalization.Content="复制"
                                    Style="{StaticResource OperationSegmentButtonStyle}"
                                    IsChecked="{x:Bind ViewModel.IsCopyOperation, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                    Click="SelectCopyOperation_Click"
                                    controls:WorkspaceLocalization.Name="复制文件" />
                                <ToggleButton
                                    Grid.Column="1"
                                    controls:WorkspaceLocalization.Content="移动"
                                    Style="{StaticResource OperationSegmentButtonStyle}"
                                    IsChecked="{x:Bind ViewModel.IsMoveOperation, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.CanSelectMove, Mode=OneWay}"
                                    Click="SelectMoveOperation_Click"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.MoveDisabledTip, Mode=OneWay}"
                                    controls:WorkspaceLocalization.Name="移动文件" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Destination Folder -->
                    <StackPanel Spacing="4">
                        <TextBlock
                            controls:WorkspaceLocalization.Text="目标文件夹"
                            Style="{StaticResource OpLabelStyle}"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />
                        <Grid
                            CornerRadius="6"
                            Background="{ThemeResource OpSoftBrush}"
                            BorderBrush="{ThemeResource WorkspaceBorderBrush}"
                            BorderThickness="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="DestinationBox"
                                Style="{StaticResource OpSoftTextBoxStyle}"
                                BorderThickness="0"
                                Text="{x:Bind ViewModel.Destination, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="{x:Bind ViewModel.DestinationPlaceholder, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.Destination, Mode=OneWay}"
                                controls:WorkspaceLocalization.Name="复制或整理目标目录" />
                            <Button
                                Grid.Column="1"
                                Style="{StaticResource WorkspaceIconButtonStyle}"
                                MinWidth="0"
                                MinHeight="0"
                                Width="30"
                                Height="30"
                                Padding="0"
                                Click="PickDestination_Click"
                                IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                controls:WorkspaceLocalization.Tip="选择目标文件夹"
                                controls:WorkspaceLocalization.Name="选择目标文件夹">
                                <FontIcon Glyph="&#xE838;" FontSize="15" Foreground="{ThemeResource WorkspaceCategoryFolderBrush}" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <Border Style="{StaticResource OpDividerStyle}" />

                    <!-- 4 Symmetrical Layout Choices -->
                    <TextBlock
                        controls:WorkspaceLocalization.Text="文件怎么放"
                        Style="{StaticResource OpLabelStyle}"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center" />

                    <StackPanel Spacing="4">
                        <!-- 1. Preserve -->
                        <Border x:Name="CardPreserve" CornerRadius="7" BorderThickness="1" BorderBrush="Transparent">
                            <RadioButton
                                Tag="0"
                                GroupName="CopyDirectoryLayout"
                                Style="{StaticResource DirectoryChoiceStyle}"
                                IsChecked="{x:Bind ViewModel.IsLayoutPreserve, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                Checked="LayoutChoice_Checked"
                                controls:WorkspaceLocalization.Name="照原样放"
                                controls:WorkspaceLocalization.Tip="单文件直接放入；文件夹保留原有子目录层级">
                                <StackPanel Spacing="1">
                                    <TextBlock controls:WorkspaceLocalization.Text="照原样放" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock controls:WorkspaceLocalization.Text="单文件直接放入；文件夹保留原有子目录层级" FontSize="11" Foreground="{ThemeResource WorkspaceSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                        </Border>

                        <!-- 2. Gather from Subfolders -->
                        <Border x:Name="CardGather" CornerRadius="7" BorderThickness="1" BorderBrush="Transparent">
                            <StackPanel>
                                <RadioButton
                                    Tag="1"
                                    GroupName="CopyDirectoryLayout"
                                    Style="{StaticResource DirectoryChoiceStyle}"
                                    IsChecked="{x:Bind ViewModel.IsLayoutFlat, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                    Checked="LayoutChoice_Checked"
                                    controls:WorkspaceLocalization.Name="把子文件夹里的文件放到一起"
                                    controls:WorkspaceLocalization.Tip="取消子目录层级，统一汇总到同一层">
                                    <StackPanel Spacing="1">
                                        <TextBlock controls:WorkspaceLocalization.Text="把子文件夹里的文件放到一起" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock controls:WorkspaceLocalization.Text="取消子目录层级，统一汇总到同一层" FontSize="11" Foreground="{ThemeResource WorkspaceSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </RadioButton>

                                <StackPanel
                                    Spacing="6"
                                    Padding="9,0,9,8"
                                    Visibility="{x:Bind ViewModel.IsLayoutFlat, Mode=OneWay}">
                                    <Border Style="{StaticResource OpDividerStyle}" Margin="0,0,0,2" />
                                    <StackPanel Spacing="4">
                                        <TextBlock controls:WorkspaceLocalization.Text="取哪些文件：" FontSize="11.5" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                                        <local:OrganizeWrapPanel HorizontalGap="5" VerticalGap="5">
                                            <ToggleButton
                                                Tag="All"
                                                controls:WorkspaceLocalization.Content="全部"
                                                Style="{StaticResource OrganizeSubChipStyle}"
                                                IsChecked="{x:Bind ViewModel.IsGatherAll, Mode=OneWay}"
                                                IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                                Click="GatherFilter_Click" />
                                            <ToggleButton
                                                Tag="DocumentsAndSheets"
                                                controls:WorkspaceLocalization.Content="仅文档/表格"
                                                Style="{StaticResource OrganizeSubChipStyle}"
                                                IsChecked="{x:Bind ViewModel.IsGatherDocs, Mode=OneWay}"
                                                IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                                Click="GatherFilter_Click" />
                                            <ToggleButton
                                                Tag="Images"
                                                controls:WorkspaceLocalization.Content="仅图片"
                                                Style="{StaticResource OrganizeSubChipStyle}"
                                                IsChecked="{x:Bind ViewModel.IsGatherImages, Mode=OneWay}"
                                                IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                                Click="GatherFilter_Click" />
                                        </local:OrganizeWrapPanel>
                                    </StackPanel>
                                    <CheckBox
                                        Style="{StaticResource CompactSubCheckBoxStyle}"
                                        IsChecked="{x:Bind ViewModel.GatherPrefixSourceFolder, Mode=TwoWay}"
                                        IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}">
                                        <TextBlock
                                            controls:WorkspaceLocalization.Text="多目录撞名时加上来源文件夹名（如：华东区_汇总表）"
                                            FontSize="11.5"
                                            TextWrapping="Wrap" />
                                    </CheckBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 3. Auto Classify into Folders (Matches User's Screenshot) -->
                        <Border x:Name="CardClassify" CornerRadius="7" BorderThickness="1" BorderBrush="Transparent">
                            <StackPanel>
                                <RadioButton
                                    Tag="3"
                                    GroupName="CopyDirectoryLayout"
                                    Style="{StaticResource DirectoryChoiceStyle}"
                                    IsChecked="{x:Bind ViewModel.IsLayoutClassify, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                    Checked="LayoutChoice_Checked"
                                    controls:WorkspaceLocalization.Name="自动分类建文件夹"
                                    controls:WorkspaceLocalization.Tip="按类型、日期、文件名对号入座，可叠加两层">
                                    <StackPanel Spacing="1">
                                        <TextBlock controls:WorkspaceLocalization.Text="自动分类建文件夹" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock controls:WorkspaceLocalization.Text="按类型、日期、文件名对号入座，可叠加两层" FontSize="11" Foreground="{ThemeResource WorkspaceSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </RadioButton>

                                <StackPanel
                                    Spacing="6"
                                    Padding="9,0,9,8"
                                    Visibility="{x:Bind ViewModel.IsLayoutClassify, Mode=OneWay}">
                                    <Border Style="{StaticResource OpDividerStyle}" Margin="0,0,0,2" />

                                    <StackPanel Spacing="4">
                                        <TextBlock controls:WorkspaceLocalization.Text="按什么分：" FontSize="11.5" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                                        <local:OrganizeWrapPanel HorizontalGap="5" VerticalGap="5">
                                            <ToggleButton
                                                Tag="FileType"
                                                controls:WorkspaceLocalization.Content="文件类型"
                                                Style="{StaticResource OrganizeSubChipStyle}"
                                                IsChecked="{x:Bind ViewModel.IsClassifyByType, Mode=OneWay}"
                                                IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                                Click="ClassifyBy_Click" />
                                            <ToggleButton
                                                Tag="Date"
                                                controls:WorkspaceLocalization.Content="日期"
                                                Style="{StaticResource OrganizeSubChipStyle}"
                                                IsChecked="{x:Bind ViewModel.IsClassifyByDate, Mode=OneWay}"
                                                IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                                Click="ClassifyBy_Click" />
                                            <ToggleButton
                                                Tag="NameMatch"
                                                controls:WorkspaceLocalization.Content="文件名对号入座"
                                                Style="{StaticResource OrganizeSubChipStyle}"
                                                IsChecked="{x:Bind ViewModel.IsClassifyByNameMatch, Mode=OneWay}"
                                                IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                                Click="ClassifyBy_Click" />
                                            <ToggleButton
                                                Tag="Extension"
                                                controls:WorkspaceLocalization.Content="后缀名"
                                                Style="{StaticResource OrganizeSubChipStyle}"
                                                IsChecked="{x:Bind ViewModel.IsClassifyByExtension, Mode=OneWay}"
                                                IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                                Click="ClassifyBy_Click" />
                                        </local:OrganizeWrapPanel>
                                    </StackPanel>

                                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.ShowNameMatchRule, Mode=OneWay}">
                                        <TextBlock controls:WorkspaceLocalization.Text="匹配规则：" FontSize="11.5" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                                        <local:OrganizeWrapPanel HorizontalGap="5" VerticalGap="5">
                                            <ToggleButton
                                                Tag="ExistingFolderFirst"
                                                controls:WorkspaceLocalization.Content="归入已有同名夹"
                                                Style="{StaticResource OrganizeSubChipStyle}"
                                                IsChecked="{x:Bind ViewModel.IsNameMatchExisting, Mode=OneWay}"
                                                IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                                Click="NameMatchRule_Click" />
                                            <ToggleButton
                                                Tag="PrefixAlways"
                                                controls:WorkspaceLocalization.Content="按「- / _」前缀建夹"
                                                Style="{StaticResource OrganizeSubChipStyle}"
                                                IsChecked="{x:Bind ViewModel.IsNameMatchPrefix, Mode=OneWay}"
                                                IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                                Click="NameMatchRule_Click" />
                                        </local:OrganizeWrapPanel>
                                    </StackPanel>

                                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.ShowDateGranularity, Mode=OneWay}">
                                        <TextBlock controls:WorkspaceLocalization.Text="日期粒度：" FontSize="11.5" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                                        <local:OrganizeWrapPanel HorizontalGap="5" VerticalGap="5">
                                            <ToggleButton
                                                Tag="YearMonth"
                                                controls:WorkspaceLocalization.Content="按年月 (2026-11)"
                                                Style="{StaticResource OrganizeSubChipStyle}"
                                                IsChecked="{x:Bind ViewModel.IsDateYearMonth, Mode=OneWay}"
                                                IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                                Click="DateGranularity_Click" />
                                            <ToggleButton
                                                Tag="Year"
                                                controls:WorkspaceLocalization.Content="按年份 (2026年)"
                                                Style="{StaticResource OrganizeSubChipStyle}"
                                                IsChecked="{x:Bind ViewModel.IsDateYear, Mode=OneWay}"
                                                IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                                Click="DateGranularity_Click" />
                                        </local:OrganizeWrapPanel>
                                    </StackPanel>

                                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.ShowSubDateLayer, Mode=OneWay}">
                                        <TextBlock controls:WorkspaceLocalization.Text="再细分一层：" FontSize="11.5" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                                        <local:OrganizeWrapPanel HorizontalGap="5" VerticalGap="5">
                                            <ToggleButton
                                                Tag="None"
                                                controls:WorkspaceLocalization.Content="不细分"
                                                Style="{StaticResource OrganizeSubChipStyle}"
                                                IsChecked="{x:Bind ViewModel.IsSubDateNone, Mode=OneWay}"
                                                IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                                Click="SubDateLayer_Click" />
                                            <ToggleButton
                                                Tag="YearMonth"
                                                controls:WorkspaceLocalization.Content="+ 按年月"
                                                Style="{StaticResource OrganizeSubChipStyle}"
                                                IsChecked="{x:Bind ViewModel.IsSubDateYearMonth, Mode=OneWay}"
                                                IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                                Click="SubDateLayer_Click" />
                                            <ToggleButton
                                                Tag="Year"
                                                controls:WorkspaceLocalization.Content="+ 按年份"
                                                Style="{StaticResource OrganizeSubChipStyle}"
                                                IsChecked="{x:Bind ViewModel.IsSubDateYear, Mode=OneWay}"
                                                IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                                Click="SubDateLayer_Click" />
                                        </local:OrganizeWrapPanel>
                                    </StackPanel>

                                    <CheckBox
                                        Style="{StaticResource CompactSubCheckBoxStyle}"
                                        Visibility="{x:Bind ViewModel.ShowPreferMediaDate, Mode=OneWay}"
                                        IsChecked="{x:Bind ViewModel.PreferMediaDate, Mode=TwoWay}"
                                        IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}">
                                        <TextBlock
                                            controls:WorkspaceLocalization.Text="照片/视频优先按真实拍摄时间（防微信保存日期错乱）"
                                            FontSize="11.5"
                                            TextWrapping="Wrap" />
                                    </CheckBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 4. Copy Empty Folder Structure Only -->
                        <Border x:Name="CardSkeleton" CornerRadius="7" BorderThickness="1" BorderBrush="Transparent">
                            <StackPanel>
                                <RadioButton
                                    Tag="4"
                                    GroupName="CopyDirectoryLayout"
                                    Style="{StaticResource DirectoryChoiceStyle}"
                                    IsChecked="{x:Bind ViewModel.IsLayoutSkeleton, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.CanSelectSkeleton, Mode=OneWay}"
                                    Checked="LayoutChoice_Checked"
                                    controls:WorkspaceLocalization.Name="只复制空文件夹结构"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.SkeletonSubtitle, Mode=OneWay}">
                                    <StackPanel Spacing="1">
                                        <TextBlock controls:WorkspaceLocalization.Text="只复制空文件夹结构" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind ViewModel.SkeletonSubtitle, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource WorkspaceSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </RadioButton>

                                <StackPanel
                                    Spacing="6"
                                    Padding="9,0,9,8"
                                    Visibility="{x:Bind ViewModel.IsLayoutSkeleton, Mode=OneWay}">
                                    <Border Style="{StaticResource OpDividerStyle}" Margin="0,0,0,2" />
                                    <CheckBox
                                        Style="{StaticResource CompactSubCheckBoxStyle}"
                                        IsChecked="{x:Bind ViewModel.ReplaceSkeletonText, Mode=TwoWay}"
                                        IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}">
                                        <TextBlock
                                            controls:WorkspaceLocalization.Text="顺手替换文件夹名里的月份/文字："
                                            FontSize="11.5"
                                            TextWrapping="Wrap" />
                                    </CheckBox>
                                    <Grid ColumnSpacing="6" Visibility="{x:Bind ViewModel.ReplaceSkeletonText, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            Style="{StaticResource OpSoftTextBoxStyle}"
                                            MinHeight="28"
                                            Padding="7,4"
                                            FontSize="11.5"
                                            BorderBrush="{ThemeResource WorkspaceBorderBrush}"
                                            PlaceholderText="2026-10"
                                            Text="{x:Bind ViewModel.SkeletonFind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            controls:WorkspaceLocalization.Name="要替换的原文件夹词" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="→"
                                            FontSize="12"
                                            Foreground="{ThemeResource WorkspaceSecondaryBrush}"
                                            VerticalAlignment="Center" />
                                        <TextBox
                                            Grid.Column="2"
                                            Style="{StaticResource OpSoftTextBoxStyle}"
                                            MinHeight="28"
                                            Padding="7,4"
                                            FontSize="11.5"
                                            BorderBrush="{ThemeResource WorkspaceBorderBrush}"
                                            PlaceholderText="2026-11"
                                            Text="{x:Bind ViewModel.SkeletonReplace, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            controls:WorkspaceLocalization.Name="替换后的新文件夹词" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Style="{StaticResource OpDividerStyle}" />

                    <!-- Conflict Policy -->
                    <Grid Style="{StaticResource OpPropertyRowStyle}" Visibility="{x:Bind ViewModel.ShowConflictRow, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock controls:WorkspaceLocalization.Text="遇到同名" Style="{StaticResource OpLabelStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <controls:SelectionDropDown
                            Grid.Column="1"
                            Style="{StaticResource OpSoftDropDownStyle}"
                            BorderBrush="{ThemeResource WorkspaceBorderBrush}"
                            ItemsSource="{x:Bind ViewModel.Conflicts}"
                            SelectedValue="{x:Bind ViewModel.ConflictValue, Mode=TwoWay}"
                            HorizontalAlignment="Stretch"
                            controls:WorkspaceLocalization.Name="同名冲突处理方式"
                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" />
                    </Grid>

                    <!-- Inline Pending Decision Card -->
                    <Border
                        Style="{StaticResource WorkspaceSubtleCardStyle}"
                        Padding="10,8"
                        Visibility="{x:Bind ViewModel.HasPendingItems, Mode=OneWay}">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon
                                    Glyph="&#xE7BA;"
                                    FontSize="14"
                                    Foreground="{ThemeResource WorkspaceAccentBrush}"
                                    VerticalAlignment="Center" />
                                <TextBlock controls:WorkspaceLocalization.Text="同名文件待确认" Style="{StaticResource WorkspaceSectionLabelStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <ListView
                                ItemsSource="{x:Bind ViewModel.PendingItems, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedPlanItem, Mode=TwoWay}"
                                SelectionMode="Single"
                                MaxHeight="84"
                                Padding="0"
                                ItemContainerStyle="{StaticResource ConflictRow}"
                                controls:WorkspaceLocalization.Name="待确认冲突">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="copy:CopyPlanItem">
                                        <TextBlock
                                            Text="{x:Bind Description}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind Paths}"
                                            FontSize="12.5" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.HasDecision, Mode=OneWay}">
                                <TextBlock
                                    Text="{x:Bind ViewModel.SelectedPlanNote, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Style="{StaticResource WorkspaceCaptionStyle}" />
                                <Button controls:WorkspaceLocalization.Content="核对来源与目标" FontSize="12" Padding="9,4" HorizontalAlignment="Left">
                                    <Button.Flyout>
                                        <Flyout Placement="Left">
                                            <StackPanel Width="310" Spacing="5">
                                                <TextBlock controls:WorkspaceLocalization.Text="来源" Style="{StaticResource WorkspaceSectionLabelStyle}" />
                                                <TextBlock
                                                    Text="{x:Bind ViewModel.SelectedPlanSource, Mode=OneWay}"
                                                    TextWrapping="Wrap"
                                                    IsTextSelectionEnabled="True"
                                                    FontSize="12" />
                                                <TextBlock controls:WorkspaceLocalization.Text="目标" Style="{StaticResource WorkspaceSectionLabelStyle}" />
                                                <TextBlock
                                                    Text="{x:Bind ViewModel.SelectedPlanTarget, Mode=OneWay}"
                                                    TextWrapping="Wrap"
                                                    IsTextSelectionEnabled="True"
                                                    FontSize="12" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        controls:WorkspaceLocalization.Content="编号保留"
                                        Tag="Number"
                                        Click="Decide_Click"
                                        HorizontalAlignment="Stretch"
                                        controls:WorkspaceLocalization.Name="编号保留两个文件"
                                        controls:WorkspaceLocalization.Tip="自动编号，保留两个文件" />
                                    <Button Grid.Column="1" controls:WorkspaceLocalization.Content="跳过此项" Tag="Skip" Click="Decide_Click" HorizontalAlignment="Stretch" />
                                </Grid>
                                <Button
                                    controls:WorkspaceLocalization.Content="确认覆盖并保留备份"
                                    Tag="Overwrite"
                                    Click="Decide_Click"
                                    HorizontalAlignment="Stretch"
                                    IsEnabled="{x:Bind ViewModel.CanApproveOverwrite, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Plan Summary + Details + Refresh -->
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="{x:Bind ViewModel.PlanSummary, Mode=OneWay}"
                            FontSize="12"
                            Style="{StaticResource WorkspaceCaptionStyle}"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="{x:Bind ViewModel.PlanSummary, Mode=OneWay}" />
                        <Button
                            Grid.Column="1"
                            controls:WorkspaceLocalization.Content="明细"
                            controls:WorkspaceLocalization.Name="查看计划明细"
                            FontSize="12"
                            Padding="9,4"
                            HorizontalAlignment="Right"
                            Visibility="{x:Bind ViewModel.HasPlan, Mode=OneWay}">
                            <Button.Flyout>
                                <Flyout Placement="Left">
                                    <ListView
                                        ItemsSource="{x:Bind ViewModel.PlanItems, Mode=OneWay}"
                                        ItemTemplate="{StaticResource PlanRow}"
                                        SelectionMode="None"
                                        Width="340"
                                        MaxHeight="360"
                                        Padding="0"
                                        controls:WorkspaceLocalization.Name="整理计划明细" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button
                            Grid.Column="2"
                            Command="{x:Bind ViewModel.BuildPlanCommand}"
                            Style="{StaticResource WorkspaceIconButtonStyle}"
                            controls:WorkspaceLocalization.Name="刷新整理计划"
                            controls:WorkspaceLocalization.Tip="重新检查文件和目标路径">
                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                        </Button>
                    </Grid>

                    <TextBlock
                        Text="{x:Bind ViewModel.Feedback, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasPlanNotice, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Style="{StaticResource WorkspaceCaptionStyle}"
                        IsTextSelectionEnabled="True"
                        AutomationProperties.LiveSetting="Polite" />

                    <Border Style="{StaticResource OpDividerStyle}" />

                    <!-- Recovery & Previous Result Disclosures -->
                    <Button
                        Style="{StaticResource OpDisclosureStyle}"
                        Command="{x:Bind ViewModel.OpenRecoveryCommand}"
                        IsEnabled="{x:Bind ViewModel.CanChangePanel, Mode=OneWay}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind ViewModel.RecoveryDisclosureLabel, Mode=OneWay}" VerticalAlignment="Center" FontSize="12" />
                            <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="11" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button
                        Style="{StaticResource OpDisclosureStyle}"
                        Command="{x:Bind ViewModel.ShowLastResultCommand}"
                        Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.CanChangePanel, Mode=OneWay}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock controls:WorkspaceLocalization.Text="上次结果" VerticalAlignment="Center" FontSize="12" />
                            <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="11" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button
                        controls:WorkspaceLocalization.Content="清除全部勾选"
                        Command="{x:Bind ViewModel.ClearSelectionCommand}"
                        Visibility="{x:Bind ViewModel.Input.HasSelection, Mode=OneWay}"
                        HorizontalAlignment="Left" />
                </StackPanel>

                <!-- Progress Panel -->
                <Border Visibility="{x:Bind ViewModel.ShowProgress, Mode=OneWay}">
                    <StackPanel Spacing="10">
                        <ProgressBar
                            Value="{x:Bind ViewModel.ActiveJob.Progress, Mode=OneWay}"
                            Maximum="100"
                            Foreground="{ThemeResource WorkspaceAccentBrush}"
                            controls:WorkspaceLocalization.Name="处理进度" />
                        <TextBlock
                            Text="{x:Bind ViewModel.ActiveJob.Status, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Style="{StaticResource WorkspaceCaptionStyle}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.Feedback, Mode=OneWay}"
                            TextWrapping="Wrap"
                            FontSize="12.5"
                            AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>

                <!-- Results Panel -->
                <Border Visibility="{x:Bind ViewModel.ShowResults, Mode=OneWay}">
                    <StackPanel Spacing="10">
                        <TextBlock
                            Text="{x:Bind ViewModel.ResultSummary, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Style="{StaticResource WorkspaceSectionLabelStyle}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.ResultFeedback, Mode=OneWay}"
                            TextWrapping="Wrap"
                            FontSize="12.5"
                            AutomationProperties.LiveSetting="Polite" />
                        <Button
                            controls:WorkspaceLocalization.Content="查看结果明细"
                            FontSize="12"
                            Padding="9,4"
                            HorizontalAlignment="Left"
                            Visibility="{x:Bind ViewModel.HasResultItems, Mode=OneWay}">
                            <Button.Flyout>
                                <Flyout Placement="Left">
                                    <ListView
                                        ItemsSource="{x:Bind ViewModel.ResultItems, Mode=OneWay}"
                                        ItemTemplate="{StaticResource ResultRow}"
                                        SelectionMode="None"
                                        Width="340"
                                        MaxHeight="360"
                                        Padding="0"
                                        controls:WorkspaceLocalization.Name="处理结果明细" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Border
                            Style="{StaticResource WorkspaceSubtleCardStyle}"
                            Padding="10"
                            Visibility="{x:Bind ViewModel.HasOutputs, Mode=OneWay}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    controls:WorkspaceLocalization.Text="继续处理本次产物"
                                    Style="{StaticResource WorkspaceCaptionStyle}"
                                    FontWeight="SemiBold" />
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        controls:WorkspaceLocalization.Content="用新文件去改名"
                                        Click="HandoffToNaming_Click"
                                        FontSize="12"
                                        Padding="8,5"
                                        HorizontalAlignment="Stretch"
                                        controls:WorkspaceLocalization.Tip="将本次整理后的文件送入批量改名" />
                                    <Button
                                        Grid.Column="1"
                                        controls:WorkspaceLocalization.Content="用新文件去转换"
                                        Click="HandoffToConversion_Click"
                                        FontSize="12"
                                        Padding="8,5"
                                        HorizontalAlignment="Stretch"
                                        controls:WorkspaceLocalization.Tip="将本次整理后的文件送入格式转换" />
                                </Grid>
                                <Button
                                    controls:WorkspaceLocalization.Content="新文件加入暂存区"
                                    Click="HandoffToStaging_Click"
                                    FontSize="12"
                                    Padding="10,5"
                                    HorizontalAlignment="Stretch"
                                    controls:WorkspaceLocalization.Tip="将本次整理后的文件加入暂存区，方便后续跨模块复用" />
                                <Button
                                    controls:WorkspaceLocalization.Content="查看本次输出"
                                    Command="{x:Bind ViewModel.ShowOutputsCommand}"
                                    FontSize="12"
                                    Padding="10,5"
                                    HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Border>
                        <Button
                            Content="{x:Bind ViewModel.RecoveryDisclosureLabel, Mode=OneWay}"
                            Command="{x:Bind ViewModel.OpenRecoveryCommand}"
                            IsEnabled="{x:Bind ViewModel.CanChangePanel, Mode=OneWay}"
                            HorizontalAlignment="Stretch" />
                        <Button
                            controls:WorkspaceLocalization.Content="重新检查未完成项"
                            Command="{x:Bind ViewModel.RetryCommand}"
                            Visibility="{x:Bind ViewModel.CanRetry, Mode=OneWay}"
                            HorizontalAlignment="Left" />
                        <ProgressBar
                            IsIndeterminate="True"
                            Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                            controls:WorkspaceLocalization.Name="正在检查未完成项" />
                    </StackPanel>
                </Border>

                <!-- Recovery & Move Undo Panel -->
                <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.ShowRecovery, Mode=OneWay}">
                    <Button controls:WorkspaceLocalization.Content="刷新恢复记录" Command="{x:Bind ViewModel.RefreshRecoveriesCommand}" HorizontalAlignment="Left" />
                    <TextBlock
                        controls:WorkspaceLocalization.Text="暂无移动撤回或覆盖备份记录"
                        Visibility="{x:Bind ViewModel.NoRecoveries, Mode=OneWay}"
                        Style="{StaticResource WorkspaceCaptionStyle}" />
                    <ListView
                        x:Name="RecoveryList"
                        ItemsSource="{x:Bind ViewModel.Recoveries, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedRecovery, Mode=TwoWay}"
                        MaxHeight="240"
                        SelectionMode="Single"
                        Padding="0"
                        ItemContainerStyle="{StaticResource WorkspaceListItemStyle}"
                        controls:WorkspaceLocalization.Name="撤回移动与覆盖恢复记录">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="copy:CopyRecovery">
                                <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" FontSize="12" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button
                        x:Name="RestoreButton"
                        Content="{x:Bind ViewModel.RestoreActionText, Mode=OneWay}"
                        Click="Restore_Click"
                        IsEnabled="{x:Bind ViewModel.CanActOnSelectedRecovery, Mode=OneWay}"
                        HorizontalAlignment="Stretch" />
                    <Button
                        Content="{x:Bind ViewModel.DiscardActionText, Mode=OneWay}"
                        Click="Discard_Click"
                        IsEnabled="{x:Bind ViewModel.CanActOnSelectedRecovery, Mode=OneWay}"
                        HorizontalAlignment="Stretch" />
                    <TextBlock
                        Text="{x:Bind ViewModel.Feedback, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Style="{StaticResource WorkspaceCaptionStyle}"
                        AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Grid>
        </controls:OperationPanel.Body>

        <controls:OperationPanel.Footer>
            <Border Style="{StaticResource OpFooterStyle}">
                <StackPanel Spacing="6">
                    <!-- Hidden Checked Selection Warning Banner -->
                    <Border
                        Visibility="{x:Bind ViewModel.HasHiddenSelectionWarning, Mode=OneWay}"
                        Background="{ThemeResource WorkspaceSubtleBrush}"
                        BorderBrush="{ThemeResource WorkspaceBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="8,4">
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Glyph="&#xE7BA;"
                                FontSize="11.5"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind ViewModel.HiddenSelectionWarningText, Mode=OneWay}"
                                FontSize="11"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Grid ColumnSpacing="5" Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar IsIndeterminate="True" VerticalAlignment="Center" controls:WorkspaceLocalization.Name="正在检查整理计划" />
                        <Button controls:WorkspaceLocalization.Content="取消检查" Command="{x:Bind ViewModel.CancelCommand}" Grid.Column="1" />
                    </Grid>

                    <Grid>
                        <Grid ColumnSpacing="6" Visibility="{x:Bind ViewModel.ShowSettings, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="{x:Bind ViewModel.FooterScope, Mode=OneWay}"
                                VerticalAlignment="Center"
                                Style="{StaticResource OpLabelStyle}"
                                Typography.NumeralAlignment="Tabular"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind ViewModel.ScopeSummary, Mode=OneWay}"
                                AutomationProperties.LiveSetting="Polite" />
                            <Button
                                Content="{x:Bind ViewModel.PrimaryActionText, Mode=OneWay}"
                                Command="{x:Bind ViewModel.RunCommand}"
                                Grid.Column="1"
                                Style="{StaticResource OpActionStyle}" />
                        </Grid>
                        <Grid ColumnSpacing="6" Visibility="{x:Bind ViewModel.ShowProgress, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="{x:Bind ViewModel.FooterScope, Mode=OneWay}"
                                VerticalAlignment="Center"
                                Style="{StaticResource OpLabelStyle}"
                                Typography.NumeralAlignment="Tabular"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind ViewModel.ScopeSummary, Mode=OneWay}"
                                AutomationProperties.LiveSetting="Polite" />
                            <Button
                                Content="{x:Bind ViewModel.CancelActionText, Mode=OneWay}"
                                Command="{x:Bind ViewModel.CancelCommand}"
                                Grid.Column="1"
                                Style="{StaticResource OpActionStyle}" />
                        </Grid>
                        <Grid ColumnSpacing="6" Visibility="{x:Bind ViewModel.ShowResults, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="{x:Bind ViewModel.ResultSummary, Mode=OneWay}"
                                VerticalAlignment="Center"
                                Style="{StaticResource OpLabelStyle}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind ViewModel.ResultSummary, Mode=OneWay}"
                                AutomationProperties.LiveSetting="Polite" />
                            <Button
                                controls:WorkspaceLocalization.Content="继续设置"
                                Command="{x:Bind ViewModel.ContinueEditingCommand}"
                                Grid.Column="1"
                                Style="{StaticResource OpActionStyle}"
                                IsEnabled="{x:Bind ViewModel.CanChangePanel, Mode=OneWay}" />
                        </Grid>
                        <Button
                            controls:WorkspaceLocalization.Content="返回"
                            Command="{x:Bind ViewModel.CloseRecoveryCommand}"
                            Visibility="{x:Bind ViewModel.ShowRecovery, Mode=OneWay}"
                            HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>
        </controls:OperationPanel.Footer>
    </controls:OperationPanel>
</UserControl>
