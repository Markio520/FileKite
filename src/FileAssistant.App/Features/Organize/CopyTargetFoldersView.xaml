<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FileAssistant.App.Features.Organize.CopyTargetFoldersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FileAssistant.App.Controls"
    xmlns:local="using:FileAssistant.App.Features.Organize">
    <UserControl.Resources>
        <Style x:Key="TargetGroupContainerStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Margin="{TemplateBinding Margin}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ChildRowTemplate" x:DataType="local:CopyTargetFolderChild">
            <Grid ColumnSpacing="10" Padding="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Text="{x:Bind DisplayName}"
                    FontSize="12.5"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind SourceDetail}"
                    MaxWidth="180"
                    FontSize="11.5"
                    Foreground="{ThemeResource WorkspaceSecondaryBrush}"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />
                <Border
                    Grid.Column="2"
                    Background="{ThemeResource WorkspaceSubtleBrush}"
                    BorderBrush="{ThemeResource WorkspaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="6,1"
                    VerticalAlignment="Center">
                    <TextBlock
                        Text="{x:Bind StatusBadge}"
                        MaxWidth="210"
                        FontSize="11"
                        Typography.NumeralAlignment="Tabular"
                        Foreground="{ThemeResource WorkspaceSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TargetGroupTemplate" x:DataType="local:CopyTargetFolderGroup">
            <Border
                Background="{ThemeResource WorkspaceCardBrush}"
                BorderBrush="{ThemeResource WorkspaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <Button
                        Tag="{x:Bind}"
                        Click="GroupHeader_Click"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="7"
                        Padding="12,9">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Glyph="{x:Bind ChevronGlyph, Mode=OneWay}"
                                FontSize="10"
                                Foreground="{ThemeResource WorkspaceSecondaryBrush}"
                                Visibility="{x:Bind HasChildren}"
                                VerticalAlignment="Center" />
                            <FontIcon
                                Grid.Column="1"
                                Glyph="&#xE8B7;"
                                FontSize="14"
                                Foreground="{ThemeResource WorkspaceCategoryFolderBrush}"
                                VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                <TextBlock
                                    Text="{x:Bind FolderDisplayPath}"
                                    FontSize="12.5"
                                    FontWeight="SemiBold"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind FolderDisplayPath}" />
                                <TextBlock
                                    Text="{x:Bind SkeletonDetail}"
                                    Visibility="{x:Bind HasSkeletonDetail}"
                                    FontSize="11.5"
                                    Foreground="{ThemeResource WorkspaceSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border
                                Grid.Column="3"
                                Background="{ThemeResource WorkspaceSubtleBrush}"
                                BorderBrush="{ThemeResource WorkspaceBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="8,2"
                                VerticalAlignment="Center">
                                <TextBlock
                                    Text="{x:Bind BadgeText}"
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    Typography.NumeralAlignment="Tabular"
                                    Foreground="{ThemeResource WorkspaceTextBrush}" />
                            </Border>
                        </Grid>
                    </Button>

                    <Border
                        Visibility="{x:Bind ShowChildren, Mode=OneWay}"
                        BorderBrush="{ThemeResource WorkspaceBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Background="{ThemeResource WorkspaceSurfaceBrush}"
                        CornerRadius="0,0,7,7"
                        Padding="34,6,14,8">
                        <ItemsControl
                            ItemsSource="{x:Bind Children}"
                            ItemTemplate="{StaticResource ChildRowTemplate}" />
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Padding="12,8,12,8">
        <ListView
            ItemsSource="{x:Bind ViewModel.TargetFolderGroups, Mode=OneWay}"
            ItemTemplate="{StaticResource TargetGroupTemplate}"
            ItemContainerStyle="{StaticResource TargetGroupContainerStyle}"
            Visibility="{x:Bind ViewModel.HasTargetFolderGroups, Mode=OneWay}"
            SelectionMode="None"
            Padding="0,0,0,48"
            controls:WorkspaceLocalization.Name="按目标文件夹归档预览" />

        <ContentControl
            Style="{StaticResource WorkspaceCenteredStateStyle}"
            Visibility="{x:Bind ViewModel.ShowEmptyTargetFoldersNotice, Mode=OneWay}">
            <Border
                MaxWidth="420"
                Padding="24,20"
                CornerRadius="10"
                Background="{ThemeResource WorkspaceCardBrush}"
                BorderBrush="{ThemeResource WorkspaceBorderBrush}"
                BorderThickness="1">
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <FontIcon
                        Glyph="&#xE8B7;"
                        FontSize="22"
                        Foreground="{ThemeResource WorkspaceCategoryFolderBrush}"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        Text="{x:Bind ViewModel.EmptyTargetFoldersMessage, Mode=OneWay}"
                        FontSize="12.5"
                        TextWrapping="Wrap"
                        TextAlignment="Center"
                        Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                </StackPanel>
            </Border>
        </ContentControl>
    </Grid>
</UserControl>
