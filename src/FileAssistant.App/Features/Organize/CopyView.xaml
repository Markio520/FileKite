<UserControl
    x:Class="FileAssistant.App.Features.Organize.CopyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FileAssistant.App.Controls"
    xmlns:input="using:FileAssistant.App.Features.FileInput"
    xmlns:local="using:FileAssistant.App.Features.Organize">
    <input:FileInputView
        x:Name="InputView"
        ViewModel="{x:Bind ViewModel.Input}"
        OperationTitle="{x:Bind ViewModel.PanelTitle, Mode=OneWay}"
        InputEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
        ShowCustomBody="{x:Bind ViewModel.ShowTargetFoldersStage, Mode=OneWay}"
        SearchRequested="Input_SearchRequested"
        FilesForCopyRequested="Input_FilesForCopyRequested"
        FilesForConversionRequested="Input_FilesForConversionRequested"
        FilesForNamingRequested="Input_FilesForNamingRequested">
        <input:FileInputView.PathBarActions>
            <Border
                Background="{ThemeResource WorkspaceSubtleBrush}"
                BorderBrush="{ThemeResource WorkspaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="2">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <ToggleButton
                        controls:WorkspaceLocalization.Content="文件列表"
                        controls:WorkspaceLocalization.Tip="逐项核对原文件与相对目标路径"
                        IsChecked="{x:Bind ViewModel.ShowFileListView, Mode=OneWay}"
                        Click="ShowFileList_Click"
                        Style="{StaticResource WorkspaceNavigationButtonStyle}"
                        MinHeight="24"
                        Padding="9,3"
                        FontSize="11.5" />
                    <ToggleButton
                        controls:WorkspaceLocalization.Content="按目标文件夹看"
                        controls:WorkspaceLocalization.Tip="按即将写入的目标文件夹分组预览"
                        IsChecked="{x:Bind ViewModel.ShowTargetFoldersView, Mode=OneWay}"
                        Click="ShowTargetFolders_Click"
                        Style="{StaticResource WorkspaceNavigationButtonStyle}"
                        MinHeight="24"
                        Padding="9,3"
                        FontSize="11.5" />
                </StackPanel>
            </Border>
        </input:FileInputView.PathBarActions>
        <input:FileInputView.CustomBodyContent>
            <local:CopyTargetFoldersView ViewModel="{x:Bind ViewModel}" />
        </input:FileInputView.CustomBodyContent>
        <input:FileInputView.OperationContent>
            <local:CopyOptionsView
                x:Name="OptionsPanel"
                FilesForNamingRequested="Input_FilesForNamingRequested"
                FilesForConversionRequested="Input_FilesForConversionRequested" />
        </input:FileInputView.OperationContent>
    </input:FileInputView>
</UserControl>
