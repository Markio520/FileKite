<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FileAssistant.App.Features.SpaceAnalysis.SpaceAnalysisView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FileAssistant.App.Features.SpaceAnalysis"
    xmlns:controls="using:FileAssistant.App.Controls"
    xmlns:preview="using:FileAssistant.App.Features.Preview">
    <UserControl.Resources>
        <DataTemplate x:Key="SpaceReviewItemTemplate" x:DataType="local:SpaceReviewRow">
            <StackPanel Spacing="3" Padding="0,5">
                <TextBlock Text="{x:Bind Path}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{x:Bind Kind}" Style="{StaticResource WorkspaceCaptionStyle}" />
                    <TextBlock Text="{x:Bind Size}" Typography.NumeralAlignment="Tabular" Style="{StaticResource WorkspaceCaptionStyle}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        <Style x:Key="SpaceHeaderStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,4" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource WorkspaceSecondaryBrush}" />
        </Style>
        <Style x:Key="SpaceDataRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource WorkspaceListItemStyle}">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Margin" Value="4,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="{ThemeResource WorkspaceTextBrush}" />
        </Style>
        <Style x:Key="SpaceTypeButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="0" /><Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" Background="Transparent" />
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource WorkspacePageLayoutStyle}" Background="Transparent">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <Grid x:Name="TaskToolbar" Style="{StaticResource WorkspaceTaskToolbarStyle}" Background="Transparent" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="164" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <controls:SelectionDropDown x:Name="DriveMenu" Style="{StaticResource WorkspaceToolbarSelectorStyle}" SelectionCommitted="Drive_SelectionCommitted" AutomationProperties.Name="选择要分析的磁盘" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
            <TextBox x:Name="ScopeBox" Style="{StaticResource WorkspaceToolbarFieldStyle}" Grid.Column="1" PlaceholderText="输入磁盘或文件夹路径（如 C:\ 或 D:\项目）" KeyDown="Scope_KeyDown" TextChanged="Scope_TextChanged" AutomationProperties.Name="扫描路径" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
            <Button x:Name="BrowseButton" Style="{StaticResource WorkspaceToolbarButtonStyle}" Grid.Column="2" Content="选择文件夹" Click="Browse_Click" VerticalAlignment="Center" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="ScanButton" Content="开始扫描" Click="Scan_Click" Style="{StaticResource WorkspaceToolbarAccentStyle}" />
                <Button x:Name="EndAnalysisButton" Style="{StaticResource WorkspaceToolbarButtonStyle}" Content="结束分析" Visibility="Collapsed" Click="EndAnalysis_Click" />
                <Button x:Name="CancelButton" Style="{StaticResource WorkspaceToolbarButtonStyle}" Content="取消扫描" Click="Cancel_Click" Visibility="Collapsed" />
            </StackPanel>
            <ProgressBar x:Name="ScanIndicator" Grid.ColumnSpan="4" IsIndeterminate="True" Visibility="Collapsed" AutomationProperties.Name="操作进度" Height="2" VerticalAlignment="Bottom" Margin="-16,0,-16,-8" IsHitTestVisible="False" />
        </Grid>

        <controls:ResizablePane x:Name="DetailsPane" Grid.Row="1" DefaultPaneWidth="284" WidthPreferenceKey="SpaceAnalysis.Details" MinimumContentWidth="586">
            <controls:ResizablePane.MainContent>
                <Grid x:Name="MainArea" SizeChanged="MainArea_SizeChanged">
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="FolderColumn" Width="189" /><ColumnDefinition x:Name="FolderGapColumn" Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border x:Name="FoldersPane" Grid.ColumnSpan="2" Margin="0,0,5,0" Style="{StaticResource WorkspaceSurfaceStyle}" Background="{ThemeResource WorkspacePaneBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="0" CornerRadius="0,0,0,11">
                        <Grid RowSpacing="0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Border x:Name="FolderHeader" Style="{StaticResource WorkspacePaneHeaderStyle}">
                                <Grid>
                                    <TextBlock Text="目录占用" Style="{StaticResource WorkspacePaneTitleStyle}" />
                                    <Button HorizontalAlignment="Right" Style="{StaticResource WorkspaceIconButtonStyle}" Click="ToggleFolders_Click" AutomationProperties.Name="收起目录树" ToolTipService.ToolTip="收起目录树" Content="" ContentTemplate="{StaticResource WorkspaceLeftPaneIconTemplate}" />
                                </Grid>
                            </Border>
                            <TreeView x:Name="Folders" Grid.Row="1" Margin="8,4,8,6" SelectionMode="Single" CanDragItems="False" CanReorderItems="False" ItemContainerStyle="{StaticResource WorkspaceFolderTreeItemStyle}" SelectionChanged="Folders_SelectionChanged" Expanding="Folders_Expanding" ItemInvoked="Folders_ItemInvoked" ContextRequested="Folders_ContextRequested" AutomationProperties.Name="按占用排序的目录树">
                                <TreeView.ItemTemplate>
                                    <DataTemplate x:DataType="TreeViewNode">
                                        <Grid RowSpacing="3" Padding="0,4" AutomationProperties.Name="{x:Bind ((local:SpaceFolderRow)Content).AutomationLabel}" ToolTipService.ToolTip="{x:Bind ((local:SpaceFolderRow)Content).AutomationLabel}">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <Grid ColumnSpacing="5">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <FontIcon Style="{StaticResource WorkspaceFolderIconStyle}" Foreground="{ThemeResource WorkspaceCategoryFolderBrush}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind ((local:SpaceFolderRow)Content).Name}" Style="{StaticResource WorkspaceFolderNameStyle}" Foreground="{ThemeResource WorkspaceTextBrush}" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind ((local:SpaceFolderRow)Content).Size}" Typography.NumeralAlignment="Tabular" Style="{StaticResource WorkspaceFolderMetadataStyle}" />
                                            </Grid>
                                            <Grid Grid.Row="1" Height="2" Margin="18,1,2,0" Visibility="{x:Bind ((local:SpaceFolderRow)Content).ShowUsageBar}" IsHitTestVisible="False">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{x:Bind ((local:SpaceFolderRow)Content).FillStar}" />
                                                    <ColumnDefinition Width="{x:Bind ((local:SpaceFolderRow)Content).RestStar}" />
                                                </Grid.ColumnDefinitions>
                                                <Border CornerRadius="1" Background="{ThemeResource WorkspaceCategoryFolderBrush}" Opacity="0.46" />
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Grid>
                    </Border>
                    <Border x:Name="FoldersCollapsed" Style="{StaticResource WorkspaceSurfaceStyle}" Background="{ThemeResource WorkspacePaneBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="0" CornerRadius="0,0,0,11" Padding="4,6" Visibility="Collapsed">
                        <Button Style="{StaticResource WorkspaceIconButtonStyle}" VerticalAlignment="Top" HorizontalAlignment="Center" Click="ToggleFolders_Click" AutomationProperties.Name="展开目录树" ToolTipService.ToolTip="展开目录树" Content="" ContentTemplate="{StaticResource WorkspaceLeftPaneIconTemplate}" />
                    </Border>
                    <controls:ResizeHandle x:Name="FolderResize" Grid.Column="1" Canvas.ZIndex="20" ResizeRequested="Folders_Resize" ResetRequested="Folders_ResetRequested" AutomationProperties.Name="调整目录树宽度" />

                    <Border x:Name="CenterSurface" Grid.Column="1" Grid.ColumnSpan="2" Margin="5,0,0,0" Style="{StaticResource WorkspaceSurfaceStyle}" Background="Transparent" Padding="0">
                        <Grid x:Name="Center" RowSpacing="0" SizeChanged="Center_SizeChanged">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition x:Name="MapRow" Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid x:Name="PathHeader" ColumnSpacing="4" Style="{StaticResource WorkspacePathBarStyle}" SizeChanged="PathHeader_SizeChanged">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Button x:Name="ParentButton" Click="Parent_Click" Style="{StaticResource WorkspaceIconButtonStyle}" VerticalAlignment="Center" AutomationProperties.Name="返回上级目录" ToolTipService.ToolTip="返回上级目录"><FontIcon Style="{StaticResource WorkspaceParentFolderIconStyle}" /></Button>
                                <BreadcrumbBar x:Name="Crumbs" Grid.Column="1" ItemClicked="Crumbs_ItemClicked" VerticalAlignment="Center" AutomationProperties.Name="当前目录路径">
                                    <BreadcrumbBar.ItemTemplate>
                                        <DataTemplate x:DataType="local:SpaceCrumb">
                                            <controls:BreadcrumbLabel>
                                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" MaxWidth="220" ToolTipService.ToolTip="{x:Bind Name}" />
                                            </controls:BreadcrumbLabel>
                                        </DataTemplate>
                                    </BreadcrumbBar.ItemTemplate>
                                </BreadcrumbBar>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" Margin="12,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="分析视图">
                                    <ToggleButton x:Name="DirectoryTab" Tag="Directory" Content="目录内容" Style="{StaticResource WorkspaceToolbarModeStyle}" Click="Tab_Click" />
                                    <ToggleButton x:Name="LargeTab" Tag="LargeFiles" Content="大文件" Style="{StaticResource WorkspaceToolbarModeStyle}" Click="Tab_Click" />
                                    <ToggleButton x:Name="TypeTab" Tag="Types" Content="文件类型" Style="{StaticResource WorkspaceToolbarModeStyle}" Click="Tab_Click" />
                                </StackPanel>
                            </Grid>

                            <!-- Segmented Storage Distribution Card + Large-File Filter Strip (shown during or after scan) -->
                            <Border x:Name="SummaryBanner" Grid.Row="1" Visibility="Collapsed" Padding="14,8" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="0,0,0,1" Background="{ThemeResource WorkspaceCardBrush}">
                                <StackPanel Spacing="7">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel x:Name="ScanSummary" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock x:Name="ScopeSummary" Text="选择要分析的磁盘或文件夹。" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
                                            <TextBlock x:Name="VolumeSummary" Style="{StaticResource WorkspaceCaptionStyle}" Typography.NumeralAlignment="Tabular" TextWrapping="Wrap" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <StackPanel x:Name="Filters" Orientation="Horizontal" Spacing="6" Visibility="Collapsed" VerticalAlignment="Center">
                                                <controls:SelectionDropDown x:Name="KindMenu" SelectionCommitted="Kind_SelectionCommitted" AutomationProperties.Name="筛选文件类型" />
                                                <Button x:Name="FilterButton" Content="占用与日期" AutomationProperties.Name="按占用和修改日期筛选">
                                                    <Button.Flyout>
                                                        <Flyout x:Name="FilterFlyout" Placement="BottomEdgeAlignedLeft" Opening="Filter_Opening">
                                                            <StackPanel Width="292" Spacing="9">
                                                                <TextBlock x:Name="FilterSizeHeading" Text="占用空间（MiB）" Style="{StaticResource WorkspaceSectionStyle}" />
                                                                <Grid ColumnSpacing="8">
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                                    <TextBox x:Name="MinimumSize" PlaceholderText="最小值" AutomationProperties.Name="最小占用（MiB）" InputScope="Number" />
                                                                    <TextBox x:Name="MaximumSize" Grid.Column="1" PlaceholderText="最大值" AutomationProperties.Name="最大占用（MiB）" InputScope="Number" />
                                                                </Grid>
                                                                <CalendarDatePicker x:Name="ModifiedFrom" Header="修改日期从" PlaceholderText="不限" HorizontalAlignment="Stretch" />
                                                                <CalendarDatePicker x:Name="ModifiedThrough" Header="修改日期到" PlaceholderText="不限" HorizontalAlignment="Stretch" />
                                                                <TextBlock x:Name="FilterError" TextWrapping="Wrap" Style="{StaticResource WorkspaceCaptionStyle}" />
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <Button Content="应用筛选" Click="ApplyFilter_Click" Style="{StaticResource AccentButtonStyle}" />
                                                                    <Button Content="清除筛选" Click="ClearFilter_Click" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </StackPanel>
                                            <Button x:Name="IssuesButton" Content="扫描详情" Click="Issues_Click" VerticalAlignment="Center" Visibility="Collapsed" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid x:Name="StorageBarHost" Visibility="Collapsed" Height="18">
                                        <Grid x:Name="SegmentedStorageBar" ColumnSpacing="1.5" />
                                    </Grid>
                                    <ScrollViewer x:Name="SegmentLegendViewport" Visibility="Collapsed" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="SegmentLegend" Orientation="Horizontal" Spacing="12" />
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                            <Border x:Name="ListHeader" Grid.Row="2" Background="{ThemeResource WorkspaceSubtleBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="0,0,0,1" Padding="18,5">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2.2*" /><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions>
                                    <Button x:Name="NameHeader" Content="名称" Tag="Name" Click="Sort_Click" Style="{StaticResource WorkspaceColumnHeaderButtonStyle}" />
                                    <Button x:Name="SpaceHeader" Grid.Column="1" Content="占用空间 / 占比" Tag="Allocated" Click="Sort_Click" Style="{StaticResource WorkspaceColumnHeaderButtonStyle}" />
                                    <Button x:Name="SizeHeader" Grid.Column="2" Content="逻辑大小" Tag="Logical" Click="Sort_Click" Style="{StaticResource WorkspaceColumnHeaderButtonStyle}" />
                                    <Button x:Name="DateHeader" Grid.Column="3" Content="修改日期" Tag="Modified" Click="Sort_Click" Style="{StaticResource WorkspaceColumnHeaderButtonStyle}" />
                                </Grid>
                            </Border>

                            <Grid Grid.Row="3">
                                <ListView x:Name="Rows" SelectionMode="Extended" SelectionChanged="Rows_SelectionChanged" ItemContainerStyle="{StaticResource SpaceDataRowStyle}" ContextRequested="Rows_ContextRequested" DoubleTapped="Rows_DoubleTapped" KeyDown="Rows_KeyDown" AutomationProperties.Name="空间分析文件列表" ScrollViewer.HorizontalScrollMode="Disabled">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:SpaceRow">
                                            <Grid ColumnSpacing="8" Padding="10,6" AutomationProperties.Name="{x:Bind AutomationLabel}">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="2.2*" /><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions>
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Border Width="26" Height="26" CornerRadius="6" Background="{ThemeResource WorkspaceSubtleBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="13" Foreground="{x:Bind IconTone, Converter={StaticResource CategoryBrush}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" FontSize="13" ToolTipService.ToolTip="{x:Bind Path}" />
                                                        <TextBlock Text="{x:Bind RowCaption}" Visibility="{x:Bind HasCaption}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center" Padding="0,0,8,0">
                                                    <TextBlock Text="{x:Bind PrimarySize}" Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis" FontSize="12" FontWeight="SemiBold" />
                                                    <Border Height="2.5" CornerRadius="1.25" Background="{ThemeResource WorkspaceSubtleBrush}" Visibility="{x:Bind ShowShareBar}" IsHitTestVisible="False">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="{x:Bind ShareFillStar}" />
                                                                <ColumnDefinition Width="{x:Bind ShareRestStar}" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border CornerRadius="1.25" Background="{x:Bind IconTone, Converter={StaticResource CategoryBrush}}" Opacity="0.68" />
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{x:Bind SecondarySize}" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                                                <TextBlock Grid.Column="3" Text="{x:Bind Date}" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <ListView x:Name="Types" Visibility="Collapsed" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Types_ItemClick" ItemContainerStyle="{StaticResource SpaceDataRowStyle}" AutomationProperties.Name="文件类型占用统计">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:SpaceTypeRow">
                                            <Grid ColumnSpacing="10" Padding="10,7">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <Border Width="11" Height="11" CornerRadius="3" Background="{x:Bind Color}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="SemiBold" />
                                                    <TextBlock Text="{x:Bind Count}" Typography.NumeralAlignment="Tabular" Style="{StaticResource WorkspaceCaptionStyle}" />
                                                </StackPanel>
                                                <ProgressBar Grid.Column="2" Value="{x:Bind Percent}" Maximum="100" Height="6" CornerRadius="3" Foreground="{x:Bind Color}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="3" Spacing="2">
                                                    <TextBlock Text="{x:Bind Size}" Typography.NumeralAlignment="Tabular" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                    <TextBlock Text="{x:Bind Unknown}" Style="{StaticResource WorkspaceCaptionStyle}" HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <ContentControl x:Name="Empty" Style="{StaticResource WorkspaceCenteredStateStyle}">
                                    <Border MaxWidth="440" Padding="32,28" CornerRadius="12" Background="{ThemeResource WorkspaceCardBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1">
                                        <StackPanel HorizontalAlignment="Center" Spacing="12">
                                            <Grid Width="88" Height="58" HorizontalAlignment="Center" Margin="0,0,0,2">
                                                <Border Width="38" Height="46" CornerRadius="7" Background="{ThemeResource WorkspaceSubtleBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                    <Border.RenderTransform>
                                                        <TransformGroup>
                                                            <RotateTransform Angle="-10" />
                                                            <TranslateTransform X="-13" Y="3" />
                                                        </TransformGroup>
                                                    </Border.RenderTransform>
                                                </Border>
                                                <Border Width="38" Height="46" CornerRadius="7" Background="{ThemeResource WorkspaceSubtleBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                    <Border.RenderTransform>
                                                        <TransformGroup>
                                                            <RotateTransform Angle="10" />
                                                            <TranslateTransform X="13" Y="3" />
                                                        </TransformGroup>
                                                    </Border.RenderTransform>
                                                </Border>
                                                <Border Width="44" Height="52" CornerRadius="8" Background="{ThemeResource WorkspaceSurfaceBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE9D9;" FontSize="19" Foreground="{ThemeResource WorkspaceAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                            <TextBlock x:Name="EmptyTitle" Text="开始空间分析" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" />
                                            <TextBlock x:Name="EmptyBody" Text="选择磁盘或文件夹后开始扫描，查看彩色容量分布条、目录占用排行、大文件与空间矩形图。" FontSize="12.5" Foreground="{ThemeResource WorkspaceSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="340" />
                                            <StackPanel x:Name="EmptyActions" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,4,0,0">
                                                <Button Content="选择文件夹" Style="{StaticResource WorkspaceToolbarButtonStyle}" Click="Browse_Click" />
                                                <Button x:Name="EmptyScanButton" Content="开始扫描" Style="{StaticResource WorkspaceToolbarAccentStyle}" Click="Scan_Click" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </ContentControl>
                            </Grid>

                            <controls:ResizeHandle x:Name="MapResize" Grid.Row="4" Height="10" Visibility="Collapsed" ResizeDirection="Vertical" ResizeRequested="Map_Resize" AutomationProperties.Name="调整空间矩形图高度" />

                            <Border x:Name="PageFooter" Grid.Row="5" Background="{ThemeResource WorkspaceSubtleBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="0,1,0,0" Padding="16,7">
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ResultsSummary" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis" Style="{StaticResource WorkspaceCaptionStyle}" />
                                    <StackPanel x:Name="PageButtons" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <Button x:Name="PrevPage" Style="{StaticResource WorkspaceIconButtonStyle}" Width="26" Height="26" Click="PrevPage_Click" AutomationProperties.Name="上一页" ToolTipService.ToolTip="上一页"><FontIcon Glyph="&#xE76B;" FontSize="11" /></Button>
                                        <TextBlock x:Name="PageNumber" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" Style="{StaticResource WorkspaceCaptionStyle}" />
                                        <Button x:Name="NextPage" Style="{StaticResource WorkspaceIconButtonStyle}" Width="26" Height="26" Click="NextPage_Click" AutomationProperties.Name="下一页" ToolTipService.ToolTip="下一页"><FontIcon Glyph="&#xE76C;" FontSize="11" /></Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid x:Name="MapRegion" Grid.Row="6" Visibility="Collapsed" Margin="14,0,14,8">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid x:Name="MapHeader" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Button x:Name="MapToggle" Click="MapToggle_Click" Style="{StaticResource SpaceHeaderStyle}" Content="收起空间矩形图" />
                                    <TextBlock x:Name="MapSummary" Grid.Column="1" Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis" Margin="8,0,4,0" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource WorkspaceCaptionStyle}" />
                                </Grid>
                                <local:SpaceTreemapView x:Name="Treemap" Grid.Row="1" TileInvoked="Treemap_TileInvoked" FolderInvoked="Treemap_FolderInvoked" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </controls:ResizablePane.MainContent>

            <controls:ResizablePane.PaneContent>
                <Border Style="{StaticResource WorkspaceSurfaceStyle}" Background="{ThemeResource WorkspacePaneBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="0" CornerRadius="0,0,11,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Border x:Name="InspectorHeader" Style="{StaticResource WorkspacePaneHeaderStyle}">
                            <Grid>
                                <TextBlock Text="选中项" Style="{StaticResource WorkspacePaneTitleStyle}" />
                                <Button HorizontalAlignment="Right" Style="{StaticResource WorkspaceIconButtonStyle}" Click="ToggleDetails_Click" AutomationProperties.Name="收起详情" ToolTipService.ToolTip="收起详情" Content="" ContentTemplate="{StaticResource WorkspaceRightPaneIconTemplate}" />
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto" Padding="14,12">
                            <StackPanel Spacing="10">
                                <Border x:Name="InspectorEmpty" Style="{StaticResource WorkspaceBentoCardStyle}" Padding="16,20">
                                    <TextBlock Text="选中一行或点击空间矩形图色块，可在此查看占用详情与快捷流转动作。" Style="{StaticResource WorkspaceCaptionStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                                </Border>
                                <StackPanel x:Name="InspectorItem" Spacing="10" Visibility="Collapsed">
                                    <preview:FilePreviewView x:Name="FilePreview" PreviewHeight="148" Visibility="Collapsed" />
                                    <TextBlock x:Name="InspectorName" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                    <Border Style="{StaticResource WorkspaceBentoCardStyle}">
                                        <StackPanel Spacing="6">
                                            <TextBlock x:Name="InspectorStats" TextWrapping="Wrap" FontSize="12" Typography.NumeralAlignment="Tabular" />
                                            <TextBlock x:Name="InspectorNote" TextWrapping="Wrap" Style="{StaticResource WorkspaceCaptionStyle}" />
                                            <Button x:Name="VerifyVolume" Content="精确扫描此磁盘" Visibility="Collapsed" HorizontalAlignment="Stretch" Click="VerifyVolume_Click" ToolTipService.ToolTip="通过 Windows 授权读取 NTFS 元数据，核对受保护目录的占用" />
                                            <Border Height="1" Background="{ThemeResource WorkspaceBorderBrush}" />
                                            <TextBlock x:Name="InspectorPath" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="11.5" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Grid ColumnSpacing="6" RowSpacing="6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Button x:Name="OpenItem" Content="打开" HorizontalAlignment="Stretch" FontSize="12" Click="Open_Click" />
                                        <Button Grid.Column="1" Content="定位" HorizontalAlignment="Stretch" FontSize="12" Click="Reveal_Click" />
                                        <Button Grid.Row="1" Content="复制路径" HorizontalAlignment="Stretch" FontSize="12" Click="Copy_Click" />
                                        <Button x:Name="TransferButton" Grid.Row="1" Grid.Column="1" Content="使用到…" HorizontalAlignment="Stretch" FontSize="12" Click="Transfer_Click" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Row="2" Style="{StaticResource WorkspaceOperationFooterStyle}">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="SelectionSummary" Style="{StaticResource WorkspaceScopeStyle}" Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                <Button x:Name="StageButton" HorizontalAlignment="Stretch" Content="加入待处理清单" Click="Stage_Click" Style="{StaticResource WorkspacePrimaryActionStyle}" />
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Button x:Name="ReviewButton" HorizontalAlignment="Stretch" FontSize="12" Content="待处理清单" Click="Review_Click" />
                                    <Button x:Name="RecycleBinButton" Grid.Column="1" HorizontalAlignment="Stretch" FontSize="12" Content="打开回收站" Click="RecycleBin_Click" />
                                </Grid>
                                <Button x:Name="ResultButton" HorizontalAlignment="Stretch" Content="处理结果" Click="Result_Click" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </controls:ResizablePane.PaneContent>
            <controls:ResizablePane.CollapsedPaneContent>
                <Border Style="{StaticResource WorkspaceSurfaceStyle}" Background="{ThemeResource WorkspacePaneBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="0" CornerRadius="0,0,11,0" Padding="5,6">
                    <Button HorizontalAlignment="Center" VerticalAlignment="Top" Style="{StaticResource WorkspaceIconButtonStyle}" Click="ToggleDetails_Click" AutomationProperties.Name="展开详情" ToolTipService.ToolTip="展开详情" Content="" ContentTemplate="{StaticResource WorkspaceRightPaneIconTemplate}" />
                </Border>
            </controls:ResizablePane.CollapsedPaneContent>
        </controls:ResizablePane>

        <Grid x:Name="FeedbackBar" Grid.Row="2" ColumnSpacing="8" Padding="16,8" Visibility="Collapsed" Background="{ThemeResource WorkspaceSubtleBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="Feedback" Style="{StaticResource WorkspaceCaptionStyle}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <Button x:Name="CollapsedResultButton" Grid.Column="1" Content="处理结果" Click="Result_Click" Visibility="Collapsed" />
            <Button x:Name="FooterReview" Grid.Column="2" Content="核对待处理" Click="Review_Click" Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
