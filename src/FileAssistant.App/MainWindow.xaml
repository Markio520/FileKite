<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FileAssistant.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FileAssistant.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FileAssistant.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="纸鸢 · FileKite"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="WindowRoot" Background="{ThemeResource WorkspaceBackgroundBrush}" ActualThemeChanged="WindowRoot_ActualThemeChanged">
        <Frame x:Name="RootFrame" />
    </Grid>
</Window>
