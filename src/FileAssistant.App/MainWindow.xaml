<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FileAssistant.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FileAssistant.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FileAssistant.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="纸鸢 · FileKite"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="WindowRoot" Background="{ThemeResource WorkspaceBackgroundBrush}" ActualThemeChanged="WindowRoot_ActualThemeChanged">
        <Grid x:Name="ThemeRippleBackdrop" Visibility="Collapsed" IsHitTestVisible="False">
            <Image x:Name="ThemeRippleSnapshot" Stretch="Fill" />
        </Grid>
        <Grid x:Name="RippleRevealHost">
            <Frame x:Name="RootFrame" />
        </Grid>
        <Grid x:Name="ThemeRippleRingHost" IsHitTestVisible="False" Canvas.ZIndex="30" />
        <controls:WindowResizeGrip x:Name="MainWindowResizeGrip" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2" Canvas.ZIndex="40" />
    </Grid>
</Window>
