<UserControl
    x:Class="FileAssistant.App.Controls.ResizablePane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FileAssistant.App.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="MainColumn" Width="*" />
            <ColumnDefinition x:Name="HandleColumn" Width="0" />
            <ColumnDefinition x:Name="PaneColumn" Width="284" />
        </Grid.ColumnDefinitions>
        <ContentPresenter x:Name="MainPresenter" Content="{x:Bind MainContent, Mode=OneWay}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        <ContentPresenter x:Name="PanePresenter" Grid.Column="2" Content="{x:Bind PaneContent, Mode=OneWay}"
            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        <ContentPresenter x:Name="CollapsedPresenter" Grid.Column="2" Content="{x:Bind CollapsedPaneContent, Mode=OneWay}"
            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed" />
        <controls:ResizeHandle x:Name="Handle" Grid.Column="1" Canvas.ZIndex="20" ResizeRequested="Pane_ResizeRequested"
            ResetRequested="Pane_ResetRequested" AutomationProperties.Name="调整右侧栏宽度" />
    </Grid>
</UserControl>
